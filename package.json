{
  "name": "just-websites-public",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^20.3.0 || >=22.0.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
