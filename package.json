{
  "name": "just-websites-public",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^20.3.0 || >=22.0.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./scripts/run-standalone.mjs",
    "astro": "astro",
    "test": "node --test --test-concurrency=1 tests/**/*.test.mjs",
    "docker:build": "docker build -t just-public:local .",
    "docker:run": "docker run --rm -e HOST=0.0.0.0 -e PORT=4321 -p 4321:4321 just-public:local",
    "cf:build": "astro build",
    "cf:dev": "astro build && wrangler dev",
    "cf:deploy:dry-run": "astro build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@supabase/supabase-js": "^2.98.0",
    "astro": "^5.17.1"
  },
  "devDependencies": {
    "wrangler": "^4.59.2"
  }
}
