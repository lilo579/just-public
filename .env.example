# just-public environment example — no real secrets.
# Copy to .env for local use. Never bake .env into Docker images.

# --- Host bind (runtime / container) ---
# Adapter (@astrojs/node standalone) reads these directly.
HOST=0.0.0.0
PORT=4321

# --- Server-oriented (SSR fetch to Edge; set at process env) ---
# Used by src/config/publicSite.ts for Authorization / apikey on payload calls.
# This is an anon key (not service_role). Prefer not shipping empty in staging
# when exercising homepage; /health does not require it.
SUPABASE_ANON_KEY=

# Optional overrides (defaults exist in src/config/publicSite.ts)
PUBLIC_SITE_PAYLOAD_URL=
PUBLIC_LEADS_INTAKE_URL=

# Explicit legacy fallback gate for Astro (SSR). Safe to leave unset.
PUBLIC_ALLOW_LEGACY_RENDERER=

# staging | unset | production — when "staging", middleware adds X-Robots-Tag
# Set at container/process runtime (SSR reads process.env). Rebuild not required.
PUBLIC_DEPLOY_ENV=

# --- Client-exposed (names used by catalog / forms; PUBLIC_ prefix) ---
# Debit: homepage payload uses SUPABASE_ANON_KEY (no PUBLIC_), while catalog
# (src/lib/supabase.ts) expects PUBLIC_SUPABASE_URL + PUBLIC_SUPABASE_ANON_KEY.
# Do not rename in this runtime slice — set both to the same anon materials if
# catalog routes are needed.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Never set SUPABASE_SERVICE_ROLE_KEY in this app.
