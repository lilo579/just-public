---
const {
  siteTitle = "Marcelo Borer",
  logoUrl = "",
  logoAlt = siteTitle,
} = Astro.props as {
  siteTitle?: string;
  logoUrl?: string;
  logoAlt?: string;
};
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label={siteTitle}>
      {logoUrl ? (
        <img src={logoUrl} alt={logoAlt} class="site-header__logo" />
      ) : (
        <span>{siteTitle}</span>
      )}
    </a>

    <a href="#cta-final" class="site-header__cta">
      <span class="site-header__cta-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path
            d="M20 11.5a8 8 0 0 1-8 8 8.7 8.7 0 0 1-3.2-.6L4 20l1.1-4.1A8 8 0 1 1 20 11.5Z"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
      <span>WhatsApp</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid hsl(30 8% 88%);
  }

  .site-header__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: #111827;
    min-width: 0;
    flex: 0 1 auto;
  }

  .site-header__brand span {
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .site-header__logo {
    display: block;
    height: 3.15rem;
    max-width: 11rem;
    width: auto;
    object-fit: contain;
  }

  .site-header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 2.2rem;
    padding: 0.48rem 1.2rem;
    border-radius: 999px;
    border: 1.5px solid #95a394;
    background: transparent;
    color: #748776;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    line-height: 1;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .site-header__cta-icon {
    width: 1.2rem;
    height: 1.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #748776;
    flex: 0 0 auto;
  }

  .site-header__cta-icon svg {
    width: 1.6rem;
    height: 1.6rem;
    display: block;
  }

  @media (max-width: 720px) {
    .site-header__inner {
      padding: 0.95rem 1rem;
      gap: 0.75rem;
    }

    .site-header__logo {
      height: 3rem;
      max-width: 8.8rem;
    }

    .site-header__cta {
      min-height: 2.5rem;
      padding: 0.01rem 1.15rem;
      gap: 0.5rem;
      font-size: 0.9rem;
    }

    .site-header__cta-icon,
    .site-header__cta-icon svg {
      width: 1.05rem;
      height: 1.05rem;
    }
  }
</style>