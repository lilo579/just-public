---
import TrackedCTA from "./TrackedCTA.astro"
import WhatsAppIcon from "./icons/WhatsAppIcon.astro"

const {
  siteTitle = "Site",
  logoUrl = "",
  logoAlt = siteTitle,
  whatsappHref = "",
} = Astro.props as {
  siteTitle?: string
  logoUrl?: string
  logoAlt?: string
  whatsappHref?: string
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label={siteTitle}>
      {logoUrl ? (
        <img src={logoUrl} alt={logoAlt} class="site-header__logo" />
      ) : (
        <span>{siteTitle}</span>
      )}
    </a>

    {whatsappHref ? (
      <TrackedCTA
        href={whatsappHref}
        label="WhatsApp"
        class="site-header__cta"
        ctaId="header-whatsapp-cta"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="site-header__cta-icon" aria-hidden="true">
          <WhatsAppIcon class="site-header__cta-svg" />
        </span>
        <span>WhatsApp</span>
      </TrackedCTA>
    ) : (
      <a href="#cta-final" class="site-header__cta">
        <span class="site-header__cta-icon" aria-hidden="true">
          <WhatsAppIcon class="site-header__cta-svg" />
        </span>
        <span>WhatsApp</span>
      </a>
    )}
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid hsl(30 8% 88%);
  }

  .site-header__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: #111827;
    min-width: 0;
    flex: 0 1 auto;
  }

  .site-header__brand span {
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .site-header__logo {
    display: block;
    height: 3.15rem;
    max-width: 11rem;
    width: auto;
    object-fit: contain;
  }

  /* TrackedCTA is a child component — styles must be :global */
  .site-header :global(a.site-header__cta) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2rem;
    padding: 0.28rem 0.95rem;
    border-radius: 999px;
    border: 1.5px solid var(--site-color-primary, hsl(145 63% 42%));
    background: transparent;
    color: var(--site-color-primary, hsl(145 63% 42%));
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    line-height: 1;
    white-space: nowrap;
    flex: 0 0 auto;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .site-header :global(a.site-header__cta:hover) {
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 10%, white);
  }

  .site-header :global(a.site-header__cta:active) {
    transform: translateY(1px);
  }

  .site-header :global(a.site-header__cta:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 40%, white);
    outline-offset: 2px;
  }

  .site-header :global(.site-header__cta-icon) {
    width: 1.05rem;
    height: 1.05rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    flex: 0 0 auto;
  }

  .site-header :global(.site-header__cta-svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  @media (max-width: 720px) {
    .site-header__inner {
      padding: 0.95rem 1rem;
      gap: 0.75rem;
    }

    .site-header__logo {
      height: 3rem;
      max-width: 8.8rem;
    }

    .site-header :global(a.site-header__cta) {
      min-height: 1.9rem;
      padding: 0.24rem 0.85rem;
      gap: 0.4rem;
      font-size: 0.85rem;
    }

    .site-header :global(.site-header__cta-svg) {
      width: 1rem;
      height: 1rem;
    }
  }
</style>
