---
import TrackedCTA from "./TrackedCTA.astro"
import WhatsAppIcon from "./icons/WhatsAppIcon.astro"

const {
  siteTitle = "Site",
  logoUrl = "",
  logoOverHeroUrl = "",
  logoAlt = siteTitle,
  whatsappHref = "",
  pillChrome = true,
  overHero = false,
  ctaLabel = "WhatsApp",
  navItems = [],
} = Astro.props as {
  siteTitle?: string
  logoUrl?: string
  /** Light/white logo while transparent over hero. */
  logoOverHeroUrl?: string
  logoAlt?: string
  whatsappHref?: string
  pillChrome?: boolean
  /** Transparent fixed header that collapses into a pill on scroll. */
  overHero?: boolean
  ctaLabel?: string
  navItems?: Array<{ label: string; href: string }>
}

const hasNav = overHero && Array.isArray(navItems) && navItems.length > 0
const resolvedOverHeroLogo = logoOverHeroUrl || logoUrl
---

<header
  class:list={["site-header", overHero && "site-header--over-hero"]}
  data-pill-chrome={pillChrome ? "true" : "false"}
  data-over-hero={overHero ? "true" : "false"}
  id="site-header"
>
  <div class="site-header__shell">
    <nav class="site-header__inner" aria-label="Principal">
      <a href="/" class="site-header__brand" aria-label={siteTitle}>
        {overHero && resolvedOverHeroLogo ? (
          <>
            <img
              src={resolvedOverHeroLogo}
              alt={logoAlt}
              class="site-header__logo site-header__logo--over"
            />
            {logoUrl && (
              <img
                src={logoUrl}
                alt=""
                aria-hidden="true"
                class="site-header__logo site-header__logo--solid"
              />
            )}
          </>
        ) : logoUrl ? (
          <img src={logoUrl} alt={logoAlt} class="site-header__logo" />
        ) : (
          <span>{siteTitle}</span>
        )}
      </a>

      {hasNav && (
        <div class="site-header__nav">
          {navItems.map((item) => (
            <a href={item.href} class="site-header__nav-link">
              {item.label}
            </a>
          ))}
        </div>
      )}

      {whatsappHref ? (
        <TrackedCTA
          href={whatsappHref}
          label={ctaLabel}
          class="site-header__cta"
          ctaId="header-whatsapp-cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="site-header__cta-icon" aria-hidden="true">
            <WhatsAppIcon class="site-header__cta-svg" />
          </span>
          <span>{ctaLabel}</span>
        </TrackedCTA>
      ) : (
        <a href={overHero ? "#contato" : "#cta-final"} class="site-header__cta">
          <span class="site-header__cta-icon" aria-hidden="true">
            <WhatsAppIcon class="site-header__cta-svg" />
          </span>
          <span>{ctaLabel}</span>
        </a>
      )}
    </nav>
  </div>
</header>

{overHero && (
  <script is:inline>
    (function () {
      var header = document.getElementById("site-header");
      if (!header || header.getAttribute("data-over-hero") !== "true") return;
      var threshold = 12;
      function sync() {
        var scrolled = window.scrollY > threshold;
        header.setAttribute("data-scrolled", scrolled ? "true" : "false");
      }
      sync();
      window.addEventListener("scroll", sync, { passive: true });
    })();
  </script>
)}

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid hsl(30 8% 88%);
  }

  .site-header--over-hero {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    z-index: 50;
    background: transparent;
    backdrop-filter: none;
    border-bottom: none;
    padding: 1.25rem 1rem 0;
    transition: padding 300ms ease;
  }

  .site-header--over-hero[data-scrolled="true"] {
    padding: 0.75rem 1rem 0;
  }

  .site-header__shell {
    max-width: 1280px;
    margin: 0 auto;
  }

  .site-header--over-hero .site-header__shell {
    overflow: hidden;
    border: 1px solid transparent;
    background: transparent;
    box-shadow: none;
    transition:
      background-color 300ms ease,
      border-color 300ms ease,
      box-shadow 300ms ease,
      border-radius 300ms ease;
  }

  .site-header--over-hero[data-scrolled="true"] .site-header__shell {
    border-radius: 999px;
    border-color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 16%, transparent);
    background: #fffaf3;
    box-shadow: 0 24px 90px -70px hsl(220 15% 15% / 0.45);
  }

  .site-header__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header--over-hero .site-header__inner {
    height: 4.875rem;
    padding-left: 0;
    padding-right: 0;
    transition:
      height 300ms ease,
      padding 300ms ease;
  }

  .site-header--over-hero[data-scrolled="true"] .site-header__inner {
    height: 4.125rem;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: #111827;
    min-width: 0;
    flex: 0 1 auto;
    position: relative;
  }

  .site-header__brand span {
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .site-header__logo {
    display: block;
    height: 3.15rem;
    max-width: 11rem;
    width: auto;
    object-fit: contain;
  }

  .site-header--over-hero .site-header__logo--over,
  .site-header--over-hero .site-header__logo--solid {
    height: 3rem;
    max-width: 12rem;
    transition:
      opacity 300ms ease,
      height 300ms ease,
      filter 300ms ease;
  }

  .site-header--over-hero .site-header__logo--solid {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0;
  }

  .site-header--over-hero .site-header__logo--over {
    opacity: 1;
    filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.35));
  }

  .site-header--over-hero[data-scrolled="true"] .site-header__logo--over {
    opacity: 0;
  }

  .site-header--over-hero[data-scrolled="true"] .site-header__logo--solid {
    opacity: 1;
    height: 2.5rem;
  }

  .site-header__nav {
    display: none;
    align-items: center;
    gap: 2.5rem;
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  .site-header--over-hero .site-header__nav {
    opacity: 0;
    transform: translateY(4px);
    pointer-events: none;
  }

  .site-header--over-hero[data-scrolled="true"] .site-header__nav {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .site-header__nav-link {
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 82%, transparent);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .site-header__nav-link:hover {
    color: var(--site-color-primary, hsl(145 63% 42%));
  }

  /* TrackedCTA is a child component — styles must be :global */
  .site-header :global(a.site-header__cta) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2rem;
    padding: 0.28rem 0.95rem;
    border-radius: 999px;
    border: 1.5px solid var(--site-color-primary, hsl(145 63% 42%));
    background: transparent;
    color: var(--site-color-primary, hsl(145 63% 42%));
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    line-height: 1;
    white-space: nowrap;
    flex: 0 0 auto;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .site-header[data-pill-chrome="false"] :global(a.site-header__cta) {
    border-radius: var(--site-radius-button, 0.5rem);
    min-height: 2.35rem;
    padding: 0.4rem 1.1rem;
    font-weight: 600;
  }

  .site-header--over-hero :global(a.site-header__cta) {
    display: none;
    border-color: rgba(255, 255, 255, 0.38);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border-radius: 999px;
    backdrop-filter: blur(6px);
    box-shadow: none;
  }

  .site-header--over-hero[data-scrolled="true"] :global(a.site-header__cta) {
    border-color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 18%, transparent);
    background: #fff;
    color: var(--site-color-primary, hsl(145 63% 42%));
    box-shadow: 0 14px 38px -30px hsl(220 15% 15% / 0.36);
  }

  .site-header :global(a.site-header__cta:hover) {
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 10%, white);
  }

  .site-header--over-hero :global(a.site-header__cta:hover) {
    background: #fff;
    color: hsl(220 15% 15%);
  }

  .site-header :global(a.site-header__cta:active) {
    transform: translateY(1px);
  }

  .site-header :global(a.site-header__cta:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 40%, white);
    outline-offset: 2px;
  }

  .site-header :global(.site-header__cta-icon) {
    width: 1.05rem;
    height: 1.05rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    flex: 0 0 auto;
  }

  .site-header :global(.site-header__cta-svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  @media (min-width: 640px) {
    .site-header--over-hero :global(a.site-header__cta) {
      display: inline-flex;
    }
  }

  @media (min-width: 1024px) {
    .site-header--over-hero {
      padding: 1.75rem 2.5rem 0;
    }

    .site-header--over-hero[data-scrolled="true"] {
      padding: 1rem 2rem 0;
    }

    .site-header--over-hero .site-header__inner {
      height: 5.75rem;
    }

    .site-header--over-hero[data-scrolled="true"] .site-header__inner {
      height: 4.75rem;
      padding-left: 2.25rem;
      padding-right: 2.25rem;
    }

    .site-header--over-hero .site-header__logo--over {
      height: 3.7rem;
    }

    .site-header--over-hero[data-scrolled="true"] .site-header__logo--solid {
      height: 3.05rem;
    }

    .site-header--over-hero .site-header__nav {
      display: flex;
    }
  }

  @media (max-width: 720px) {
    .site-header__inner {
      padding: 0.95rem 1rem;
      gap: 0.75rem;
    }

    .site-header__logo {
      height: 3rem;
      max-width: 8.8rem;
    }

    .site-header :global(a.site-header__cta) {
      min-height: 1.9rem;
      padding: 0.24rem 0.85rem;
      gap: 0.4rem;
      font-size: 0.85rem;
    }

    .site-header :global(.site-header__cta-svg) {
      width: 1rem;
      height: 1rem;
    }
  }
</style>
