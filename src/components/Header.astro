---
import TrackedCTA from "./TrackedCTA.astro"
import MessageCircleIcon from "./icons/MessageCircleIcon.astro"
import WhatsAppIcon from "./icons/WhatsAppIcon.astro"

const {
  siteTitle = "Site",
  logoUrl = "",
  logoOverHeroUrl = "",
  logoAlt = siteTitle,
  whatsappHref = "",
  pillChrome = true,
  overHero = false,
  ctaLabel = "WhatsApp",
  navItems = [],
  /** outline-on-dark = Celina editorial; solid = PT dark (Golden Master). */
  ctaVariant = "outline-on-dark",
  /** on-scroll = reveal after scroll; always = visible on hero (PT). */
  navReveal = "on-scroll",
  /**
   * shop = F3 catalog Golden Master chrome (full-width rectangular, no Celina pill).
   * default = shared / F1 behavior.
   */
  chrome = "default",
  /** When false, hide the header WhatsApp CTA (3D Jewish GM has none). */
  showCta = true,
  /** Homepage href for the brand/logo mark. */
  homeHref = "",
} = Astro.props as {
  siteTitle?: string
  logoUrl?: string
  logoOverHeroUrl?: string
  logoAlt?: string
  whatsappHref?: string
  pillChrome?: boolean
  overHero?: boolean
  ctaLabel?: string
  navItems?: Array<{ label: string; href: string; separatorBefore?: boolean }>
  ctaVariant?: "outline-on-dark" | "solid"
  navReveal?: "on-scroll" | "always"
  chrome?: "default" | "shop"
  showCta?: boolean
  homeHref?: string
}

const isShopChrome = chrome === "shop"
const hasNav = Array.isArray(navItems) && navItems.length > 0
const resolvedOverHeroLogo = logoOverHeroUrl || logoUrl
const overHeroCtaClass =
  ctaVariant === "solid"
    ? "site-header__cta f1-cta f1-cta--solid"
    : "site-header__cta f1-cta f1-cta--outline-on-dark"
const ctaClass = overHero ? overHeroCtaClass : "site-header__cta"
const renderCta = showCta && !isShopChrome && Boolean(whatsappHref || !overHero)

/** Keep Workers preview `?host=` when returning to the homepage. */
const hostParam = (Astro.url.searchParams.get("host") || "").trim()
const resolvedHomeHref =
  (typeof homeHref === "string" && homeHref.trim()) ||
  (hostParam ? `/?host=${encodeURIComponent(hostParam)}` : "/")

/** Active nav matching — Golden Master Header.tsx */
const currentPath = Astro.url.pathname
const currentSearch = Astro.url.searchParams
const currentLine = (currentSearch.get("line") || "").trim()
const currentColecao = (
  currentSearch.get("colecao") ||
  currentSearch.get("collection") ||
  ""
).trim()
const isCatalogPath = currentPath === "/catalogo" || currentPath.startsWith("/catalogo/")

function isNavItemActive(href: string, label: string) {
  let itemPath = href
  let itemSearch = ""
  try {
    const u = new URL(href, "https://example.local")
    itemPath = u.pathname
    itemSearch = u.search
  } catch {
    /* keep raw */
  }
  const params = new URLSearchParams(itemSearch.startsWith("?") ? itemSearch.slice(1) : itemSearch)
  const itemLine = (params.get("line") || "").trim()
  const itemColecao = (params.get("colecao") || params.get("collection") || "").trim()

  if (label === "Catálogo" || (itemPath === "/catalogo" && !itemLine && !itemColecao)) {
    return isCatalogPath && !currentLine && !currentColecao
  }
  if (itemColecao) return isCatalogPath && currentColecao === itemColecao
  if (itemLine) return isCatalogPath && currentLine === itemLine
  return currentPath === itemPath || (itemPath !== "/" && currentPath.startsWith(itemPath))
}

function withHostPath(path: string) {
  if (!hostParam) return path
  const join = path.includes("?") ? "&" : "?"
  return `${path}${join}host=${encodeURIComponent(hostParam)}`
}

const shopExploreItems = isShopChrome
  ? navItems.filter(
      (item) =>
        item.label !== "Catálogo" &&
        item.label !== "Sobre" &&
        item.label !== "Contato",
    )
  : []

const shopInstitutionalItems = isShopChrome
  ? [
      { label: "Catálogo completo", href: withHostPath("/catalogo"), icon: "book" as const },
      { label: "Sobre", href: withHostPath("/sobre"), icon: "sparkles" as const },
      { label: "Contato", href: withHostPath("/contato"), icon: "phone" as const },
    ]
  : []

const shopSheetId = "shop-nav-sheet"
const shopMenuBtnId = "shop-menu-open"
---

<header
  class:list={[
    "site-header",
    overHero && "site-header--over-hero",
    hasNav && !overHero && "site-header--with-nav",
    isShopChrome && "site-header--shop",
  ]}
  data-pill-chrome={isShopChrome ? "false" : pillChrome ? "true" : "false"}
  data-over-hero={overHero ? "true" : "false"}
  data-nav-reveal={overHero ? navReveal : undefined}
  data-cta-variant={overHero ? ctaVariant : undefined}
  data-chrome={isShopChrome ? "shop" : "default"}
  id="site-header"
>
  <div class="site-header__shell">
    {isShopChrome && overHero ? (
      <div class="site-header__wash" aria-hidden="true"></div>
    ) : null}
    <nav class="site-header__inner" aria-label="Principal">
      {isShopChrome ? (
        <button
          type="button"
          class="site-header__menu-btn"
          id={shopMenuBtnId}
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls={shopSheetId}
        >
          <svg class="site-header__menu-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M4 7h16M4 12h16M4 17h16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </svg>
        </button>
      ) : null}

      <a href={resolvedHomeHref} class="site-header__brand" aria-label={siteTitle}>
        {overHero && resolvedOverHeroLogo ? (
          <>
            <img
              src={resolvedOverHeroLogo}
              alt={logoAlt}
              class="site-header__logo site-header__logo--over"
            />
            {logoUrl && (
              <img
                src={logoUrl}
                alt=""
                aria-hidden="true"
                class="site-header__logo site-header__logo--solid"
              />
            )}
          </>
        ) : logoUrl ? (
          <img src={logoUrl} alt={logoAlt} class="site-header__logo" />
        ) : (
          <span>{siteTitle}</span>
        )}
      </a>

      {isShopChrome ? <span class="site-header__menu-spacer" aria-hidden="true"></span> : null}

      {hasNav && (
        <div class="site-header__nav">
          {navItems.map((item) => (
            <>
              {isShopChrome && item.separatorBefore ? (
                <span class="site-header__nav-sep" aria-hidden="true" />
              ) : null}
              <a
                href={item.href}
                class:list={[
                  "site-header__nav-link",
                  isShopChrome && isNavItemActive(item.href, item.label) && "is-active",
                ]}
                aria-current={
                  isShopChrome && isNavItemActive(item.href, item.label) ? "page" : undefined
                }
              >
                {item.label}
                {isShopChrome ? <span class="site-header__nav-underline" aria-hidden="true" /> : null}
              </a>
            </>
          ))}
        </div>
      )}

      {renderCta ? (
        whatsappHref ? (
          <TrackedCTA
            href={whatsappHref}
            label={ctaLabel}
            class={ctaClass}
            ctaId="header-whatsapp-cta"
            target="_blank"
            rel="noopener noreferrer"
          >
            {overHero ? (
              <span class="f1-cta__icon site-header__cta-icon" aria-hidden="true">
                <MessageCircleIcon />
              </span>
            ) : (
              <span class="site-header__cta-icon" aria-hidden="true">
                <WhatsAppIcon class="site-header__cta-svg" />
              </span>
            )}
            <span>{ctaLabel}</span>
          </TrackedCTA>
        ) : (
          <a href={overHero ? "#contato" : "#cta-final"} class={ctaClass}>
            {overHero ? (
              <span class="f1-cta__icon site-header__cta-icon" aria-hidden="true">
                <MessageCircleIcon />
              </span>
            ) : (
              <span class="site-header__cta-icon" aria-hidden="true">
                <WhatsAppIcon class="site-header__cta-svg" />
              </span>
            )}
            <span>{ctaLabel}</span>
          </a>
        )
      ) : null}
    </nav>
  </div>
</header>

{isShopChrome && (
  <div class="shop-sheet" id={shopSheetId} hidden data-shop-sheet>
    <button
      type="button"
      class="shop-sheet__backdrop"
      tabindex="-1"
      aria-label="Fechar menu"
      data-shop-sheet-close
    ></button>
    <div
      class="shop-sheet__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="shop-sheet-title"
      id="shop-nav-panel"
    >
      <div class="shop-sheet__top">
        <h2 class="shop-sheet__title" id="shop-sheet-title">Menu</h2>
        <button
          type="button"
          class="shop-sheet__close"
          aria-label="Fechar menu"
          data-shop-sheet-close
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M6 6l12 12M18 6 6 18"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
            />
          </svg>
        </button>
      </div>

      <nav class="shop-sheet__body" aria-label="Menu mobile">
        {shopExploreItems.length > 0 && (
          <div class="shop-sheet__block">
            <p class="shop-sheet__label">Explorar</p>
            <ul class="shop-sheet__list">
              {shopExploreItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      "shop-sheet__link",
                      isNavItemActive(item.href, item.label) && "is-active",
                    ]}
                    data-shop-sheet-link
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {shopExploreItems.length > 0 ? <div class="shop-sheet__rule" aria-hidden="true"></div> : null}

        <div class="shop-sheet__block">
          <p class="shop-sheet__label">Institucional</p>
          <ul class="shop-sheet__list">
            {shopInstitutionalItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "shop-sheet__link",
                    "shop-sheet__link--icon",
                    isNavItemActive(item.href, item.label === "Catálogo completo" ? "Catálogo" : item.label) &&
                      "is-active",
                  ]}
                  data-shop-sheet-link
                >
                  {item.icon === "book" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M5 4.5h11.5A2.5 2.5 0 0 1 19 7v12.5H7.5A2.5 2.5 0 0 0 5 22"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linejoin="round"
                      />
                      <path d="M5 4.5V22" fill="none" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                  )}
                  {item.icon === "sparkles" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="m12 3 1.6 4.8L18.5 9.5 13.6 11.5 12 16.4 10.4 11.5 5.5 9.5l4.9-1.7L12 3Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                  {item.icon === "phone" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M7.5 4.5h3l1.2 3-1.8 1.2a11 11 0 0 0 5.4 5.4l1.2-1.8 3 1.2v3A2 2 0 0 1 17.5 18 13.5 13.5 0 0 1 4 4.5a2 2 0 0 1 2-2Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        {whatsappHref ? (
          <>
            <div class="shop-sheet__rule" aria-hidden="true"></div>
            <div class="shop-sheet__cta">
              <a
                href={whatsappHref}
                class="shop-sheet__wa"
                target="_blank"
                rel="noopener noreferrer"
                data-shop-sheet-link
              >
                Conversar no WhatsApp
              </a>
            </div>
          </>
        ) : null}
      </nav>
    </div>
  </div>
)}

{overHero && (
  <script is:inline>
    (function () {
      var header = document.getElementById("site-header");
      if (!header || header.getAttribute("data-over-hero") !== "true") return;
      var threshold = 12;
      function sync() {
        var scrolled = window.scrollY > threshold;
        header.setAttribute("data-scrolled", scrolled ? "true" : "false");
      }
      sync();
      window.addEventListener("scroll", sync, { passive: true });
    })();
  </script>
)}

{isShopChrome && (
  <script is:inline>
    (function () {
      var header = document.getElementById("site-header");
      if (!header || header.getAttribute("data-chrome") !== "shop") return;
      var sheet = document.getElementById("shop-nav-sheet");
      var openBtn = document.getElementById("shop-menu-open");
      var panel = document.getElementById("shop-nav-panel");
      if (!sheet || !openBtn || !panel) return;

      var lastFocus = null;
      var reduceMotion =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function focusable() {
        return Array.prototype.slice.call(
          panel.querySelectorAll(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
          ),
        );
      }

      function setOpen(next) {
        var open = !!next;
        if (open) {
          lastFocus = document.activeElement;
          sheet.hidden = false;
          openBtn.setAttribute("aria-expanded", "true");
          document.documentElement.setAttribute("data-shop-sheet-open", "true");
          document.body.style.overflow = "hidden";
          window.requestAnimationFrame(function () {
            sheet.setAttribute("data-open", "true");
            var nodes = focusable();
            var target = nodes[0] || panel;
            try {
              target.focus();
            } catch (e) {}
          });
        } else {
          sheet.removeAttribute("data-open");
          openBtn.setAttribute("aria-expanded", "false");
          document.documentElement.removeAttribute("data-shop-sheet-open");
          document.body.style.overflow = "";
          var closeDelay = reduceMotion ? 0 : 200;
          window.setTimeout(function () {
            if (sheet.getAttribute("data-open") === "true") return;
            sheet.hidden = true;
          }, closeDelay);
          if (lastFocus && typeof lastFocus.focus === "function") {
            try {
              lastFocus.focus();
            } catch (e) {}
          } else {
            openBtn.focus();
          }
        }
      }

      openBtn.addEventListener("click", function () {
        setOpen(true);
      });

      sheet.querySelectorAll("[data-shop-sheet-close]").forEach(function (el) {
        el.addEventListener("click", function () {
          setOpen(false);
        });
      });

      sheet.querySelectorAll("[data-shop-sheet-link]").forEach(function (el) {
        el.addEventListener("click", function () {
          setOpen(false);
        });
      });

      document.addEventListener("keydown", function (event) {
        if (sheet.getAttribute("data-open") !== "true") return;
        if (event.key === "Escape") {
          event.preventDefault();
          setOpen(false);
          return;
        }
        if (event.key !== "Tab") return;
        var nodes = focusable();
        if (!nodes.length) return;
        var first = nodes[0];
        var last = nodes[nodes.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
    })();
  </script>
)}

<style>
  .site-header--with-nav .site-header__nav {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-header--with-nav .site-header__nav-link {
    color: #222;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .site-header--with-nav .site-header__nav-link:hover {
    opacity: 0.7;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid hsl(30 8% 88%);
  }

  .site-header--over-hero {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    z-index: 50;
    background: transparent;
    backdrop-filter: none;
    border-bottom: none;
    /* SPA: pt-5 / lg:pt-7 — keep chrome thin so header dissolves into hero */
    padding: 1.25rem 1rem 0;
    transition: padding 300ms ease;
  }

  .site-header--over-hero[data-scrolled="true"] {
    padding: 0.65rem 1rem 0;
  }

  .site-header__shell {
    max-width: 1280px;
    margin: 0 auto;
  }

  .site-header--over-hero .site-header__shell {
    overflow: hidden;
    border: 1px solid transparent;
    background: transparent;
    box-shadow: none;
    transition:
      background-color 300ms ease,
      border-color 300ms ease,
      box-shadow 300ms ease,
      border-radius 300ms ease;
  }

  .site-header--over-hero[data-scrolled="true"] .site-header__shell {
    border-radius: 999px;
    border-color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 16%, transparent);
    background: var(--f1-header-scrolled-bg, #fffaf3);
    box-shadow: 0 24px 90px -70px hsl(220 15% 15% / 0.45);
  }

  .site-header__inner {
    box-sizing: border-box;
    max-width: 1280px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-header--over-hero .site-header__inner {
    height: 5.5rem; /* 88px — +10% for larger logo */
    padding: 0;
    transition:
      height 300ms ease,
      padding 300ms ease;
  }

  .site-header--over-hero[data-scrolled="true"] .site-header__inner {
    height: 4.675rem; /* ~75px */
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: #111827;
    min-width: 0;
    flex: 0 1 auto;
    position: relative;
    z-index: 2;
    cursor: pointer;
  }

  .site-header__brand span {
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .site-header__logo {
    display: block;
    height: 3.15rem;
    max-width: 11rem;
    width: auto;
    object-fit: contain;
  }

  .site-header--over-hero .site-header__logo--over,
  .site-header--over-hero .site-header__logo--solid {
    height: 3.375rem; /* ~54px — +12.5% vs prior 3rem */
    max-width: 12.75rem;
    transition:
      opacity 300ms ease,
      height 300ms ease,
      filter 300ms ease;
  }

  .site-header--over-hero .site-header__logo--solid {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    opacity: 0;
  }

  .site-header--over-hero .site-header__logo--over {
    opacity: 1;
    filter: drop-shadow(0 2px 12px rgba(0, 0, 0, 0.35));
  }

  .site-header--over-hero[data-scrolled="true"] .site-header__logo--over {
    opacity: 0;
  }

  .site-header--over-hero[data-scrolled="true"] .site-header__logo--solid {
    opacity: 1;
    height: 2.8rem; /* ~45px — proportional to larger pre-scroll mark */
  }

  .site-header__nav {
    display: none;
    align-items: center;
    gap: 2.5rem;
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  .site-header--over-hero .site-header__nav {
    opacity: 0;
    transform: translateY(4px);
    pointer-events: none;
  }

  .site-header--over-hero[data-scrolled="true"] .site-header__nav,
  .site-header--over-hero[data-nav-reveal="always"] .site-header__nav {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .site-header__nav-link {
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 82%, transparent);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .site-header__nav-link:hover {
    color: var(--site-color-primary, hsl(145 63% 42%));
  }

  /* Over-hero nav reads on dark media — white, never brand-red. */
  .site-header--over-hero .site-header__nav-link {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.05rem;
  }

  .site-header--over-hero .site-header__nav-link:hover {
    color: rgba(255, 255, 255, 0.98);
  }

  .site-header :global(a.site-header__cta) {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2rem;
    padding: 0.28rem 0.95rem;
    border-radius: 999px;
    border: 1.5px solid var(--site-color-primary, hsl(145 63% 42%));
    background: transparent;
    color: var(--site-color-primary, hsl(145 63% 42%));
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    line-height: 1;
    white-space: nowrap;
    flex: 0 0 auto;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .site-header[data-pill-chrome="false"] :global(a.site-header__cta:not(.f1-cta)) {
    border-radius: var(--site-radius-button, 0.5rem);
    min-height: 2.35rem;
    padding: 0.4rem 1.1rem;
    font-weight: 600;
  }

  .site-header:not(.site-header--over-hero) :global(a.site-header__cta:hover) {
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 10%, white);
  }

  .site-header:not(.site-header--over-hero) :global(a.site-header__cta:active) {
    transform: translateY(1px);
  }

  .site-header:not(.site-header--over-hero) :global(a.site-header__cta:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 40%, white);
    outline-offset: 2px;
  }

  .site-header--over-hero :global(a.site-header__cta.f1-cta) {
    height: var(--f1-btn-height-sm, 2.5rem);
    min-height: var(--f1-btn-height-sm, 2.5rem);
    padding: 0 1.25rem;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.5;
  }

  /* PT solid header CTA (Golden Master) — soft radius, primary fill */
  .site-header--over-hero[data-cta-variant="solid"] :global(a.site-header__cta.f1-cta--solid) {
    height: 2.5rem;
    min-height: 2.5rem;
    padding: 0 1.1rem;
    border: none;
    border-radius: 0.6rem;
