---
type IconName = "shield" | "heart" | "users" | "clock" | "star";

const { name } = Astro.props as { name: IconName };
---

{name === "shield" && (
  <svg class="just-feature-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none">
    <path
      d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3Z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
    />
  </svg>
)}

{name === "heart" && (
  <svg class="just-feature-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none">
    <path
      d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
    />
  </svg>
)}

{name === "users" && (
  <svg class="just-feature-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none">
    <circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.6" />
    <path
      d="M4 18c0-2.8 2.5-5 5-5s5 2.2 5 5"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    />
    <circle cx="17" cy="9" r="2.2" stroke="currentColor" stroke-width="1.6" />
    <path
      d="M15.5 18c.2-1.8 1.5-3.2 3.5-3.8"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    />
  </svg>
)}

{name === "clock" && (
  <svg class="just-feature-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none">
    <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6" />
    <path
      d="M12 7v5l3 2"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
)}

{name === "star" && (
  <svg class="just-feature-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none">
    <path
      d="m12 4 2.2 4.5 5 .7-3.6 3.5.9 4.9-4.5-2.4-4.5 2.4.9-4.9L4.8 9.2l5-.7L12 4Z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"
    />
  </svg>
)}

<style>
  .just-feature-icon {
    width: 1.6rem;
    height: 1.6rem;
    display: block;
    color: var(--site-color-primary, hsl(145 20% 45%));
    flex-shrink: 0;
  }
</style>