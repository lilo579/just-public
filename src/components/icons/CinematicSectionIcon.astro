---
type CinematicIconName =
  | "heart"
  | "users"
  | "star"
  | "circle"
  | "brain"
  | "book"
  | "clock"
  | "shield"
  | "search"
  | "target"
  | "sprout"
  | "handshake"
  | "user-check";

const { name, class: className = "" } = Astro.props as {
  name: CinematicIconName;
  class?: string;
};
---

<svg
  class:list={["cinematic-section-icon", className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill="none"
>
  {name === "heart" && (
    <path
      d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"
      stroke="currentColor"
      stroke-width="1.35"
      stroke-linejoin="round"
    />
  )}

  {name === "users" && (
    <g stroke="currentColor" stroke-width="1.35" stroke-linecap="round">
      <circle cx="9" cy="8" r="3" />
      <path d="M4 18c0-2.8 2.5-5 5-5s5 2.2 5 5" />
      <circle cx="17" cy="9" r="2.2" />
      <path d="M15.5 18c.2-1.8 1.5-3.2 3.5-3.8" />
    </g>
  )}

  {name === "star" && (
    <path
      d="m12 4 2.2 4.5 5 .7-3.6 3.5.9 4.9-4.5-2.4-4.5 2.4.9-4.9L4.8 9.2l5-.7L12 4Z"
      stroke="currentColor"
      stroke-width="1.35"
      stroke-linejoin="round"
    />
  )}

  {name === "circle" && (
    <circle cx="12" cy="12" r="7.5" stroke="currentColor" stroke-width="1.35" />
  )}

  {name === "brain" && (
    <path
      d="M9.5 4.5a3 3 0 0 0-3 3v.4A2.8 2.8 0 0 0 4 10.5c0 1.2.7 2.2 1.8 2.6V15a3 3 0 0 0 3 3h.7M14.5 4.5a3 3 0 0 1 3 3v.4A2.8 2.8 0 0 1 20 10.5c0 1.2-.7 2.2-1.8 2.6V15a3 3 0 0 1-3 3h-.7M12 4.5v13.5M9.5 9h5M9.5 12.5h5"
      stroke="currentColor"
      stroke-width="1.35"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  )}

  {name === "book" && (
    <path
      d="M5 5.5A2.5 2.5 0 0 1 7.5 3H19v15.5H7.5A2.5 2.5 0 0 0 5 21V5.5Z"
      stroke="currentColor"
      stroke-width="1.35"
      stroke-linejoin="round"
    />
  )}

  {name === "clock" && (
    <g stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="8" />
      <path d="M12 7v5l3 2" />
    </g>
  )}

  {name === "shield" && (
    <path
      d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3Z"
      stroke="currentColor"
      stroke-width="1.35"
      stroke-linejoin="round"
    />
  )}

  {name === "search" && (
    <g stroke="currentColor" stroke-width="1.35" stroke-linecap="round">
      <circle cx="11" cy="11" r="6.5" />
      <path d="m16 16 4 4" />
    </g>
  )}

  {name === "target" && (
    <g stroke="currentColor" stroke-width="1.35">
      <circle cx="12" cy="12" r="8" />
      <circle cx="12" cy="12" r="4.5" />
      <circle cx="12" cy="12" r="1.4" fill="currentColor" stroke="none" />
    </g>
  )}

  {name === "sprout" && (
    <path
      d="M12 20v-8M12 12c0-4 3-7 7-7-1 4-4 7-7 7Zm0 0c0-4-3-7-7-7 1 4 4 7 7 7Z"
      stroke="currentColor"
      stroke-width="1.35"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  )}

  {name === "handshake" && (
    <path
      d="M8 13.5 4.8 10a2 2 0 0 1 0-2.8l.7-.7a2 2 0 0 1 2.8 0L11 9.2M16 13.5l3.2-3.3a2 2 0 0 0 0-2.8l-.7-.7a2 2 0 0 0-2.8 0L13 9.2M9.5 14.5l1.2 1.2a2 2 0 0 0 2.8 0l1.2-1.2M8.5 16.5l1 1a2.2 2.2 0 0 0 3.1 0l1-1"
      stroke="currentColor"
      stroke-width="1.35"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  )}

  {name === "user-check" && (
    <g stroke="currentColor" stroke-width="1.35" stroke-linecap="round">
      <circle cx="9" cy="8" r="3.2" />
      <path d="M3.5 19c0-2.9 2.5-5.2 5.5-5.2s5.5 2.3 5.5 5.2" />
      <path d="m15.5 11 2 2 3.5-3.8" />
    </g>
  )}
</svg>

<style>
  .cinematic-section-icon {
    width: 1.25rem;
    height: 1.25rem;
    display: block;
    flex-shrink: 0;
  }
</style>
