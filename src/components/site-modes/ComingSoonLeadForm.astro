---
/**
 * Platform Coming Soon lead form.
 * Rendered only when leadCaptureEnabled === true (builder + page guard).
 * No persistence and no simulated success — intake is not wired.
 */
interface Props {
  nameLabel?: string | null
  whatsappLabel?: string | null
  submitLabel?: string | null
}

const {
  nameLabel = "Nome",
  whatsappLabel = "WhatsApp",
  submitLabel = "Enviar",
} = Astro.props
---

<div class="site-mode-lead" data-site-mode-lead>
  <form class="site-mode-lead__form" data-site-mode-lead-form>
    <div class="site-mode-lead__field">
      <label for="site-mode-lead-name">{nameLabel}</label>
      <input
        id="site-mode-lead-name"
        name="name"
        type="text"
        autocomplete="name"
        required
      />
    </div>
    <div class="site-mode-lead__field">
      <label for="site-mode-lead-whatsapp">{whatsappLabel}</label>
      <input
        id="site-mode-lead-whatsapp"
        name="whatsapp"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        required
      />
    </div>
    <button type="submit" class="site-mode-lead__submit" disabled>{submitLabel}</button>
  </form>
</div>

<script>
  document.querySelectorAll("[data-site-mode-lead]").forEach((root) => {
    const form = root.querySelector("[data-site-mode-lead-form]")
    if (!(form instanceof HTMLFormElement)) return
    form.addEventListener("submit", (event) => {
      event.preventDefault()
    })
  })
</script>

<style>
  .site-mode-lead {
    width: min(100%, 28rem);
    margin-inline: auto;
  }

  .site-mode-lead__form {
    display: grid;
    gap: 1.25rem;
    text-align: left;
  }

  .site-mode-lead__field {
    display: grid;
    gap: 0.5rem;
  }

  .site-mode-lead__field label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--site-color-text, #121212);
  }

  .site-mode-lead__field input {
    height: 2.75rem;
    padding: 0 0.85rem;
    border: 1px solid color-mix(in srgb, var(--site-color-text, #121212) 14%, transparent);
    border-radius: var(--site-radius, 1rem);
    background: var(--site-color-card, #fff);
    color: var(--site-color-text, #121212);
    font: inherit;
  }

  .site-mode-lead__submit {
    height: 2.75rem;
    border: 0;
    border-radius: 9999px;
    background: var(--site-color-primary, #121212);
    color: var(--site-color-text-inverse, #fff);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .site-mode-lead__submit:disabled {
    cursor: not-allowed;
    opacity: 0.72;
  }

  .site-mode-lead__submit:focus-visible,
  .site-mode-lead__field input:focus-visible {
    outline: 2px solid var(--site-color-accent, #3b5bdb);
    outline-offset: 3px;
  }
</style>
