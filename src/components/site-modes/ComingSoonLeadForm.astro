---
/**
 * Platform Coming Soon lead form — UI-only success (no backend).
 * Persistence requires leadCaptureEnabled + future intake wiring (not M2).
 */
interface Props {
  nameLabel?: string | null
  whatsappLabel?: string | null
  submitLabel?: string | null
  successTitle?: string | null
  successBody?: string | null
}

const {
  nameLabel = "Nome",
  whatsappLabel = "WhatsApp",
  submitLabel = "Enviar",
  successTitle = "Obrigado!",
  successBody = "Recebemos seus dados.",
} = Astro.props
---

<div class="site-mode-lead" data-site-mode-lead>
  <form class="site-mode-lead__form" data-site-mode-lead-form novalidate>
    <div class="site-mode-lead__field">
      <label for="site-mode-lead-name">{nameLabel}</label>
      <input
        id="site-mode-lead-name"
        name="name"
        type="text"
        autocomplete="name"
        required
      />
    </div>
    <div class="site-mode-lead__field">
      <label for="site-mode-lead-whatsapp">{whatsappLabel}</label>
      <input
        id="site-mode-lead-whatsapp"
        name="whatsapp"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        required
      />
    </div>
    <button type="submit" class="site-mode-lead__submit">{submitLabel}</button>
  </form>

  <div
    class="site-mode-lead__success"
    data-site-mode-lead-success
    hidden
    role="status"
    aria-live="polite"
  >
    <p class="site-mode-lead__success-title">{successTitle}</p>
    <p class="site-mode-lead__success-body">{successBody}</p>
  </div>
</div>

<script>
  document.querySelectorAll("[data-site-mode-lead]").forEach((root) => {
    const form = root.querySelector("[data-site-mode-lead-form]")
    const success = root.querySelector("[data-site-mode-lead-success]")
    if (!(form instanceof HTMLFormElement) || !(success instanceof HTMLElement)) return

    form.addEventListener("submit", (event) => {
      event.preventDefault()
      const name = String(new FormData(form).get("name") || "").trim()
      const whatsapp = String(new FormData(form).get("whatsapp") || "").trim()
      if (!name || !whatsapp) return
      form.hidden = true
      success.hidden = false
    })
  })
</script>

<style>
  .site-mode-lead {
    width: min(100%, 28rem);
    margin-inline: auto;
  }

  .site-mode-lead__form {
    display: grid;
    gap: 1.25rem;
    text-align: left;
  }

  .site-mode-lead__field {
    display: grid;
    gap: 0.5rem;
  }

  .site-mode-lead__field label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--site-color-text, #121212);
  }

  .site-mode-lead__field input {
    height: 2.75rem;
    padding: 0 0.85rem;
    border: 1px solid color-mix(in srgb, var(--site-color-text, #121212) 14%, transparent);
    border-radius: var(--site-radius, 1rem);
    background: var(--site-color-card, #fff);
    color: var(--site-color-text, #121212);
    font: inherit;
  }

  .site-mode-lead__submit {
    height: 2.75rem;
    border: 0;
    border-radius: 9999px;
    background: var(--site-color-primary, #121212);
    color: var(--site-color-text-inverse, #fff);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .site-mode-lead__submit:focus-visible,
  .site-mode-lead__field input:focus-visible {
    outline: 2px solid var(--site-color-accent, #3b5bdb);
    outline-offset: 3px;
  }

  .site-mode-lead__success {
    padding: 2rem 1.5rem;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--site-color-text, #121212) 12%, transparent);
    background: var(--site-color-card, #fff);
    text-align: center;
  }

  .site-mode-lead__success-title {
    margin: 0;
    font-family: var(--site-font-heading, ui-sans-serif, system-ui, sans-serif);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .site-mode-lead__success-body {
    margin: 0.75rem 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--site-color-text-muted, #616161);
  }
</style>
