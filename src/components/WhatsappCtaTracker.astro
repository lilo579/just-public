---
import { PUBLIC_LEADS_INTAKE_URL, SUPABASE_ANON_KEY } from "../config/publicSite";

const {
  sourceType = "whatsapp_cta",
} = Astro.props as {
  sourceType?: string;
};
---

<script
  define:vars={{
    leadsUrl: PUBLIC_LEADS_INTAKE_URL,
    anonKey: SUPABASE_ANON_KEY,
    sourceType,
  }}
>
  document.querySelectorAll("[data-track-whatsapp-cta]").forEach((link) => {
    link.addEventListener("click", async () => {
      if (!leadsUrl || !anonKey) return;
      if (!(link instanceof HTMLAnchorElement)) return;

      const currentUrl = new URL(window.location.href);
      const resolvedHost = currentUrl.searchParams.get("host")?.trim() || window.location.host;

      const ctaId = link.dataset.ctaId || "whatsapp-cta";
      const ctaLabel = (link.textContent || "").trim();

      try {
        await fetch(leadsUrl, {
          method: "POST",
          keepalive: true,
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${anonKey}`,
            apikey: anonKey,
          },
          body: JSON.stringify({
            host: resolvedHost,
            full_name: "WhatsApp CTA Click",
            email: null,
            phone: null,
            source_type: sourceType,
            path: window.location.pathname,
            metadata: {
              source: "just-public",
              href: window.location.href,
              cta_id: ctaId,
              cta_label: ctaLabel,
              target_href: link.href,
            },
          }),
        });
      } catch {
        // Non-blocking by design: WhatsApp must open normally.
      }
    });
  });
</script>
