---
/**
 * Painted Execution Plan binder — no domain compilation.
 * Expects `node.paint` (final block + layout) from Hub compile.
 * Optionally enriches paint from F1 presentation chrome (cinematic_v1).
 */
import EditorialHero from "./mission/editorial/Hero.astro"
import EditorialFeatured from "./mission/editorial/Featured.astro"
import EditorialRecurring from "./mission/editorial/Recurring.astro"
import EditorialPatronage from "./mission/editorial/Patronage.astro"
import EditorialHistory from "./mission/editorial/History.astro"
import EditorialAbout from "./mission/editorial/About.astro"
import EditorialContact from "./mission/editorial/Contact.astro"
import HeroBlock from "./blocks/HeroBlock.astro"
import TrustBlock from "./blocks/TrustBlock.astro"
import ServicesBlock from "./blocks/ServicesBlock.astro"
import RichTextBlock from "./blocks/RichTextBlock.astro"
import AboutBlock from "./blocks/AboutBlock.astro"
import BenefitsBlock from "./blocks/BenefitsBlock.astro"
import FeaturesBlock from "./blocks/FeaturesBlock.astro"
import ProcessBlock from "./blocks/ProcessBlock.astro"
import InfoCardBlock from "./blocks/InfoCardBlock.astro"
import TestimonialsBlock from "./blocks/TestimonialsBlock.astro"
import ProofGalleryBlock from "./blocks/ProofGalleryBlock.astro"
import CtaBlock from "./blocks/CtaBlock.astro"
import CatalogCategoryNavBlock from "./blocks/CatalogCategoryNavBlock.astro"
import CatalogProductGridBlock from "./blocks/CatalogProductGridBlock.astro"
import CatalogRichSectionBlock from "./blocks/CatalogRichSectionBlock.astro"
import MissionInitiativeBlock from "./blocks/MissionInitiativeBlock.astro"
import MissionProgressTrackBlock from "./blocks/MissionProgressTrackBlock.astro"
import MissionPatronageBlock from "./blocks/MissionPatronageBlock.astro"
import MissionRecurringSupportBlock from "./blocks/MissionRecurringSupportBlock.astro"
import MissionHistoryCollectionBlock from "./blocks/MissionHistoryCollectionBlock.astro"
import { enrichPlanPaintWithPresentationChrome } from "../lib/enrichPlanPaintWithPresentationChrome.js"

import type {
  AboutBlock as AboutBlockType,
  BenefitsBlock as BenefitsBlockType,
  CtaBlock as CtaBlockType,
  FeaturesBlock as FeaturesBlockType,
  HeroBlock as HeroBlockType,
  InfoCardBlock as InfoCardBlockType,
  ProcessBlock as ProcessBlockType,
  RichTextBlock as RichTextBlockType,
  SerializableHomepageRenderNode,
  SerializableHomepageRenderPlan,
  ServicesBlock as ServicesBlockType,
  TestimonialsBlock as TestimonialsBlockType,
  TrustBlock as TrustBlockType,
} from "../contracts/homepage"

const { plan: rawPlan, showDiagnostics = false, presentationChrome = null, editorialChrome = null } = Astro.props as {
  plan: SerializableHomepageRenderPlan
  showDiagnostics?: boolean
  editorialChrome?: any
  presentationChrome?: unknown
}

const plan = enrichPlanPaintWithPresentationChrome(rawPlan, presentationChrome as any) as SerializableHomepageRenderPlan

type PaintedNode = NonNullable<SerializableHomepageRenderNode["paint"]>
type Editorial = {
  atmosphere?: string
  composition?: string
  suppressProblem?: boolean
  suppressServices?: boolean
  heroVideoUrl?: string | null
  processVideoUrl?: string | null
  proofCases?: unknown[]
  testimonialCards?: unknown[]
  testimonialsSubtitle?: string | null
  manifestoGhost?: string[]
  manifestoStatement?: string[]
  sectionIds?: {
    method?: string
    benefits?: string
    proof?: string
    testimonials?: string
    manifesto?: string
  }
}

const editorial =
  presentationChrome &&
  typeof presentationChrome === "object" &&
  (presentationChrome as { cinematicEditorial?: Editorial }).cinematicEditorial
    ? ((presentationChrome as { cinematicEditorial: Editorial }).cinematicEditorial as Editorial)
    : null

const isCinematic =
  presentationChrome &&
  typeof presentationChrome === "object" &&
  (presentationChrome as { profile?: string }).profile === "f1.presentation.cinematic_v1"

const isPtTrainer = editorial?.composition === "pt_trainer"

function sanitizeCommentValue(value: string): string {
  return value.replaceAll("--", " ").trim()
}

function commentFor(node: SerializableHomepageRenderNode, reason: string) {
  const safeKey = sanitizeCommentValue(node.componentKey)
  const safeId = sanitizeCommentValue(node.id)
  const safeReason = sanitizeCommentValue(reason)
  return `<!-- CanonicalHomepageRenderer skipped node id=${safeId} componentKey=${safeKey} reason=${safeReason} -->`
}

const isEditorialMission = (rawPlan.presentation?.chrome as any)?.heroLayout === "editorial-split" && rawPlan.presentation?.profile?.startsWith("f4.");
const editorialProgress = rawPlan.nodes?.find(n => n.paint?.component === "progress_track")?.paint?.block?.content || {};
const hasEditorialInitiative = rawPlan.nodes?.some(n => n.paint?.component === "initiative");

const orderedNodes = [...(plan.nodes ?? [])].sort((left, right) => left.order - right.order)

/** Cinematic SPA parity: principles (features) follow journey (process), before CTA. */
function cinematicPresentationNodes(
  nodes: SerializableHomepageRenderNode[],
): SerializableHomepageRenderNode[] {
  const featuresIdx = nodes.findIndex((node) => node.paint?.component === "features")
  const processIdx = nodes.findIndex((node) => node.paint?.component === "process")
  if (featuresIdx < 0 || processIdx < 0 || featuresIdx > processIdx) {
    return nodes
  }
  const next = [...nodes]
  const [featuresNode] = next.splice(featuresIdx, 1)
  const newProcessIdx = next.findIndex((node) => node.paint?.component === "process")
  next.splice(newProcessIdx + 1, 0, featuresNode)
  return next
}

/** PT trainer SPA parity: hero → proof → method(process) → benefits → testimonials → manifesto. */
function ptTrainerPresentationNodes(
  nodes: SerializableHomepageRenderNode[],
): SerializableHomepageRenderNode[] {
  const by = (component: string) => nodes.filter((node) => node.paint?.component === component)
  const rest = nodes.filter(
    (node) =>
      !["hero", "problem", "services", "process", "features", "benefits", "testimonials", "cta_final"].includes(
        node.paint?.component ?? "",
      ),
  )
  return [
    ...by("hero"),
    ...by("process"),
    ...by("features"),
    ...by("benefits"),
    ...by("testimonials"),
    ...rest,
    ...by("cta_final"),
  ]
}

const presentationOrderedNodes = !isCinematic
  ? orderedNodes
  : isPtTrainer
    ? ptTrainerPresentationNodes(orderedNodes)
    : cinematicPresentationNodes(orderedNodes)

const paintedEntries = presentationOrderedNodes.map((node) => {
  const paint = node.paint as PaintedNode | undefined
  if (!paint || !paint.component || !paint.block) {
    return {
      kind: "unsupported" as const,
      node,
      reason: "paint_missing_on_node",
    }
  }
  if (editorial?.suppressProblem && (paint.component === "problem" || paint.component === "rich_text")) {
    return { kind: "skipped" as const, node, reason: "cinematic_suppress_problem" }
  }
  if (editorial?.suppressServices && paint.component === "services") {
    return { kind: "skipped" as const, node, reason: "cinematic_suppress_services" }
  }
  if (
    isPtTrainer &&
    paint.component === "testimonials" &&
    Array.isArray(editorial?.testimonialCards) &&
    editorial.testimonialCards.length > 0
  ) {
    return { kind: "skipped" as const, node, reason: "cinematic_pt_testimonials_via_features" }
  }
  return { kind: "paint" as const, node, paint }
})

const unsupportedEntries = paintedEntries.filter(
  (entry): entry is Extract<(typeof paintedEntries)[number], { kind: "unsupported" }> =>
    entry.kind === "unsupported",
)
const unsupportedComponentKeys = unsupportedEntries.map((entry) => entry.node.componentKey)
const renderedCount = paintedEntries.filter((entry) => entry.kind === "paint").length

const proofCases = Array.isArray(editorial?.proofCases) ? editorial.proofCases : []
const testimonialCards = Array.isArray(editorial?.testimonialCards) ? editorial.testimonialCards : []
const proofSectionId = editorial?.sectionIds?.proof || "resultados"
const testimonialsSectionId = editorial?.sectionIds?.testimonials || "depoimentos"
const methodSectionId = editorial?.sectionIds?.method || "metodo"
const benefitsSectionId = editorial?.sectionIds?.benefits || "beneficios"
const manifestoSectionId = editorial?.sectionIds?.manifesto || "manifesto-final"
---

{
  showDiagnostics && (
    <section class="canonical-diagnostics" aria-label="Canonical renderer diagnostics">
      <div class="canonical-diagnostics__header">
        <strong>Canonical SSR Diagnostics</strong>
        <span>{plan.contractVersion || "unknown contract"}</span>
      </div>

      <dl class="canonical-diagnostics__stats">
        <div>
          <dt>Total nodes</dt>
          <dd>{plan.nodes?.length ?? 0}</dd>
        </div>
        <div>
          <dt>Rendered</dt>
          <dd>{renderedCount}</dd>
        </div>
        <div>
          <dt>Unsupported</dt>
          <dd>{unsupportedEntries.length}</dd>
        </div>
        <div>
          <dt>Paint mode</dt>
          <dd>bind-only</dd>
        </div>
      </dl>

      <div class="canonical-diagnostics__body">
        <div>
          <h2>Unsupported componentKeys</h2>
          {unsupportedComponentKeys.length > 0 ? (
            <ul>
              {unsupportedComponentKeys.map((componentKey) => (
                <li>{componentKey}</li>
              ))}
            </ul>
          ) : (
            <p>None</p>
          )}
        </div>

        <div>
          <h2>Presentation</h2>
          <p>{plan.presentation?.profile ?? "n/a"}</p>
        </div>
      </div>
    </section>
  )
}

{
  paintedEntries.map((entry) => {
    if (entry.kind === "unsupported" || entry.kind === "skipped") {
      return <Fragment set:html={commentFor(entry.node, entry.reason)} />
    }

    const { paint } = entry
    const layout = paint.layout ?? {}

    if (isEditorialMission) {
      const block = paint.block as any
      const content = {
        ...(block?.content || {}),
        // Painted CTAs live on the block root for shared Hero/CTA shells.
        primaryCta: block?.content?.primaryCta ?? block?.primaryCTA ?? null,
        secondaryCta: block?.content?.secondaryCta ?? block?.secondaryCTA ?? null,
        primaryCTA: block?.primaryCTA ?? block?.content?.primaryCta ?? null,
        secondaryCTA: block?.secondaryCTA ?? block?.content?.secondaryCta ?? null,
        cta: block?.content?.cta ?? block?.primaryCTA ?? null,
      }
      switch (paint.component) {
        case "hero":
          return <EditorialHero content={content} />
        case "initiative":
          return <EditorialFeatured content={content} progress={editorialProgress} />
        case "progress_track":
          if (hasEditorialInitiative) return null
          break
        case "recurring_support":
          return <EditorialRecurring content={content} />
        case "patronage":
          return <EditorialPatronage content={content} />
        case "history_collection":
          return <EditorialHistory content={content} />
        case "about":
          return <EditorialAbout content={content} />
        case "cta_final":
          return (
            <EditorialContact
              content={content}
              chrome={editorialChrome || { contact: content.contact }}
            />
          )
      }
    }
    switch (paint.component) {
      case "hero":
        return (
          <>
            <HeroBlock
              block={paint.block as HeroBlockType}
              layout={
                layout.heroLayout === "cinematic"
                  ? "cinematic"
                  : layout.heroLayout === "catalog"
                    ? "catalog"
                    : "standard"
              }
              videoUrl={editorial?.heroVideoUrl ?? null}
              ctaIcon={editorial?.atmosphere === "pt_dark" ? "none" : "auto"}
              omitPoster={editorial?.atmosphere === "pt_dark"}
            />
            {isPtTrainer && proofCases.length > 0 && (
              <ProofGalleryBlock cases={proofCases as any} sectionId={proofSectionId} />
            )}
          </>
        )

      case "trust":
        return (
          <TrustBlock
            block={paint.block as TrustBlockType}
            overlapHero={layout.trustOverlapsHero === true}
          />
        )

      case "services":
        return (
          <ServicesBlock
            block={paint.block as ServicesBlockType}
            layout={
              layout.servicesLayout === "classic-split"
                ? "classic-split"
                : layout.servicesLayout === "cinematic-signs"
                  ? "cinematic-signs"
                  : layout.servicesLayout === "cards"
                    ? "cards"
                    : "list"
            }
            sectionId={
              typeof layout.sectionId === "string"
                ? layout.sectionId
                : isPtTrainer
                  ? methodSectionId
                  : undefined
            }
          />
        )

      case "problem":
      case "rich_text":
        return (
          <RichTextBlock
            block={paint.block as RichTextBlockType}
            layout={
              layout.problemLayout === "cinematic-editorial"
                ? "cinematic-editorial"
                : "standard"
            }
          />
        )

      case "about":
        return (
          <AboutBlock
            block={paint.block as AboutBlockType}
            layout={
              layout.aboutLayout === "cinematic-authority"
                ? "cinematic-authority"
                : "standard"
            }
            sectionId={typeof layout.sectionId === "string" ? layout.sectionId : undefined}
          />
        )

      case "benefits":
        return (
          <BenefitsBlock
            block={paint.block as BenefitsBlockType}
            layout={
              layout.benefitsLayout === "classic-criteria-grid"
                ? "classic-criteria-grid"
                : "standard"
            }
          />
        )

      case "features":
        return (
          <>
            <FeaturesBlock
              block={paint.block as FeaturesBlockType}
              layout={
                layout.benefitsLayout === "cinematic-outcomes"
                  ? "cinematic-outcomes"
                  : layout.benefitsLayout === "cinematic-principles"
                    ? "cinematic-principles"
                    : "standard"
              }
              sectionId={
                typeof layout.sectionId === "string"
                  ? layout.sectionId
                  : isPtTrainer
                    ? benefitsSectionId
                    : undefined
              }
              outcomeImageUrls={
                Array.isArray((paint.block as any)?.content?.outcomeImageUrls)
                  ? ((paint.block as any).content.outcomeImageUrls as string[])
                  : []
              }
            />
            {isPtTrainer && testimonialCards.length > 0 && (
              <TestimonialsBlock
                block={{
                  type: "testimonials",
                  content: {
                    title: null,
                    subtitle: editorial?.testimonialsSubtitle ?? null,
                    items: (testimonialCards as any[]).map((card) => ({
                      company: card.name,
                      tag: card.meta,
                      quote: card.quote,
                      result: null,
                      videoUrl: card.videoUrl,
                      posterUrl: card.posterUrl ?? null,
                    })),
                    images: [],
                  },
                }}
                layout="cinematic-video"
                sectionId={testimonialsSectionId}
                sectionTitleFallback="Escute dos alunos"
              />
            )}
          </>
        )

      case "process":
        return (
          <ProcessBlock
            block={paint.block as ProcessBlockType}
            indexIcons={layout.processIndexIcons === true}
            badgeEmphasis={
              layout.processBadgeEmphasis === "primary" ? "primary" : "accent"
            }
            layout={
              layout.processLayout === "cinematic-method"
                ? "cinematic-method"
                : layout.processLayout === "cinematic-journey"
                  ? "cinematic-journey"
                  : "standard"
            }
            sectionId={
              typeof layout.sectionId === "string"
                ? layout.sectionId
                : isPtTrainer
                  ? methodSectionId
                  : undefined
            }
            videoUrl={editorial?.processVideoUrl ?? null}
          />
        )

      case "attendance":
        return (
          <InfoCardBlock
            block={paint.block as InfoCardBlockType}
            pillIconEmphasis={
              layout.attendancePillIconEmphasis === "primary" ? "primary" : "accent"
            }
          />
        )

      case "testimonials":
        return (
          <TestimonialsBlock
            block={paint.block as TestimonialsBlockType}
            layout={testimonialCards.length > 0 ? "cinematic-video" : "standard"}
            sectionId={testimonialsSectionId}
          />
        )

      case "cta_final":
        return (
          <CtaBlock
            block={paint.block as CtaBlockType}
            layout={layout.ctaLayout === "cinematic-band" ? "cinematic-band" : "standard"}
            manifestoGhost={editorial?.manifestoGhost ?? []}
            manifestoStatement={editorial?.manifestoStatement ?? []}
            manifestoImageUrl={
              isPtTrainer
                ? ((paint.block as any)?.content?.manifestoImageUrl as string) ||
                  "/presentation/cinematic_v1/pt/manifesto-portrait.png"
                : ((paint.block as any)?.content?.manifestoImageUrl as string) || null
            }
            sectionId={
              typeof layout.sectionId === "string"
                ? layout.sectionId
                : isPtTrainer
                  ? manifestoSectionId
                  : undefined
            }
          />
        )

      case "category_nav":
        return <CatalogCategoryNavBlock block={paint.block} layout={layout} />

      case "product_grid":
        return <CatalogProductGridBlock block={paint.block} layout={layout} />

      case "customization":
      case "maker_story":
      case "fulfillment":
        return <CatalogRichSectionBlock block={paint.block} />

      case "initiative":
        return <MissionInitiativeBlock block={paint.block} />

      case "progress_track":
        return <MissionProgressTrackBlock block={paint.block} />

      case "patronage":
        return <MissionPatronageBlock block={paint.block} />

      case "recurring_support":
        return <MissionRecurringSupportBlock block={paint.block} />

      case "history_collection":
        return <MissionHistoryCollectionBlock block={paint.block} />

      default:
        return (
          <Fragment
            set:html={commentFor(entry.node, `unsupported_component:${paint.component}`)}
          />
        )
    }
  })
}

{!isPtTrainer && isCinematic && proofCases.length > 0 && (
  <ProofGalleryBlock cases={proofCases as any} sectionId={proofSectionId} />
)}
