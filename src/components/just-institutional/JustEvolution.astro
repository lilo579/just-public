---
import { justEvolution } from "../../lib/justInstitutionalFreeze.js"
import JustIcon from "./JustIcon.astro"
import JustStageVisual from "./JustStageVisual.astro"

const stageMeta = [
  { icon: "sprout", visual: "sprout" },
  { icon: "user", visual: "cards" },
  { icon: "users", visual: "team" },
  { icon: "shopping-bag", visual: "commerce" },
  { icon: "trending-up", visual: "growth" },
] as const

const outcomeIcons = [
  "flower2",
  "refresh-cw",
  "shield",
  "bar-chart-3",
] as const
---

<section
  id={justEvolution.id}
  class="business-evolution section-padding"
  aria-labelledby="business-evolution-heading"
>
  <div class="section-container">
    <header class="business-evolution__header">
      <div class="business-evolution__intro">
        <h2 id="business-evolution-heading" class="business-evolution__heading font-display">
          {justEvolution.headline}
        </h2>
      </div>
      <p class="business-evolution__lead">{justEvolution.lead}</p>
    </header>

    <div class="business-evolution__board">
      <svg
        class="business-evolution__curve"
        viewBox="0 0 1000 160"
        fill="none"
        aria-hidden="true"
        preserveAspectRatio="none"
      >
        <path
          class="business-evolution__curve-path"
          d="M30 142 C160 138 240 120 340 92 C440 64 520 42 620 30 C740 16 840 14 970 18"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        />
        <circle cx="90" cy="140" r="5" class="business-evolution__curve-dot" />
        <circle cx="290" cy="104" r="5" class="business-evolution__curve-dot" />
        <circle cx="490" cy="48" r="5" class="business-evolution__curve-dot" />
        <circle cx="690" cy="26" r="5" class="business-evolution__curve-dot" />
        <circle cx="890" cy="16" r="5" class="business-evolution__curve-dot" />
      </svg>

      <ol class="business-evolution__stages">
        {justEvolution.stages.map((stage, index) => (
          <li class="business-evolution__stage">
            <span class="business-evolution__stage-icon" aria-hidden="true">
              <JustIcon name={stageMeta[index].icon} strokeWidth={1.6} />
            </span>
            <h3 class="business-evolution__stage-title font-display">
              {index + 1}. {stage.title}
            </h3>
            <p class="business-evolution__stage-text">{stage.text}</p>
            <div class="business-evolution__art" aria-hidden="true">
              <JustStageVisual kind={stageMeta[index].visual} />
            </div>
          </li>
        ))}
      </ol>
    </div>

    <ul class="business-evolution__outcomes">
      {justEvolution.outcomes.map((outcome, index) => (
        <li class="business-evolution__outcome">
          <span class="business-evolution__outcome-icon" aria-hidden="true">
            <JustIcon name={outcomeIcons[index]} strokeWidth={1.6} />
          </span>
          <div>
            <h3 class="business-evolution__outcome-title">{outcome.title}</h3>
            <p class="business-evolution__outcome-text">{outcome.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
