---
const {
  title,
  description,
  canonicalUrl,
  ogImage,
  faviconUrl,
  robots,
  jsonLd,
  twitterCard = "summary",
  ogTitle,
  ogDescription,
  fontLoadUrl,
} = Astro.props as {
  title: string
  description: string
  canonicalUrl?: string
  ogImage?: string
  faviconUrl?: string
  robots?: string
  jsonLd?: Record<string, unknown>
  twitterCard?: string
  ogTitle?: string
  ogDescription?: string
  fontLoadUrl?: string | null
}

const jsonLdJson = jsonLd ? JSON.stringify(jsonLd) : ""

/** Brand-first MIME — never assume PNG for OG/webp logos used as icons. */
function faviconMime(url: string): string {
  const path = url.split("?")[0]?.toLowerCase() ?? ""
  if (path.endsWith(".svg")) return "image/svg+xml"
  if (path.endsWith(".ico")) return "image/x-icon"
  if (path.endsWith(".webp")) return "image/webp"
  if (path.endsWith(".jpg") || path.endsWith(".jpeg")) return "image/jpeg"
  if (path.endsWith(".gif")) return "image/gif"
  return "image/png"
}

const resolvedFavicon = typeof faviconUrl === "string" ? faviconUrl.trim() : ""
/** Only reject root Astro scaffold — packaged branding favicons are valid. */
const isAstroScaffold =
  resolvedFavicon === "/favicon.svg" || resolvedFavicon === "/favicon.ico"
/** Never emit Astro scaffold branding for customer sites. */
const brandFavicon = resolvedFavicon && !isAstroScaffold ? resolvedFavicon : ""
const brandingPackMatch = brandFavicon.match(/^\/branding\/([^/]+)\//)
const brandingPackSlug = brandingPackMatch?.[1] || ""
/** Only emit when the pack ships the file (avoid co-tenant 404s). */
const PACKS_WITH_APPLE_TOUCH = new Set([
  "marcelo-borer",
  "rossana-mendonca",
  "soraya-barbosa",
  "3d-jewish",
  "just",
])
const PACKS_WITH_MANIFEST = new Set(["3d-jewish", "just"])
const appleTouchIcon =
  brandingPackSlug && PACKS_WITH_APPLE_TOUCH.has(brandingPackSlug)
    ? `/branding/${brandingPackSlug}/apple-touch-icon.png`
    : ""
/** Only emit when the pack ships mask-icon.svg (avoid co-tenant 404s). */
const maskIcon =
  brandingPackSlug === "3d-jewish"
    ? `/branding/${brandingPackSlug}/mask-icon.svg`
    : ""
const webManifest =
  brandingPackSlug && PACKS_WITH_MANIFEST.has(brandingPackSlug)
    ? `/branding/${brandingPackSlug}/site.webmanifest`
    : ""
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{robots && <meta name="robots" content={robots} />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

{fontLoadUrl && (
  <>
    {fontLoadUrl.includes("fonts.googleapis.com") ? (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      </>
    ) : null}
    <link rel="stylesheet" href={fontLoadUrl} />
  </>
)}

{/* Brand icon only — /favicon.ico is a Worker redirect to the same URL. */}
{brandFavicon && (
  <>
    <link rel="icon" href={brandFavicon} type={faviconMime(brandFavicon)} />
    <link rel="shortcut icon" href={brandFavicon} type={faviconMime(brandFavicon)} />
  </>
)}
{appleTouchIcon && <link rel="apple-touch-icon" href={appleTouchIcon} />}
{maskIcon && <link rel="mask-icon" href={maskIcon} color="#111111" />}
{webManifest && <link rel="manifest" href={webManifest} />}

{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:type" content="website" />
<meta property="og:title" content={ogTitle || title} />
{ogDescription || description ? (
  <meta property="og:description" content={ogDescription || description} />
) : null}
{ogImage && <meta property="og:image" content={ogImage} />}
<meta property="og:locale" content="pt_BR" />

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={ogTitle || title} />
{(ogDescription || description) && (
  <meta name="twitter:description" content={ogDescription || description} />
)}
{ogImage && <meta name="twitter:image" content={ogImage} />}

{jsonLdJson && (
  <script type="application/ld+json" set:html={jsonLdJson} />
)}
