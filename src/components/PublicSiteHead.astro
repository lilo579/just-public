---
const {
  title,
  description,
  canonicalUrl,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogImageAlt,
  faviconUrl,
  robots,
  jsonLd,
  twitterCard = "summary",
  ogTitle,
  ogDescription,
  ogSiteName,
  fontLoadUrl,
} = Astro.props as {
  title: string
  description: string
  canonicalUrl?: string
  ogImage?: string
  /** Optional absolute pixel size for og:image (social crawlers). */
  ogImageWidth?: number | string
  ogImageHeight?: number | string
  ogImageAlt?: string
  faviconUrl?: string
  robots?: string
  jsonLd?: Record<string, unknown>
  twitterCard?: string
  ogTitle?: string
  ogDescription?: string
  /** Optional brand site name for og:site_name (e.g. JUST). */
  ogSiteName?: string
  fontLoadUrl?: string | null
}
const resolvedOgSiteName =
  typeof ogSiteName === "string" && ogSiteName.trim() ? ogSiteName.trim() : ""
const resolvedOgImageAlt =
  typeof ogImageAlt === "string" && ogImageAlt.trim() ? ogImageAlt.trim() : ""
const resolvedOgImageWidth =
  ogImageWidth !== undefined && ogImageWidth !== null && String(ogImageWidth).trim()
    ? String(ogImageWidth).trim()
    : ""
const resolvedOgImageHeight =
  ogImageHeight !== undefined && ogImageHeight !== null && String(ogImageHeight).trim()
    ? String(ogImageHeight).trim()
    : ""

const jsonLdJson = jsonLd ? JSON.stringify(jsonLd) : ""

/** Brand-first MIME — never assume PNG for OG/webp logos used as icons. */
function faviconMime(url: string): string {
  const path = url.split("?")[0]?.toLowerCase() ?? ""
  if (path.endsWith(".svg")) return "image/svg+xml"
  if (path.endsWith(".ico")) return "image/x-icon"
  if (path.endsWith(".webp")) return "image/webp"
  if (path.endsWith(".jpg") || path.endsWith(".jpeg")) return "image/jpeg"
  if (path.endsWith(".gif")) return "image/gif"
  return "image/png"
}

const resolvedFavicon = typeof faviconUrl === "string" ? faviconUrl.trim() : ""
/** Only reject root Astro scaffold — packaged branding favicons are valid. */
const isAstroScaffold =
  resolvedFavicon === "/favicon.svg" || resolvedFavicon === "/favicon.ico"
/** Never emit Astro scaffold branding for customer sites. */
const brandFavicon = resolvedFavicon && !isAstroScaffold ? resolvedFavicon : ""
const brandingPackMatch = brandFavicon.match(/^\/branding\/([^/]+)\//)
const brandingPackSlug = brandingPackMatch?.[1] || ""
/** Only emit when the pack ships the file (avoid co-tenant 404s). */
const PACKS_WITH_APPLE_TOUCH = new Set([
  "marcelo-borer",
  "rossana-mendonca",
  "soraya-barbosa",
  "3d-jewish",
  "just",
  "celina-pires",
  "flavio-personal",
])
const PACKS_WITH_MANIFEST = new Set(["3d-jewish", "just"])
/** Packs that ship mask-icon.svg for Safari pinned tabs. */
const PACKS_WITH_MASK_ICON = new Set(["3d-jewish", "just"])
const appleTouchIcon =
  brandingPackSlug && PACKS_WITH_APPLE_TOUCH.has(brandingPackSlug)
    ? `/branding/${brandingPackSlug}/apple-touch-icon.png`
    : ""
/** Only emit when the pack ships mask-icon.svg (avoid co-tenant 404s). */
const maskIcon =
  brandingPackSlug && PACKS_WITH_MASK_ICON.has(brandingPackSlug)
    ? `/branding/${brandingPackSlug}/mask-icon.svg`
    : ""
/** Safari applies this color to the mask silhouette. */
const maskIconColor = brandingPackSlug === "just" ? "#121212" : "#111111"
const webManifest =
  brandingPackSlug && PACKS_WITH_MANIFEST.has(brandingPackSlug)
    ? `/branding/${brandingPackSlug}/site.webmanifest`
    : ""
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{robots && <meta name="robots" content={robots} />}
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

{fontLoadUrl && (
  <>
    {fontLoadUrl.includes("fonts.googleapis.com") ? (
      <>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      </>
    ) : null}
    {fontLoadUrl === "/fonts/just/just-fonts.css" ? (
      <>
        <link
          rel="preload"
          href="/fonts/just/Geist-Bold.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
        <link
          rel="preload"
          href="/fonts/just/Inter-Regular.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
        <link
          rel="preload"
          href="/fonts/just/Inter-SemiBold.woff2"
          as="font"
          type="font/woff2"
          crossorigin
        />
      </>
    ) : null}
    <link rel="stylesheet" href={fontLoadUrl} />
  </>
)}

{/* Brand icon only — /favicon.ico is a Worker redirect to the same URL. */}
{brandFavicon && (
  <>
    <link rel="icon" href={brandFavicon} type={faviconMime(brandFavicon)} />
    <link rel="shortcut icon" href={brandFavicon} type={faviconMime(brandFavicon)} />
  </>
)}
{appleTouchIcon && <link rel="apple-touch-icon" href={appleTouchIcon} />}
{maskIcon && <link rel="mask-icon" href={maskIcon} color={maskIconColor} />}
{webManifest && <link rel="manifest" href={webManifest} />}

{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
<meta property="og:type" content="website" />
{resolvedOgSiteName && (
  <meta property="og:site_name" content={resolvedOgSiteName} />
)}
<meta property="og:title" content={ogTitle || title} />
{ogDescription || description ? (
  <meta property="og:description" content={ogDescription || description} />
) : null}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && resolvedOgImageWidth && (
  <meta property="og:image:width" content={resolvedOgImageWidth} />
)}
{ogImage && resolvedOgImageHeight && (
  <meta property="og:image:height" content={resolvedOgImageHeight} />
)}
{ogImage && resolvedOgImageAlt && (
  <meta property="og:image:alt" content={resolvedOgImageAlt} />
)}
<meta property="og:locale" content="pt_BR" />

<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={ogTitle || title} />
{(ogDescription || description) && (
  <meta name="twitter:description" content={ogDescription || description} />
)}
{ogImage && <meta name="twitter:image" content={ogImage} />}

{jsonLdJson && (
  <script type="application/ld+json" set:html={jsonLdJson} />
)}
