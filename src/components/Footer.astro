---
import type { HomepageFooter } from "../contracts/homepage"

const { footer } = Astro.props as {
  footer: HomepageFooter
}

function formatPhoneDisplay(phone: string) {
  if (!phone || phone.length < 10) return phone
  const cleaned = phone.startsWith("55") ? phone.slice(2) : phone
  if (cleaned.length === 11) {
    return `(${cleaned.slice(0, 2)}) ${cleaned.slice(2, 7)}-${cleaned.slice(7)}`
  }
  if (cleaned.length === 10) {
    return `(${cleaned.slice(0, 2)}) ${cleaned.slice(2, 6)}-${cleaned.slice(6)}`
  }
  return phone
}

const hasContactInfo =
  (footer.whatsappVisible && footer.whatsappNumber) ||
  footer.email ||
  footer.address

const visibleLinks = (footer.socialLinks ?? []).filter((link) => (link.url ?? "").trim() !== "")
const year = new Date().getFullYear()
---

<footer class="site-footer">
  <div class="site-footer__signature">
    Desenvolvido pela <strong>JUST</strong> — a estrutura para seu negócio funcionar online
  </div>

  <div class="site-footer__inner">
    <div class="site-footer__brand">
      {footer.logoUrl && (
        <a href="/" class="site-footer__logo-link">
          <img
            src={footer.logoUrl}
            alt={footer.companyName || "Logo"}
            class="site-footer__logo"
          />
        </a>
      )}

      {footer.tagline && <p class="site-footer__tagline">{footer.tagline}</p>}
    </div>

    {hasContactInfo ? (
      <div class="site-footer__section">
        <h3>Contato</h3>

        <ul class="site-footer__list">
          {footer.whatsappVisible && footer.whatsappNumber && (
            <li class="site-footer__item">
              <span class="site-footer__item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M20 11.5a8 8 0 0 1-8 8 8.7 8.7 0 0 1-3.2-.6L4 20l1.1-4.1A8 8 0 1 1 20 11.5Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <a
                href={`https://wa.me/${footer.whatsappNumber}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {formatPhoneDisplay(footer.whatsappNumber)}
              </a>
            </li>
          )}

          {footer.email && (
            <li class="site-footer__item">
              <span class="site-footer__item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M4 6h16v12H4z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                  />
                  <path
                    d="m5 7 7 6 7-6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>

              <a href={`mailto:${footer.email}`}>{footer.email}</a>
            </li>
          )}

          {footer.address && (
            <li class="site-footer__item site-footer__item--start">
              <span class="site-footer__item-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M12 21s6-5.7 6-11a6 6 0 1 0-12 0c0 5.3 6 11 6 11Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                  />
                  <circle
                    cx="12"
                    cy="10"
                    r="2.2"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                </svg>
              </span>

              <span class="site-footer__address">{footer.address}</span>
            </li>
          )}
        </ul>
      </div>
    ) : (
      <div class="site-footer__section site-footer__section--empty"></div>
    )}

    {visibleLinks.length > 0 ? (
      <div class="site-footer__section">
        <h3>Redes Sociais</h3>

        <div class="site-footer__social">
          {visibleLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={link.type}
              class="site-footer__social-link"
            >
              {link.type === "linkedin" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M6.94 6.5a1.44 1.44 0 1 1 0-2.88 1.44 1.44 0 0 1 0 2.88ZM5.5 8.5h2.88V19H5.5V8.5Zm5.06 0h2.76v1.43h.04c.38-.72 1.32-1.48 2.72-1.48 2.9 0 3.44 1.9 3.44 4.36V19h-2.88v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.96 1.32-1.96 2.7V19h-2.88V8.5Z"
                    fill="currentColor"
                  />
                </svg>
              )}

              {link.type === "instagram" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect
                    x="4"
                    y="4"
                    width="16"
                    height="16"
                    rx="5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                  <circle
                    cx="12"
                    cy="12"
                    r="3.5"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                  />
                  <circle cx="17" cy="7" r="1" fill="currentColor" />
                </svg>
              )}

              {link.type === "facebook" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M13 20v-7h3l.4-3H13V8.3c0-.9.3-1.5 1.6-1.5h2V4.1c-.3 0-1.2-.1-2.4-.1-2.4 0-4 1.4-4 4.2V10H8v3h2.2v7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              )}

              {link.type === "youtube" && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M21 12c0 2.8-.3 4.4-.7 5.2-.3.6-.8 1.1-1.4 1.4-.8.4-2.4.7-6.9.7s-6.1-.3-6.9-.7c-.6-.3-1.1-.8-1.4-1.4C3.3 16.4 3 14.8 3 12s.3-4.4.7-5.2c.3-.6.8-1.1 1.4-1.4.8-.4 2.4-.7 6.9-.7s6.1.3 6.9.7c.6.3 1.1.8 1.4 1.4.4.8.7 2.4.7 5.2Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                  />
                  <path
                    d="m10 9 5 3-5 3V9Z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linejoin="round"
                  />
                </svg>
              )}

              {link.type !== "linkedin" &&
                link.type !== "instagram" &&
                link.type !== "facebook" &&
                link.type !== "youtube" && (
                  <span class="site-footer__social-fallback">
                    {link.type.slice(0, 2).toUpperCase()}
                  </span>
                )}
            </a>
          ))}
        </div>
      </div>
    ) : (
      <div class="site-footer__section site-footer__section--empty"></div>
    )}

    <p class="site-footer__copyright site-footer__copyright--global">
      © {year} {footer.companyName || "Empresa"}. Todos os direitos reservados.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: #f5f3ef;
  }

  .site-footer__signature {
    text-align: center;
    background: #e9dfd0;
    color: #9a7c47;
    font-size: 0.9rem;
    line-height: 1.4;
    padding: 0.82rem 1rem;
    letter-spacing: 0.005em;
  }

  .site-footer__signature strong {
    font-weight: 700;
  }

  .site-footer__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 3.35rem 1.5rem 3.8rem;
    display: grid;
    gap: 2.2rem;
  }

  .site-footer__brand {
    display: grid;
    gap: 1rem;
  }

  .site-footer__logo-link {
    display: inline-flex;
    width: fit-content;
  }

  .site-footer__logo {
    display: block;
    height: 3.25rem;
    max-width: 14rem;
    width: auto;
    object-fit: contain;
  }

  .site-footer__tagline {
    margin: 0;
    max-width: 34ch;
    color: #6b7280;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .site-footer__copyright--global {
    margin: 0;
    color: #6b7280;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .site-footer__section h3 {
    margin: 0 0 1rem;
    color: #1f2937;
    font-size: 1rem;
    font-weight: 700;
  }

  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.95rem;
  }

  .site-footer__item {
    display: flex;
    align-items: center;
    gap: 0.78rem;
    color: #6b7280;
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .site-footer__item--start {
    align-items: flex-start;
  }

  .site-footer__item a {
    color: #6b7280;
    text-decoration: none;
  }

  .site-footer__item-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #748776;
    margin-top: 0.06rem;
  }

  .site-footer__item-icon svg {
    width: 1.05rem;
    height: 1.05rem;
    display: block;
  }

  .site-footer__address {
    white-space: pre-line;
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .site-footer__social-link {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid #cfd6c8;
    background: transparent;
    color: #748776;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .site-footer__social-link svg {
    width: 1.28rem;
    height: 1.28rem;
    display: block;
  }

  .site-footer__social-fallback {
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .site-footer__section--empty {
    display: none;
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 1.2fr 1fr 0.8fr;
      align-items: start;
      gap: 3.25rem;
    }

    .site-footer__logo {
      height: 3.45rem;
      max-width: 15rem;
    }

    .site-footer__copyright--global {
      grid-column: 1 / 2;
      justify-self: start;
      margin-top: -0.25rem;
    }
  }

  @media (max-width: 767px) {
    .site-footer__inner {
      text-align: center;
      justify-items: center;
      gap: 1.75rem;
    }

    .site-footer__brand {
      justify-items: center;
    }

    .site-footer__tagline {
      text-align: center;
      max-width: 32ch;
    }

    .site-footer__item {
      justify-content: center;
    }

    .site-footer__item--start {
      align-items: flex-start;
    }

    .site-footer__social {
      justify-content: center;
    }

    .site-footer__copyright--global {
      text-align: center;
      max-width: 24ch;
    }
  }
</style>