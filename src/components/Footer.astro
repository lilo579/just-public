---
import type { HomepageFooter } from "../contracts/homepage"
import TrackedCTA from "./TrackedCTA.astro"
import MessageCircleIcon from "./icons/MessageCircleIcon.astro"

const {
  footer,
  justSignatureBand = true,
  footerSurface = "light",
  socialIconEmphasis = "muted",
  layout = "standard",
  navItems = [],
  whatsappHref = "",
  headerCtaLabel = "Fale comigo",
} = Astro.props as {
  footer: HomepageFooter
  /** engine_v1 shows JUST gold band; classic_v1 omits it. */
  justSignatureBand?: boolean
  /** Typed footer contrast — drives monochrome logo resolution upstream. */
  footerSurface?: "light" | "dark"
  /** classic_v1: primary token; engine_v1: muted neutrals. */
  socialIconEmphasis?: "primary" | "muted"
  layout?: "standard" | "cinematic-editorial"
  navItems?: Array<{ label: string; href: string }>
  whatsappHref?: string
  headerCtaLabel?: string
}

function formatPhoneDisplay(phone: string) {
  if (!phone || phone.length < 10) return phone
  const cleaned = phone.startsWith("55") ? phone.slice(2) : phone
  if (cleaned.length === 11) {
    return `(${cleaned.slice(0, 2)}) ${cleaned.slice(2, 7)}-${cleaned.slice(7)}`
  }
  if (cleaned.length === 10) {
    return `(${cleaned.slice(0, 2)}) ${cleaned.slice(2, 6)}-${cleaned.slice(6)}`
  }
  return phone
}

const isCinematic = layout === "cinematic-editorial"
const hasContactInfo =
  (footer.whatsappVisible && footer.whatsappNumber) ||
  footer.email ||
  footer.address

const visibleLinks = (footer.socialLinks ?? []).filter((link) => (link.url ?? "").trim() !== "")
const year = new Date().getFullYear()
const resolvedWhatsappHref =
  (typeof whatsappHref === "string" && whatsappHref.trim()) ||
  (footer.whatsappVisible && footer.whatsappNumber
    ? `https://wa.me/${footer.whatsappNumber}`
    : "")
const cinematicNavItems = Array.isArray(navItems) ? navItems : []
const ctaLabel =
  typeof headerCtaLabel === "string" && headerCtaLabel.trim()
    ? headerCtaLabel.trim()
    : "Fale comigo"
---

{
  isCinematic ? (
    <footer
      id="contato"
      class="site-footer site-footer--cinematic"
      data-just-signature="true"
      data-footer-surface={footerSurface}
      data-layout="cinematic-editorial"
    >
      <div class="site-footer__signature site-footer__signature--cream" aria-label="Desenvolvido pela JUST">
        <p class="site-footer__signature-text">
          Desenvolvido pela{" "}
          <a
            href="https://www.justwebsites.com.br"
            target="_blank"
            rel="noopener noreferrer"
            class="site-footer__signature-brand"
          >
            JUST
          </a>{" "}
          <span class="site-footer__signature-tail">
            — a estrutura para seu negócio funcionar online
          </span>
        </p>
      </div>

      <div class="site-footer__cinematic-shell">
        <div class="site-footer__card">
          <div class="site-footer__card-grid">
            <div class="site-footer__col site-footer__col--brand">
              {footer.logoUrl && (
                <a href="/" class="site-footer__logo-link">
                  <img
                    src={footer.logoUrl}
                    alt={footer.companyName || "Logo"}
                    class="site-footer__logo site-footer__logo--cinematic"
                  />
                </a>
              )}

              {footer.tagline && <p class="site-footer__tagline site-footer__tagline--cinematic">{footer.tagline}</p>}

              {resolvedWhatsappHref && (
                <TrackedCTA
                  href={resolvedWhatsappHref}
                  label={ctaLabel}
                  ctaId="footer-whatsapp"
                  class="site-footer__cta f1-cta f1-cta--outline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="f1-cta__icon" aria-hidden="true">
                    <MessageCircleIcon />
                  </span>
                  <span>{ctaLabel}</span>
                </TrackedCTA>
              )}
            </div>

            {cinematicNavItems.length > 0 && (
              <div class="site-footer__col site-footer__col--nav">
                <h3 class="site-footer__kicker">Navegação</h3>
                <div class="site-footer__kicker-rule" aria-hidden="true"></div>
                <nav class="site-footer__nav" aria-label="Navegação do rodapé">
                  {cinematicNavItems.map((item) => (
                    <a href={item.href} class="site-footer__nav-link">
                      {item.label}
                    </a>
                  ))}
                </nav>
              </div>
            )}

            <div class="site-footer__col site-footer__col--contact">
              {hasContactInfo && (
                <>
                  <h3 class="site-footer__kicker">Contato</h3>
                  <div class="site-footer__kicker-rule" aria-hidden="true"></div>
                  <ul class="site-footer__list site-footer__list--cinematic">
                    {footer.email && (
                      <li class="site-footer__item site-footer__item--pill">
                        <span class="site-footer__pill-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24">
                            <path
                              d="M4 6h16v12H4z"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linejoin="round"
                            />
                            <path
                              d="m5 7 7 6 7-6"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </span>
                        <a href={`mailto:${footer.email}`}>{footer.email}</a>
                      </li>
                    )}

                    {footer.whatsappVisible && footer.whatsappNumber && (
                      <li class="site-footer__item site-footer__item--pill">
                        <span class="site-footer__pill-icon" aria-hidden="true">
                          <MessageCircleIcon />
                        </span>
                        {resolvedWhatsappHref ? (
                          <a
                            href={resolvedWhatsappHref}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {formatPhoneDisplay(footer.whatsappNumber)}
                          </a>
                        ) : (
                          <span>{formatPhoneDisplay(footer.whatsappNumber)}</span>
                        )}
                      </li>
                    )}

                    {footer.address && (
                      <li class="site-footer__item site-footer__item--pill site-footer__item--start">
                        <span class="site-footer__pill-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24">
                            <path
                              d="M12 21s6-5.7 6-11a6 6 0 1 0-12 0c0 5.3 6 11 6 11Z"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                              stroke-linejoin="round"
                            />
                            <circle
                              cx="12"
                              cy="10"
                              r="2.2"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.8"
                            />
                          </svg>
                        </span>
                        <span class="site-footer__address">{footer.address}</span>
                      </li>
                    )}
                  </ul>
                </>
              )}

              {visibleLinks.length > 0 && (
                <div class="site-footer__social site-footer__social--cinematic">
                  {visibleLinks.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={link.type}
                      class="site-footer__social-link site-footer__social-link--cinematic"
                    >
                      {link.type === "linkedin" && (
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            d="M6.94 6.5a1.44 1.44 0 1 1 0-2.88 1.44 1.44 0 0 1 0 2.88ZM5.5 8.5h2.88V19H5.5V8.5Zm5.06 0h2.76v1.43h.04c.38-.72 1.32-1.48 2.72-1.48 2.9 0 3.44 1.9 3.44 4.36V19h-2.88v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.96 1.32-1.96 2.7V19h-2.88V8.5Z"
                            fill="currentColor"
                          />
                        </svg>
                      )}

                      {link.type === "instagram" && (
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <rect
                            x="4"
                            y="4"
                            width="16"
                            height="16"
                            rx="5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                          />
                          <circle
                            cx="12"
                            cy="12"
                            r="3.5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                          />
                          <circle cx="17" cy="7" r="1" fill="currentColor" />
                        </svg>
                      )}

                      {link.type === "facebook" && (
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            d="M13 20v-7h3l.4-3H13V8.3c0-.9.3-1.5 1.6-1.5h2V4.1c-.3 0-1.2-.1-2.4-.1-2.4 0-4 1.4-4 4.2V10H8v3h2.2v7"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      )}

                      {link.type === "youtube" && (
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            d="M21 12c0 2.8-.3 4.4-.7 5.2-.3.6-.8 1.1-1.4 1.4-.8.4-2.4.7-6.9.7s-6.1-.3-6.9-.7c-.6-.3-1.1-.8-1.4-1.4C3.3 16.4 3 14.8 3 12s.3-4.4.7-5.2c.3-.6.8-1.1 1.4-1.4.8-.4 2.4-.7 6.9-.7s6.1.3 6.9.7c.6.3 1.1.8 1.4 1.4.4.8.7 2.4.7 5.2Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.6"
                          />
                          <path
                            d="m10 9 5 3-5 3V9Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linejoin="round"
                          />
                        </svg>
                      )}

                      {link.type === "tiktok" && (
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            d="M16.5 5.5c.9 1.1 2.2 1.9 3.7 2v2.8c-1.3 0-2.5-.4-3.5-1v6.2c0 3.2-2.6 5.8-5.8 5.8S5.1 18.7 5.1 15.5s2.6-5.8 5.8-5.8c.3 0 .6 0 .9.1v3a2.9 2.9 0 0 0-.9-.15c-1.6 0-2.9 1.3-2.9 2.9s1.3 2.9 2.9 2.9 2.9-1.3 2.9-2.9V5.5h2.8Z"
                            fill="currentColor"
                          />
                        </svg>
                      )}

                      {link.type !== "linkedin" &&
                        link.type !== "instagram" &&
                        link.type !== "facebook" &&
                        link.type !== "youtube" &&
                        link.type !== "tiktok" && (
                          <span class="site-footer__social-fallback">
                            {link.type.slice(0, 2).toUpperCase()}
                          </span>
                        )}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>

          <p class="site-footer__copyright site-footer__copyright--card">
            {`© ${year} ${footer.companyName || "Empresa"}. Todos os direitos reservados.`}
          </p>
        </div>
      </div>
    </footer>
  ) : (
    <footer
      class="site-footer"
      data-just-signature={justSignatureBand ? "true" : "false"}
      data-footer-surface={footerSurface}
      data-social-emphasis={socialIconEmphasis}
    >
      {justSignatureBand && (
        <div class="site-footer__signature">
          Desenvolvido pela <strong>JUST</strong> — a estrutura para seu negócio funcionar online
        </div>
      )}

      <div class="site-footer__inner">
        <div class="site-footer__brand">
          {footer.logoUrl && (
            <a href="/" class="site-footer__logo-link">
              <img
                src={footer.logoUrl}
                alt={footer.companyName || "Logo"}
                class="site-footer__logo"
              />
            </a>
          )}

          {footer.tagline && <p class="site-footer__tagline">{footer.tagline}</p>}
        </div>

        {hasContactInfo ? (
          <div class="site-footer__section">
            <h3>Contato</h3>

            <ul class="site-footer__list">
              {footer.whatsappVisible && footer.whatsappNumber && (
                <li class="site-footer__item">
                  <span class="site-footer__item-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path
                        d="M20 11.5a8 8 0 0 1-8 8 8.7 8.7 0 0 1-3.2-.6L4 20l1.1-4.1A8 8 0 1 1 20 11.5Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>

                  <TrackedCTA
                    href={`https://wa.me/${footer.whatsappNumber}`}
                    label={formatPhoneDisplay(footer.whatsappNumber)}
                    ctaId="footer-whatsapp"
                    target="_blank"
                    rel="noopener noreferrer"
                  />
                </li>
              )}

              {footer.email && (
                <li class="site-footer__item">
                  <span class="site-footer__item-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path
                        d="M4 6h16v12H4z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                      />
                      <path
                        d="m5 7 7 6 7-6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>

                  <a href={`mailto:${footer.email}`}>{footer.email}</a>
                </li>
              )}

              {footer.address && (
                <li class="site-footer__item site-footer__item--start">
                  <span class="site-footer__item-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path
                        d="M12 21s6-5.7 6-11a6 6 0 1 0-12 0c0 5.3 6 11 6 11Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                      />
                      <circle
                        cx="12"
                        cy="10"
                        r="2.2"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                    </svg>
                  </span>

                  <span class="site-footer__address">{footer.address}</span>
                </li>
              )}
            </ul>
          </div>
        ) : (
          <div class="site-footer__section site-footer__section--empty"></div>
        )}

        {visibleLinks.length > 0 ? (
          <div class="site-footer__section">
            <h3>Redes Sociais</h3>

            <div class="site-footer__social">
              {visibleLinks.map((link) => (
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={link.type}
                  class="site-footer__social-link"
                >
                  {link.type === "linkedin" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M6.94 6.5a1.44 1.44 0 1 1 0-2.88 1.44 1.44 0 0 1 0 2.88ZM5.5 8.5h2.88V19H5.5V8.5Zm5.06 0h2.76v1.43h.04c.38-.72 1.32-1.48 2.72-1.48 2.9 0 3.44 1.9 3.44 4.36V19h-2.88v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.96 1.32-1.96 2.7V19h-2.88V8.5Z"
                        fill="currentColor"
                      />
                    </svg>
                  )}

                  {link.type === "instagram" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <rect
                        x="4"
                        y="4"
                        width="16"
                        height="16"
                        rx="5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                      <circle
                        cx="12"
                        cy="12"
                        r="3.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                      />
                      <circle cx="17" cy="7" r="1" fill="currentColor" />
                    </svg>
                  )}

                  {link.type === "facebook" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M13 20v-7h3l.4-3H13V8.3c0-.9.3-1.5 1.6-1.5h2V4.1c-.3 0-1.2-.1-2.4-.1-2.4 0-4 1.4-4 4.2V10H8v3h2.2v7"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}

                  {link.type === "youtube" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M21 12c0 2.8-.3 4.4-.7 5.2-.3.6-.8 1.1-1.4 1.4-.8.4-2.4.7-6.9.7s-6.1-.3-6.9-.7c-.6-.3-1.1-.8-1.4-1.4C3.3 16.4 3 14.8 3 12s.3-4.4.7-5.2c.3-.6.8-1.1 1.4-1.4.8-.4 2.4-.7 6.9-.7s6.1.3 6.9.7c.6.3 1.1.8 1.4 1.4.4.8.7 2.4.7 5.2Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                      />
                      <path
                        d="m10 9 5 3-5 3V9Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}

                  {link.type === "tiktok" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M16.5 5.5c.9 1.1 2.2 1.9 3.7 2v2.8c-1.3 0-2.5-.4-3.5-1v6.2c0 3.2-2.6 5.8-5.8 5.8S5.1 18.7 5.1 15.5s2.6-5.8 5.8-5.8c.3 0 .6 0 .9.1v3a2.9 2.9 0 0 0-.9-.15c-1.6 0-2.9 1.3-2.9 2.9s1.3 2.9 2.9 2.9 2.9-1.3 2.9-2.9V5.5h2.8Z"
                        fill="currentColor"
                      />
                    </svg>
                  )}

                  {link.type !== "linkedin" &&
                    link.type !== "instagram" &&
                    link.type !== "facebook" &&
                    link.type !== "youtube" &&
                    link.type !== "tiktok" && (
                      <span class="site-footer__social-fallback">
                        {link.type.slice(0, 2).toUpperCase()}
                      </span>
                    )}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <div class="site-footer__section site-footer__section--empty"></div>
        )}

        <p class="site-footer__copyright site-footer__copyright--global">
          {`© ${year} ${footer.companyName || "Empresa"}. Todos os direitos reservados.`}
        </p>
      </div>
    </footer>
  )
}

<style>
  .site-footer {
    background: #f5f3ef;
  }

  .site-footer[data-footer-surface="dark"] {
    background: var(--site-footer-bg-dark, #1f2937);
  }

  .site-footer[data-footer-surface="dark"] .site-footer__tagline,
  .site-footer[data-footer-surface="dark"] .site-footer__copyright--global,
  .site-footer[data-footer-surface="dark"] .site-footer__item,
  .site-footer[data-footer-surface="dark"] .site-footer__item a {
    color: var(--site-color-inverse, #e5e7eb);
  }

  .site-footer[data-footer-surface="dark"] .site-footer__section h3 {
    color: var(--site-color-inverse, #f9fafb);
  }

  .site-footer[data-footer-surface="dark"] .site-footer__item-icon {
    color: color-mix(in srgb, var(--site-color-inverse, #e5e7eb) 75%, transparent);
  }

  .site-footer__signature {
    text-align: center;
    background: #e9dfd0;
    color: #9a7c47;
    font-size: 0.9rem;
    line-height: 1.4;
    padding: 0.82rem 1rem;
    letter-spacing: 0.005em;
  }

  .site-footer__signature strong {
    font-weight: 700;
  }

  .site-footer__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 3.35rem 1.5rem 3.8rem;
    display: grid;
    gap: 2.2rem;
  }

  .site-footer__brand {
    display: grid;
    gap: 1rem;
  }

  .site-footer__logo-link {
    display: inline-flex;
    width: fit-content;
    line-height: 0;
    text-decoration: none;
  }

  .site-footer__logo {
    display: block;
    height: 3.25rem;
    max-width: 14rem;
    width: auto;
    object-fit: contain;
  }

  .site-footer__tagline {
    margin: 0;
    max-width: 34ch;
    color: #6b7280;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .site-footer__copyright--global {
    margin: 0;
    color: #6b7280;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .site-footer__section h3 {
    margin: 0 0 1rem;
    color: #1f2937;
    font-size: 1rem;
    font-weight: 700;
  }

  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.95rem;
  }

  .site-footer__item {
    display: flex;
    align-items: center;
    gap: 0.78rem;
    color: #6b7280;
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .site-footer__item--start {
    align-items: flex-start;
  }

  .site-footer__item a {
    color: #6b7280;
    text-decoration: none;
  }

  .site-footer__item-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #748776;
    margin-top: 0.06rem;
  }

  .site-footer__item-icon svg {
    width: 1.05rem;
    height: 1.05rem;
    display: block;
  }

  .site-footer__address {
    white-space: pre-line;
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .site-footer__social-link {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid #cfd6c8;
    background: transparent;
    color: #748776;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .site-footer[data-social-emphasis="primary"] .site-footer__social-link {
    color: var(--site-color-primary, hsl(145 63% 42%));
    border-color: color-mix(
      in srgb,
      var(--site-color-primary, hsl(145 63% 42%)) 38%,
      #cfd6c8
    );
  }

  .site-footer[data-social-emphasis="primary"] .site-footer__social-link:hover,
  .site-footer[data-social-emphasis="primary"] .site-footer__social-link:focus-visible {
