---
import type { SiteThemeTokens } from "../lib/themeFromBranding"
import { themeTokensToInlineStyle } from "../lib/themeFromBranding"

const { tokens } = Astro.props as { tokens: SiteThemeTokens }
const inlineStyle = themeTokensToInlineStyle(tokens)
---

{/* Apply allowlisted custom properties on a root wrapper — no raw CSS from DB */}
<div
  class="site-theme-root"
  data-site-theme
  data-font={tokens.__fontKey ?? "modern"}
  style={inlineStyle}
  data-primary={tokens["--site-color-primary"]}
  data-secondary={tokens["--site-color-secondary"]}
  data-accent={tokens["--site-color-accent"]}
>
  <slot />
</div>

<style>
  .site-theme-root {
    min-height: 100vh;
    background: var(--site-color-background, #fff);
    color: var(--site-color-text, #0f172a);
    font-family: var(--site-font-body, system-ui, sans-serif);
    font-weight: var(--site-font-body-weight, 400);
  }

  .site-theme-root :global(h1),
  .site-theme-root :global(h2),
  .site-theme-root :global(h3),
  .site-theme-root :global(h4) {
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-weight: var(--site-font-heading-weight, 700);
  }

  /* Cinematic profile owns editorial weight via --site-font-heading-weight. */
  .site-theme-root:has([data-f1-presentation="f1.presentation.cinematic_v1"]) :global(h1),
  .site-theme-root:has([data-f1-presentation="f1.presentation.cinematic_v1"]) :global(h2),
  .site-theme-root:has([data-f1-presentation="f1.presentation.cinematic_v1"]) :global(h3),
  .site-theme-root:has([data-f1-presentation="f1.presentation.cinematic_v1"]) :global(h4) {
    font-family: var(--site-font-editorial, var(--site-font-heading, Georgia, serif));
    font-weight: var(--site-font-heading-weight, 500);
  }
</style>
