---
import TrackedCTA from "./TrackedCTA.astro"
import WhatsAppIcon from "./icons/WhatsAppIcon.astro"

const { href } = Astro.props as { href: string }
---

{
  href && (
    <TrackedCTA
      href={href}
      label="Conversar pelo WhatsApp"
      class="whatsapp-float"
      ctaId="floating-whatsapp-cta"
      target="_blank"
      rel="noopener noreferrer"
      ariaLabel="Conversar pelo WhatsApp"
    >
      <span class="whatsapp-float__icon" aria-hidden="true">
        <WhatsAppIcon class="whatsapp-float__svg" tone="on-dark" />
      </span>
      <span class="visually-hidden">Conversar pelo WhatsApp</span>
    </TrackedCTA>
  )
}

<style>
  /* TrackedCTA is a child component — styles must be :global */
  :global(a.whatsapp-float) {
    position: fixed;
    z-index: 40;
    right: max(1rem, env(safe-area-inset-right, 0px));
    bottom: max(1rem, env(safe-area-inset-bottom, 0px));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.35rem;
    height: 3.35rem;
    border-radius: 999px;
    background: var(--site-color-primary, hsl(145 63% 42%));
    color: #ffffff;
    text-decoration: none;
    box-shadow:
      0 6px 18px rgba(15, 23, 42, 0.16),
      0 2px 6px rgba(15, 23, 42, 0.08);
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  :global(a.whatsapp-float:hover) {
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 88%, black);
    box-shadow:
      0 8px 22px rgba(15, 23, 42, 0.2),
      0 2px 8px rgba(15, 23, 42, 0.1);
  }

  :global(a.whatsapp-float:active) {
    transform: translateY(1px) scale(0.98);
  }

  :global(a.whatsapp-float:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 45%, white);
    outline-offset: 3px;
  }

  :global(.whatsapp-float__icon) {
    display: inline-flex;
    width: 1.45rem;
    height: 1.45rem;
    align-items: center;
    justify-content: center;
  }

  :global(.whatsapp-float__svg) {
    width: 1.45rem;
    height: 1.45rem;
  }

  :global(.visually-hidden) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 720px) {
    :global(a.whatsapp-float) {
      right: max(0.85rem, env(safe-area-inset-right, 0px));
      bottom: max(0.85rem, env(safe-area-inset-bottom, 0px));
      width: 3.15rem;
      height: 3.15rem;
    }
  }
</style>
