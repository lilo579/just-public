---
import LeadForm from "../LeadForm.astro";
import TrackedCTA from "../TrackedCTA.astro";
import WhatsAppIcon from "../icons/WhatsAppIcon.astro";
import CinematicSectionIcon from "../icons/CinematicSectionIcon.astro";

const { block, layout = "standard" } = Astro.props as {
  block: {
    type: "cta";
    content: {
      primaryCTA?: {
        href?: string;
        label: string;
        visible?: boolean;
        type?: string;
      } | null;
      title?: string | null;
      body?: string | null;
      buttonLabel?: string | null;
      microcopy?: string | null;
      closingPullQuote?: string | null;
    };
  };
  layout?: "standard" | "cinematic-band";
};

const { primaryCTA, title, body, buttonLabel, microcopy, closingPullQuote } = block.content;
const finalLabel = buttonLabel || primaryCTA?.label;
const showButton = primaryCTA?.visible !== false && primaryCTA?.href && finalLabel;
const isWhatsappCta =
  primaryCTA?.type === "whatsapp" || Boolean(primaryCTA?.href?.includes("wa.me"));
// DR-001: first official go-live is WhatsApp-only — no public LeadForm.
const showLeadForm = false;
const isCinematic = layout === "cinematic-band";
---

{(title || body || showButton || showLeadForm || (isCinematic && (microcopy || closingPullQuote))) && (
  <section class:list={["cta", isCinematic && "cta--cinematic"]} id={isCinematic ? "contato" : "cta-final"}>
    {isCinematic ? (
      <>
        <div class="cta__band-wrap">
          <div class="cta__band">
            <div class="cta__band-deco cta__band-deco--a" aria-hidden="true"></div>
            <div class="cta__band-deco cta__band-deco--b" aria-hidden="true"></div>

            <div class="cta__band-grid">
              {title && <p class="cta__band-title">{title}</p>}
              {body && <p class="cta__band-body">{body}</p>}

              <div class="cta__band-actions">
                {showButton && isWhatsappCta ? (
                  <TrackedCTA
                    href={primaryCTA!.href!}
                    label={finalLabel!}
                    class="cta__button cta__button--band"
                    ctaId="cta-final-primary-cta"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="cta__button-icon" aria-hidden="true">
                      <WhatsAppIcon class="cta__button-svg" />
                    </span>
                    <span>{finalLabel}</span>
                  </TrackedCTA>
                ) : showButton ? (
                  <a href={primaryCTA!.href} class="cta__button cta__button--band">
                    {finalLabel}
                  </a>
                ) : null}

                {microcopy && <p class="cta__microcopy">{microcopy}</p>}
              </div>
            </div>
          </div>
        </div>

        {closingPullQuote && (
          <div class="cta__closing">
            <p>
              <span class="cta__q" aria-hidden="true">“</span>
              {closingPullQuote}
              <span class="cta__q" aria-hidden="true">”</span>
            </p>
            <div class="cta__heart-divider" aria-hidden="true">
              <span></span>
              <CinematicSectionIcon name="heart" />
              <span></span>
            </div>
          </div>
        )}
      </>
    ) : (
      <div class="cta__inner">
        {title && <h2>{title}</h2>}
        {body && <p>{body}</p>}

        {showButton && isWhatsappCta ? (
          <TrackedCTA
            href={primaryCTA!.href!}
            label={finalLabel!}
            class="cta__button"
            ctaId="cta-final-primary-cta"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="cta__button-icon" aria-hidden="true">
              <WhatsAppIcon class="cta__button-svg" />
            </span>
            <span>{finalLabel}</span>
          </TrackedCTA>
        ) : showButton ? (
          <a href={primaryCTA!.href} class="cta__button">
            {finalLabel}
          </a>
        ) : null}

        {showLeadForm && <LeadForm sourceType="public_site_form" ctaId="cta-final-form" />}
      </div>
    )}
  </section>
)}

<style>
  .cta {
    padding: 48px 0 72px;
  }

  .cta__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .cta h2 {
    margin: 0;
    color: hsl(220 15% 15%);
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 700;
    text-wrap: balance;
  }

  .cta p {
    margin: 16px 0 0;
    color: #4b5563;
    font-size: 1.02rem;
    line-height: 1.72;
  }

  .cta :global(a.cta__button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 28px;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    border: none;
    background: var(--site-color-primary, hsl(145 63% 42%));
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
    min-height: 2.5rem;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .cta :global(a.cta__button:hover) {
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 88%, black);
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);
  }

  .cta :global(a.cta__button:active) {
    transform: translateY(1px);
  }

  .cta :global(a.cta__button:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 45%, white);
    outline-offset: 3px;
  }

  .cta :global(.cta__button-icon) {
    display: inline-flex;
    width: 1.05rem;
    height: 1.05rem;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex: 0 0 auto;
  }

  .cta :global(.cta__button-svg) {
    width: 1.05rem;
    height: 1.05rem;
    color: #ffffff;
  }

  @media (max-width: 720px) {
    .cta {
      padding: 32px 0 48px;
    }

    .cta__inner {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
  }

  /* —— cinematic-band —— */
  .cta--cinematic {
    padding: 0 0 4rem;
    background: #fbf8f4;
  }

  .cta--cinematic .cta__band-wrap {
    position: relative;
    left: 50%;
    z-index: 10;
    width: calc(100vw - 2.5rem);
    max-width: 1360px;
    transform: translateX(-50%);
  }

  .cta--cinematic .cta__band {
    position: relative;
    overflow: hidden;
    border-radius: 1.8rem;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 92%, transparent),
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 82%, transparent)
    );
    color: #fff;
    box-shadow: 0 34px 100px -62px color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 45%, transparent);
  }

  .cta--cinematic .cta__band-deco {
    pointer-events: none;
    position: absolute;
    border-radius: 999px;
    border: 1px solid hsl(0 0% 100% / 0.1);
  }

  .cta--cinematic .cta__band-deco--a {
    right: 2rem;
    top: 1.5rem;
    height: 7rem;
    width: 7rem;
  }

  .cta--cinematic .cta__band-deco--b {
    right: -2.5rem;
    bottom: -3.5rem;
    height: 11rem;
    width: 11rem;
  }

  .cta--cinematic .cta__band-grid {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: 1.5rem;
  }

  .cta--cinematic .cta__band-title {
    margin: 0;
    max-width: 39rem;
    font-family: var(--site-font-heading, Georgia, serif);
    font-size: 1.9rem;
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: #fff;
  }

  .cta--cinematic .cta__band-body {
    margin: 0;
    color: hsl(0 0% 100% / 0.76);
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .cta--cinematic .cta__band-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .cta--cinematic :global(a.cta__button--band) {
    margin-top: 0;
    width: auto;
    padding: 0.625rem 1.25rem;
    border: 1px solid hsl(0 0% 100% / 0.28);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.88) 100%);
    color: var(--site-color-primary, hsl(145 63% 42%));
    box-shadow: 0 10px 28px -18px rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(4px);
  }

  .cta--cinematic :global(a.cta__button--band:hover) {
    background: #fff;
    box-shadow: 0 10px 28px -18px rgba(255, 255, 255, 0.55);
  }

  .cta--cinematic :global(a.cta__button--band .cta__button-icon),
  .cta--cinematic :global(a.cta__button--band .cta__button-svg) {
    color: var(--site-color-primary, hsl(145 63% 42%));
  }

  .cta--cinematic .cta__microcopy {
    margin: 0;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: hsl(0 0% 100% / 0.7);
  }

  .cta--cinematic .cta__closing {
    margin: 5rem auto 0;
    max-width: 760px;
    padding: 0 1.5rem;
    text-align: center;
  }

  .cta--cinematic .cta__closing p {
    margin: 0;
    font-family: var(--site-font-heading, Georgia, serif);
    font-style: italic;
    font-size: 1.55rem;
    line-height: 1.45;
    letter-spacing: -0.018em;
    color: hsl(220 15% 15% / 0.82);
  }

  .cta--cinematic .cta__q {
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 34%, transparent);
  }

  .cta--cinematic .cta__heart-divider {
    margin-top: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 42%, transparent);
  }

  .cta--cinematic .cta__heart-divider span {
    height: 1px;
    width: 9rem;
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 20%, transparent);
  }

  .cta--cinematic .cta__heart-divider :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (min-width: 1024px) {
    .cta--cinematic {
      padding: 0.5rem 0 5rem;
    }

    .cta--cinematic .cta__band-wrap {
      width: calc(100vw - 4rem);
    }

    .cta--cinematic .cta__band-grid {
      grid-template-columns: 1.42fr 1.03fr 0.74fr;
      gap: 2rem;
      padding: 2.5rem 3rem;
    }

    .cta--cinematic .cta__band-title {
      font-size: 2.36rem;
    }

    .cta--cinematic .cta__band-body {
      border-left: 1px solid hsl(0 0% 100% / 0.24);
      padding-left: 2.5rem;
    }

    .cta--cinematic .cta__closing p {
      font-size: 1.8rem;
    }
  }
</style>
