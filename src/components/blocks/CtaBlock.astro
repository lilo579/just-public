---
import LeadForm from "../LeadForm.astro";
import TrackedCTA from "../TrackedCTA.astro";
import WhatsAppIcon from "../icons/WhatsAppIcon.astro";
import MessageCircleIcon from "../icons/MessageCircleIcon.astro";
import CinematicSectionIcon from "../icons/CinematicSectionIcon.astro";

const {
  block,
  layout = "standard",
  manifestoGhost = [],
  manifestoStatement = [],
  manifestoImageUrl = null,
  sectionId,
} = Astro.props as {
  block: {
    type: "cta";
    content: {
      primaryCTA?: {
        href?: string;
        label: string;
        visible?: boolean;
        type?: string;
      } | null;
      title?: string | null;
      body?: string | null;
      buttonLabel?: string | null;
      microcopy?: string | null;
      closingPullQuote?: string | null;
      manifestoGhost?: string[] | null;
      manifestoStatement?: string[] | null;
      manifestoImageUrl?: string | null;
    };
  };
  layout?: "standard" | "cinematic-band";
  manifestoGhost?: string[];
  manifestoStatement?: string[];
  manifestoImageUrl?: string | null;
  sectionId?: string;
};

const { primaryCTA, title, body, buttonLabel, microcopy, closingPullQuote } = block.content;
const finalLabel = buttonLabel || primaryCTA?.label;
const showButton = primaryCTA?.visible !== false && primaryCTA?.href && finalLabel;
const isWhatsappCta =
  primaryCTA?.type === "whatsapp" || Boolean(primaryCTA?.href?.includes("wa.me"));
const showLeadForm = false;
const isCinematic = layout === "cinematic-band";
const ghost =
  (Array.isArray(manifestoGhost) && manifestoGhost.length > 0
    ? manifestoGhost
    : Array.isArray(block.content.manifestoGhost)
      ? block.content.manifestoGhost
      : []) || [];
const statement =
  (Array.isArray(manifestoStatement) && manifestoStatement.length > 0
    ? manifestoStatement
    : Array.isArray(block.content.manifestoStatement)
      ? block.content.manifestoStatement
      : []) || [];
const isManifesto = ghost.length > 0 || statement.length > 0;
const resolvedSectionId = sectionId || (isCinematic ? (isManifesto ? "manifesto-final" : "contato") : "cta-final");
const resolvedManifestoImage =
  (typeof manifestoImageUrl === "string" && manifestoImageUrl.trim()) ||
  (typeof block.content.manifestoImageUrl === "string" && block.content.manifestoImageUrl.trim()) ||
  null;
---

{(title || body || showButton || showLeadForm || (isCinematic && (microcopy || closingPullQuote || isManifesto))) && (
  <section class:list={["cta", isCinematic && "cta--cinematic", isManifesto && "cta--manifesto"]} id={resolvedSectionId}>
    {isCinematic && isManifesto ? (
      <div class="cta__manifesto-art" data-f1-manifesto-art>
        <div class="cta__manifesto-glow" aria-hidden="true"></div>
        <div class="cta__manifesto-sheen" aria-hidden="true"></div>

        {ghost.length > 0 && (
          <p class="cta__ghost cta__ghost--desktop" aria-hidden="true">
            {ghost.map((line) => (
              <span class="cta__line">{line}</span>
            ))}
          </p>
        )}
        {ghost.length > 0 && (
          <p class="cta__ghost cta__ghost--mobile" aria-hidden="true">
            {ghost.map((line) => (
              <span class="cta__line">{line}</span>
            ))}
          </p>
        )}

        <div class="cta__manifesto-rule" aria-hidden="true"></div>

        {resolvedManifestoImage && (
          <div class="cta__manifesto-portrait">
            <img src={resolvedManifestoImage} alt="" loading="lazy" />
          </div>
        )}

        <div class="cta__manifesto-statement">
          {statement.length > 0 && (
            <p class="cta__statement">
              {statement.map((line) => (
                <span class="cta__line">{line}</span>
              ))}
            </p>
          )}

          {showButton && (
            <div class="cta__manifesto-cta">
              {isWhatsappCta ? (
                <TrackedCTA
                  href={primaryCTA!.href!}
                  label={finalLabel!}
                  class="cta__arrow-link"
                  ctaId="cta-final-primary-cta"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="cta__arrow" aria-hidden="true">
                    <span class="cta__arrow-rule"></span>
                    <span class="cta__arrow-glyph">→</span>
                  </span>
                  <span>{finalLabel}</span>
                </TrackedCTA>
              ) : (
                <a href={primaryCTA!.href} class="cta__arrow-link">
                  <span class="cta__arrow" aria-hidden="true">
                    <span class="cta__arrow-rule"></span>
                    <span class="cta__arrow-glyph">→</span>
                  </span>
                  <span>{finalLabel}</span>
                </a>
              )}
            </div>
          )}
        </div>
      </div>
    ) : isCinematic ? (
      <>
        <div class="cta__band-wrap">
          <div class="cta__band">
            <div class="cta__band-deco cta__band-deco--a" aria-hidden="true"></div>
            <div class="cta__band-deco cta__band-deco--b" aria-hidden="true"></div>

            <div class="cta__band-grid">
              {title && <p class="cta__band-title">{title}</p>}
              {body && <p class="cta__band-body">{body}</p>}

              <div class="cta__band-actions">
                {showButton && isWhatsappCta ? (
                  <TrackedCTA
                    href={primaryCTA!.href!}
                    label={finalLabel!}
                    class="cta__button cta__button--band f1-cta f1-cta--band"
                    ctaId="cta-final-primary-cta"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="f1-cta__icon cta__button-icon" aria-hidden="true">
                      <MessageCircleIcon />
                    </span>
                    <span>{finalLabel}</span>
                  </TrackedCTA>
                ) : showButton ? (
                  <a href={primaryCTA!.href} class="cta__button cta__button--band f1-cta f1-cta--band">
                    {finalLabel}
                  </a>
                ) : null}

                {microcopy && <p class="cta__microcopy">{microcopy}</p>}
              </div>
            </div>
          </div>
        </div>

        {closingPullQuote && (
          <div class="cta__closing">
            <p>
              <span class="cta__q" aria-hidden="true">“</span>
              {closingPullQuote}
              <span class="cta__q" aria-hidden="true">”</span>
            </p>
            <div class="cta__heart-divider" aria-hidden="true">
              <span></span>
              <CinematicSectionIcon name="heart" />
              <span></span>
            </div>
          </div>
        )}
      </>
    ) : (
      <div class="cta__inner">
        {title && <h2>{title}</h2>}
        {body && <p>{body}</p>}

        {showButton && isWhatsappCta ? (
          <TrackedCTA
            href={primaryCTA!.href!}
            label={finalLabel!}
            class="cta__button"
            ctaId="cta-final-primary-cta"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="cta__button-icon" aria-hidden="true">
              <WhatsAppIcon class="cta__button-svg" />
            </span>
            <span>{finalLabel}</span>
          </TrackedCTA>
        ) : showButton ? (
          <a href={primaryCTA!.href} class="cta__button">
            {finalLabel}
          </a>
        ) : null}

        {showLeadForm && <LeadForm sourceType="public_site_form" ctaId="cta-final-form" />}
      </div>
    )}
  </section>
)}

<style>
  .cta {
    padding: 48px 0 72px;
  }

  .cta__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .cta h2 {
    margin: 0;
    color: hsl(220 15% 15%);
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 700;
    text-wrap: balance;
  }

  .cta p {
    margin: 16px 0 0;
    color: #4b5563;
    font-size: 1.02rem;
    line-height: 1.72;
  }

  .cta :global(a.cta__button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 28px;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    border: none;
    background: var(--site-color-primary, hsl(145 63% 42%));
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
    min-height: 2.5rem;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .cta :global(a.cta__button:hover) {
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 88%, black);
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);
  }

  .cta :global(a.cta__button:active) {
    transform: translateY(1px);
  }

  .cta :global(a.cta__button:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 45%, white);
    outline-offset: 3px;
  }

  .cta :global(.cta__button-icon) {
    display: inline-flex;
    width: 1.05rem;
    height: 1.05rem;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex: 0 0 auto;
  }

  .cta :global(.cta__button-svg) {
    width: 1.05rem;
    height: 1.05rem;
    color: #ffffff;
  }

  @media (max-width: 720px) {
    .cta {
      padding: 32px 0 48px;
    }

    .cta__inner {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
  }

  /* —— cinematic-band —— */
  .cta--cinematic {
    padding: 0 0 4rem;
    background: #fbf8f4;
  }

  .cta--cinematic .cta__band-wrap {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1360px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
    box-sizing: border-box;
  }

  .cta--cinematic .cta__band {
    position: relative;
    overflow: hidden;
    border-radius: 1.8rem;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 92%, transparent),
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 82%, transparent)
    );
    color: #fff;
    box-shadow: 0 34px 100px -62px color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 45%, transparent);
  }

  .cta--cinematic .cta__band-deco {
    pointer-events: none;
    position: absolute;
    border-radius: 999px;
    border: 1px solid hsl(0 0% 100% / 0.1);
  }

  .cta--cinematic .cta__band-deco--a {
    right: 2rem;
    top: 1.5rem;
    height: 7rem;
    width: 7rem;
  }

  .cta--cinematic .cta__band-deco--b {
    right: -2.5rem;
    bottom: -3.5rem;
    height: 11rem;
    width: 11rem;
  }

  .cta--cinematic .cta__band-grid {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: 1.5rem;
  }

  .cta--cinematic .cta__band-title {
    margin: 0;
    max-width: 39rem;
    font-family: var(--site-font-heading, Georgia, serif);
    font-size: 1.9rem;
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: #fff;
  }

  .cta--cinematic .cta__band-body {
    margin: 0;
    color: hsl(0 0% 100% / 0.76);
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .cta--cinematic .cta__band-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .cta--cinematic :global(a.cta__button--band) {
    margin-top: 0;
    width: auto;
    padding: 0.625rem 1.25rem;
    border: 1px solid hsl(0 0% 100% / 0.28);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.88) 100%);
    color: var(--site-color-primary, hsl(145 63% 42%));
    box-shadow: 0 10px 28px -18px rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(4px);
  }

  .cta--cinematic :global(a.cta__button--band:hover) {
    background: #fff;
    box-shadow: 0 10px 28px -18px rgba(255, 255, 255, 0.55);
  }

  .cta--cinematic :global(a.cta__button--band .cta__button-icon),
  .cta--cinematic :global(a.cta__button--band .cta__button-svg) {
    color: var(--site-color-primary, hsl(145 63% 42%));
  }

  .cta--cinematic .cta__microcopy {
    margin: 0;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    color: hsl(0 0% 100% / 0.7);
  }

  .cta--cinematic .cta__closing {
    margin: 5rem auto 0;
    max-width: 760px;
    padding: 0 1.5rem;
    text-align: center;
  }

  .cta--cinematic .cta__closing p {
    margin: 0;
    font-family: var(--site-font-heading, Georgia, serif);
    font-style: italic;
    font-size: 1.55rem;
    line-height: 1.45;
    letter-spacing: -0.018em;
    color: hsl(220 15% 15% / 0.82);
  }

  .cta--cinematic .cta__q {
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 34%, transparent);
  }

  .cta--cinematic .cta__heart-divider {
    margin-top: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 42%, transparent);
  }

  .cta--cinematic .cta__heart-divider span {
    height: 1px;
    width: 9rem;
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 20%, transparent);
  }

  .cta--cinematic .cta__heart-divider :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .cta--manifesto {
    position: relative;
    left: 50%;
    right: 50%;
    width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 0;
    overflow: hidden;
    background: var(--f1-surface-deep, #0b1020);
    color: #fff;
  }

  .cta__manifesto-art {
    position: relative;
    height: 480px;
    width: 100%;
    overflow: hidden;
    background:
      radial-gradient(circle at center, #05070d 0%, #05070d 55%, #03050a 100%),
      linear-gradient(115deg, #05070d 0%, #060a14 28%, #081022 52%, #05070d 100%);
  }

  .cta__manifesto-glow {
    pointer-events: none;
    position: absolute;
    left: -8%;
    bottom: -12%;
    height: 240px;
    width: 240px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--site-color-primary, #dc2626) 26%, transparent);
    filter: blur(90px);
  }

  .cta__manifesto-sheen {
    pointer-events: none;
    position: absolute;
    right: 0;
    top: 0;
    height: 100%;
    width: 18%;
    background: linear-gradient(to left, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 28%, transparent 80%);
    mix-blend-mode: screen;
  }

  .cta--manifesto .cta__ghost {
    pointer-events: none;
    position: absolute;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.05em;
    color: rgba(255, 255, 255, 0.08);
  }

  .cta--manifesto .cta__ghost--desktop {
    display: none;
  }

  .cta--manifesto .cta__ghost--mobile {
    left: 6%;
    top: 6%;
    max-width: 46%;
    font-size: 2.05rem;
    line-height: 0.9;
    color: rgba(255, 255, 255, 0.05);
  }

  .cta--manifesto .cta__line {
    display: block;
  }

  .cta--manifesto .cta__manifesto-rule {
    pointer-events: none;
    position: absolute;
    left: 6%;
    top: 52%;
    height: 2px;
    width: 3rem;
    background: color-mix(in srgb, var(--site-color-primary, #dc2626) 80%, transparent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--site-color-primary, #dc2626) 25%, transparent);
  }

  .cta--manifesto .cta__manifesto-portrait {
    pointer-events: none;
    position: absolute;
    left: 50%;
    z-index: 1;
    bottom: 2%;
    width: 68%;
    transform: translateX(-50%);
  }

  .cta--manifesto .cta__manifesto-portrait img {
    display: block;
    width: 100%;
    object-fit: cover;
    filter: grayscale(1);
    opacity: 0.42;
    mix-blend-mode: screen;
    transform: scale(1.03);
    mask-image: linear-gradient(to bottom, black 0%, black 72%, rgba(0, 0, 0, 0.6) 85%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 72%, rgba(0, 0, 0, 0.6) 85%, transparent 100%);
  }

  .cta--manifesto .cta__manifesto-statement {
    position: absolute;
    inset-inline: 0;
    bottom: 8%;
    z-index: 3;
    padding: 0 1.5rem;
    text-align: center;
  }

  .cta--manifesto .cta__statement {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 2.15rem;
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.045em;
    color: rgba(255, 255, 255, 0.95);
  }

  .cta--manifesto .cta__manifesto-cta {
    margin-top: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cta--manifesto :global(a.cta__arrow-link) {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.78rem;
    font-weight: 500;
    min-height: auto;
    transition: color 0.3s ease;
  }

  .cta--manifesto :global(a.cta__arrow-link:hover) {
    color: #fff;
    background: transparent;
    box-shadow: none;
  }

  .cta--manifesto .cta__arrow {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .cta--manifesto .cta__arrow-rule {
    position: absolute;
    left: 0;
    height: 2px;
    width: 1.5rem;
    background: var(--site-color-primary, #dc2626);
    opacity: 0.8;
  }

  .cta--manifesto .cta__arrow-glyph {
    margin-left: 2rem;
    color: var(--site-color-primary, #dc2626);
    animation: ctaArrow 1.6s ease-in-out infinite;
  }

  @keyframes ctaArrow {
    0%,
    100% {
      transform: translateX(0);
      opacity: 0.75;
    }
    50% {
      transform: translateX(4px);
      opacity: 1;
    }
  }

  @media (min-width: 640px) {
    .cta--manifesto .cta__manifesto-portrait {
      bottom: 0;
      width: 60%;
    }
  }

  @media (min-width: 1024px) {
    .cta--cinematic {
      padding: 0.5rem 0 5rem;
    }

    .cta--manifesto {
      padding: 0;
    }

    .cta--manifesto .cta__manifesto-art {
      height: 620px;
    }

    .cta--manifesto .cta__manifesto-glow {
      left: 2%;
      bottom: -10%;
      height: 320px;
      width: 320px;
    }

    .cta--manifesto .cta__ghost--desktop {
      display: block;
      left: 4%;
      top: 8%;
      max-width: 30%;
      font-size: 4.7rem;
      color: rgba(255, 255, 255, 0.08);
    }

    .cta--manifesto .cta__ghost--mobile {
      display: none;
    }

    .cta--manifesto .cta__manifesto-rule {
      left: 4%;
      top: 58%;
      width: 4rem;
      background: color-mix(in srgb, var(--site-color-primary, #dc2626) 95%, transparent);
      box-shadow: 0 0 18px color-mix(in srgb, var(--site-color-primary, #dc2626) 38%, transparent);
    }

    .cta--manifesto .cta__manifesto-portrait {
      bottom: 0;
      width: 38%;
    }

    .cta--manifesto .cta__manifesto-statement {
      inset: auto;
      right: 6%;
      bottom: 15%;
      left: auto;
      max-width: 34%;
      padding: 0;
      text-align: right;
    }

    .cta--manifesto .cta__statement {
      font-size: 4.1rem;
      color: rgba(255, 255, 255, 0.95);
    }

    .cta--manifesto .cta__manifesto-cta {
      margin-top: 1.5rem;
      justify-content: flex-end;
      gap: 1.25rem;
    }

    .cta--manifesto :global(a.cta__arrow-link) {
      font-size: 0.98rem;
    }

    .cta--cinematic .cta__band-wrap {
      padding-left: 2rem;
      padding-right: 2rem;
    }

    .cta--cinematic .cta__band-grid {
      grid-template-columns: 1.42fr 1.03fr 0.74fr;
      gap: 2rem;
      padding: 2.5rem 3rem;
    }

    .cta--cinematic .cta__band-title {
      font-size: 2.36rem;
    }

    .cta--cinematic .cta__band-body {
      border-left: 1px solid hsl(0 0% 100% / 0.24);
      padding-left: 2.5rem;
    }

    .cta--cinematic .cta__closing p {
      font-size: 1.8rem;
    }
  }
</style>
