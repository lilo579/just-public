---
import LeadForm from "../LeadForm.astro";
import TrackedCTA from "../TrackedCTA.astro";
import WhatsAppIcon from "../icons/WhatsAppIcon.astro";

const { block } = Astro.props as {
  block: {
    type: "cta";
    content: {
      primaryCTA?: {
        href?: string;
        label: string;
        visible?: boolean;
        type?: string;
      } | null;
      title?: string | null;
      body?: string | null;
      buttonLabel?: string | null;
    };
  };
};

const { primaryCTA, title, body, buttonLabel } = block.content;
const finalLabel = buttonLabel || primaryCTA?.label;
const showButton = primaryCTA?.visible !== false && primaryCTA?.href && finalLabel;
const isWhatsappCta =
  primaryCTA?.type === "whatsapp" || Boolean(primaryCTA?.href?.includes("wa.me"));
// DR-001: first official go-live is WhatsApp-only — no public LeadForm.
const showLeadForm = false;
---

{(title || body || showButton || showLeadForm) && (
  <section class="cta" id="cta-final">
    <div class="cta__inner">
      {title && <h2>{title}</h2>}
      {body && <p>{body}</p>}

      {showButton && isWhatsappCta ? (
        <TrackedCTA
          href={primaryCTA!.href!}
          label={finalLabel!}
          class="cta__button"
          ctaId="cta-final-primary-cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="cta__button-icon" aria-hidden="true">
            <WhatsAppIcon class="cta__button-svg" />
          </span>
          <span>{finalLabel}</span>
        </TrackedCTA>
      ) : showButton ? (
        <a href={primaryCTA!.href} class="cta__button">
          {finalLabel}
        </a>
      ) : null}

      {showLeadForm && <LeadForm sourceType="public_site_form" ctaId="cta-final-form" />}
    </div>
  </section>
)}

<style>
  .cta {
    padding: 48px 0 72px;
  }

  .cta__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .cta h2 {
    margin: 0;
    color: hsl(220 15% 15%);
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 700;
    text-wrap: balance;
  }

  .cta p {
    margin: 16px 0 0;
    color: #4b5563;
    font-size: 1.02rem;
    line-height: 1.72;
  }

  .cta :global(a.cta__button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 28px;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    border: none;
    background: var(--site-color-primary, hsl(145 63% 42%));
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
    min-height: 2.5rem;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .cta :global(a.cta__button:hover) {
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 88%, black);
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);
  }

  .cta :global(a.cta__button:active) {
    transform: translateY(1px);
  }

  .cta :global(a.cta__button:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 45%, white);
    outline-offset: 3px;
  }

  .cta :global(.cta__button-icon) {
    display: inline-flex;
    width: 1.05rem;
    height: 1.05rem;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex: 0 0 auto;
  }

  .cta :global(.cta__button-svg) {
    width: 1.05rem;
    height: 1.05rem;
    color: #ffffff;
  }

  @media (max-width: 720px) {
    .cta {
      padding: 32px 0 48px;
    }

    .cta__inner {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
  }
</style>
