---
import LeadForm from "../LeadForm.astro";
import TrackedCTA from "../TrackedCTA.astro";

const { block } = Astro.props as {
  block: {
    type: "cta";
    content: {
      primaryCTA?: {
        href?: string;
        label: string;
        visible?: boolean;
        type?: string;
      } | null;
      title?: string | null;
      body?: string | null;
      buttonLabel?: string | null;
    };
  };
};

const { primaryCTA, title, body, buttonLabel } = block.content;
const finalLabel = buttonLabel || primaryCTA?.label;
const showButton = primaryCTA?.visible !== false && primaryCTA?.href && finalLabel;
// DR-001: first official go-live is WhatsApp-only — no public LeadForm.
const showLeadForm = false;
---

{(title || body || showButton || showLeadForm) && (
  <section class="cta" id="cta-final">
    <div class="cta__inner">
      {title && <h2>{title}</h2>}
      {body && <p>{body}</p>}

      {showButton && (primaryCTA?.type === "whatsapp" || primaryCTA?.href?.includes("wa.me")) ? (
        <TrackedCTA
          href={primaryCTA!.href!}
          label={finalLabel!}
          class="cta__button"
          ctaId="cta-final-primary-cta"
        />
      ) : showButton ? (
        <a href={primaryCTA!.href} class="cta__button">
          {finalLabel}
        </a>
      ) : null}

      {showLeadForm && <LeadForm sourceType="public_site_form" ctaId="cta-final-form" />}
    </div>
  </section>
)}

<style>
  .cta {
    padding: 48px 0 72px;
  }

  .cta__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .cta h2 {
    margin: 0;
    color: hsl(220 15% 15%);
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 700;
    text-wrap: balance;
  }

  .cta p {
    margin: 16px 0 0;
    color: #4b5563;
    font-size: 1.02rem;
    line-height: 1.72;
  }

  .cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
    padding: 16px 24px;
    border-radius: 999px;
    background: var(--site-color-primary, hsl(145 63% 42%));
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.08);
    min-height: 56px;
  }

  @media (max-width: 720px) {
    .cta {
      padding: 32px 0 48px;
    }

    .cta__inner {
      padding: 0 8px;
    }
  }
</style>
