---
import type { HeroBlock as HeroBlockType } from "../../contracts/homepage";
import TrackedCTA from "../TrackedCTA.astro";
import MessageCircleIcon from "../icons/MessageCircleIcon.astro";

const { block, layout = "standard" } = Astro.props as {
  block: HeroBlockType & {
    content: HeroBlockType["content"] & { imageUrl?: string | null };
  };
  layout?: "standard" | "cinematic";
};
const { title, subtitle, eyebrow, highlight, metrics = [] } = block.content;
const imageUrl =
  typeof (block.content as { imageUrl?: string }).imageUrl === "string"
    ? (block.content as { imageUrl?: string }).imageUrl
    : null;
const primaryCTA = block.primaryCTA;
const showPrimaryCTA =
  primaryCTA?.visible !== false && Boolean(primaryCTA?.href) && Boolean(primaryCTA?.label);
const visibleMetrics = (metrics ?? []).filter(
  (metric) => metric?.label || metric?.value || metric?.description
);
const hasCopy = Boolean(eyebrow || title || highlight || subtitle || showPrimaryCTA);
const isWhatsappCta =
  primaryCTA?.type === "whatsapp" || Boolean(primaryCTA?.href?.includes("wa.me"));
const isCinematic = layout === "cinematic";
const ctaClass = isCinematic ? "hero__cta f1-cta f1-cta--solid" : "hero__cta";
---

{(hasCopy || visibleMetrics.length > 0) && (
  <section class:list={["hero", isCinematic && "hero--cinematic"]}>
    {isCinematic && imageUrl && (
      <div class="hero__media" aria-hidden="true">
        <img src={imageUrl} alt="" class="hero__media-img" loading="eager" />
        <div class="hero__media-wash"></div>
        <div class="hero__media-vignette"></div>
      </div>
    )}

    <div class="hero__container">
      <div class:list={["hero__layout", visibleMetrics.length > 0 && !isCinematic && "hero__layout--split"]}>
        <div class="hero__content">
          {eyebrow && <span class="hero__eyebrow">{eyebrow}</span>}

          {title && <h1>{title}</h1>}

          {highlight && <p class="hero__highlight">{highlight}</p>}

          {subtitle && <p class="hero__subtitle">{subtitle}</p>}

          {showPrimaryCTA && isWhatsappCta ? (
            <TrackedCTA
              href={primaryCTA!.href!}
              label={primaryCTA!.label}
              class={ctaClass}
              ctaId="hero-primary-cta"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class:list={[isCinematic ? "f1-cta__icon" : "hero__cta-icon"]} aria-hidden="true">
                <MessageCircleIcon />
              </span>
              <span>{primaryCTA!.label}</span>
            </TrackedCTA>
          ) : showPrimaryCTA ? (
            <a href={primaryCTA!.href} class={ctaClass}>
              {primaryCTA!.label}
            </a>
          ) : null}
        </div>

        {!isCinematic && visibleMetrics.length > 0 && (
          <aside class="hero__metrics" aria-label="Metricas">
            {visibleMetrics.map((metric) => (
              <article class="hero__metric">
                {metric.value && <p class="hero__metric-value">{metric.value}</p>}
                {metric.label && <p class="hero__metric-label">{metric.label}</p>}
                {metric.description && (
                  <p class="hero__metric-description">{metric.description}</p>
                )}
              </article>
            ))}
          </aside>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .hero {
    position: relative;
    margin: 0;
    width: 100%;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 12%, transparent) 0%,
      var(--site-color-background, hsl(30 10% 97%)) 100%
    );
  }

  .hero--cinematic {
    background: #1a1512;
    color: #f5efe6;
    min-height: min(100svh, 920px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    border-radius: 0;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
  }

  .hero__media-wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(20, 14, 10, 0.88) 0%,
      rgba(20, 14, 10, 0.55) 32%,
      rgba(20, 14, 10, 0.18) 58%,
      transparent 78%,
      rgba(20, 14, 10, 0.35) 100%
    );
  }

  .hero__media-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(20, 14, 10, 0.72) 0%, transparent 42%),
      linear-gradient(to top, rgba(20, 14, 10, 0.55) 0%, transparent 38%),
      radial-gradient(circle at 72% 32%, rgba(255, 248, 235, 0.16) 0%, transparent 38%);
  }

  .hero__container {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 80px;
    padding-bottom: 80px;
    box-sizing: border-box;
  }

  .hero--cinematic .hero__container {
    padding-top: 6.5rem;
    padding-bottom: 5rem;
  }

  .hero__layout {
    display: grid;
    gap: 2rem;
  }

  .hero__layout--split {
    align-items: end;
  }

  .hero__content {
    max-width: 768px;
  }

  .hero--cinematic .hero__content {
    max-width: 660px;
  }

  .hero__eyebrow {
    display: block;
    margin-bottom: 12px;
    color: var(--site-color-primary, hsl(145 63% 42%));
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 12px;
    font-weight: 400;
  }

  .hero--cinematic .hero__eyebrow {
    color: rgba(243, 237, 227, 0.72);
    letter-spacing: 0.22em;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .hero h1 {
    margin: 0;
    color: hsl(220 15% 15%);
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: 48px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .hero--cinematic h1 {
    margin-top: 1.25rem;
    max-width: 11.5ch;
    color: #ffffff;
    font-family: var(--site-font-editorial, Georgia, serif);
    font-size: clamp(3.05rem, 6.2vw, 4.75rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.008em;
    text-wrap: balance;
    text-shadow: 0 6px 24px rgba(0, 0, 0, 0.24);
  }

  .hero__subtitle,
  .hero p {
    margin: 1rem 0 0;
    color: #4b5563;
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 42rem;
  }

  .hero--cinematic .hero__subtitle {
    margin-top: 1.5rem;
    max-width: 34ch;
    color: rgba(245, 239, 230, 0.82);
    font-size: clamp(1rem, 1.4vw, 1.05rem);
    line-height: 1.75;
    font-weight: 400;
  }

  .hero__highlight {
    margin-top: 0.75rem;
    color: var(--site-color-primary, hsl(145 63% 42%));
    font-weight: 600;
  }

  .hero :global(a.hero__cta) {
    margin-top: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3.1rem;
    padding: 0.85rem 1.75rem;
    border-radius: 999px;
    background: var(--site-color-primary, hsl(145 63% 42%));
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.96rem;
  }

  /* Defer to shared .f1-cta system — do not inflate height vs SPA (56px) */
  .hero--cinematic :global(a.hero__cta.f1-cta) {
    box-sizing: border-box;
    margin-top: 2.25rem;
    min-width: 15.5rem;
    height: var(--f1-btn-height-lg, 3.5rem);
    min-height: var(--f1-btn-height-lg, 3.5rem);
    padding: 0 2rem;
    gap: 0.5rem;
    font-weight: 500;
    font-size: 0.96rem;
  }

  .hero__cta-icon {
    display: inline-flex;
  }

  .hero__metrics {
    display: grid;
    gap: 1rem;
  }

  .hero__metric-value {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
  }

  .hero__metric-label,
  .hero__metric-description {
    margin: 0.25rem 0 0;
    color: #6b7280;
    font-size: 0.9rem;
  }

  @media (min-width: 1024px) {
    .hero__layout--split {
      grid-template-columns: 1.2fr 0.8fr;
    }

    .hero--cinematic .hero__container {
      padding-top: 8rem;
      padding-bottom: 6.5rem;
    }
  }
</style>
