---
import type { HeroBlock as HeroBlockType } from "../../contracts/homepage";
import TrackedCTA from "../TrackedCTA.astro";
import MessageCircleIcon from "../icons/MessageCircleIcon.astro";
import WhatsAppIcon from "../icons/WhatsAppIcon.astro";

const { block, layout = "standard", videoUrl = null, ctaIcon = "auto", omitPoster = false } = Astro.props as {
  block: HeroBlockType & {
    content: HeroBlockType["content"] & { imageUrl?: string | null; videoUrl?: string | null };
  };
  layout?: "standard" | "cinematic" | "catalog";
  videoUrl?: string | null;
  /** auto = MessageCircle on cinematic; none = label only (PT Golden Master). */
  ctaIcon?: "auto" | "none";
  /** When true, never paint a poster frame before the video (PT Golden Master). */
  omitPoster?: boolean;
};
const { title, subtitle, eyebrow, highlight, metrics = [] } = block.content;
const imageUrl =
  typeof (block.content as { imageUrl?: string }).imageUrl === "string"
    ? (block.content as { imageUrl?: string }).imageUrl
    : null;
const resolvedVideoUrl =
  (typeof videoUrl === "string" && videoUrl.trim()) ||
  (typeof (block.content as { videoUrl?: string }).videoUrl === "string"
    ? (block.content as { videoUrl?: string }).videoUrl
    : null);
const primaryCTA = block.primaryCTA;
const showPrimaryCTA =
  primaryCTA?.visible !== false && Boolean(primaryCTA?.href) && Boolean(primaryCTA?.label);
const visibleMetrics = (metrics ?? []).filter(
  (metric) => metric?.label || metric?.value || metric?.description
);
const hasCopy = Boolean(eyebrow || title || highlight || subtitle || showPrimaryCTA);
const isWhatsappCta =
  primaryCTA?.type === "whatsapp" || Boolean(primaryCTA?.href?.includes("wa.me"));
const isCinematic = layout === "cinematic";
const isCatalog = layout === "catalog";
const ctaClass = isCinematic
  ? "hero__cta f1-cta f1-cta--solid"
  : isCatalog
    ? "hero__cta"
    : "hero__cta";
const showCtaIcon = ctaIcon !== "none" && !isCatalog;
const showMedia = (isCinematic || isCatalog) && Boolean(resolvedVideoUrl || imageUrl);
---

{(hasCopy || visibleMetrics.length > 0) && (
  <section class:list={["hero", isCinematic && "hero--cinematic", isCatalog && "hero--catalog"]}>
    {showMedia && (
      <div class="hero__media" aria-hidden="true">
        {resolvedVideoUrl ? (
          <video
            src={resolvedVideoUrl}
            class="hero__media-img"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            poster={omitPoster ? undefined : imageUrl || undefined}
          />
        ) : (
          <img src={imageUrl!} alt="" class="hero__media-img" loading="eager" />
        )}
        <div class="hero__media-wash"></div>
        {isCinematic && <div class="hero__media-vignette"></div>}
      </div>
    )}

    <div class="hero__container">
      <div class:list={["hero__layout", visibleMetrics.length > 0 && !isCinematic && !isCatalog && "hero__layout--split"]}>
        <div class="hero__content">
          {eyebrow && <span class="hero__eyebrow">{eyebrow}</span>}

          {isCatalog && highlight && !eyebrow ? (
            <span class="hero__highlight">{highlight}</span>
          ) : null}

          {title && <h1>{title}</h1>}

          {!isCatalog && highlight && <p class="hero__highlight">{highlight}</p>}

          {subtitle && <p class="hero__subtitle">{subtitle}</p>}

          {showPrimaryCTA && isWhatsappCta ? (
            <TrackedCTA
              href={primaryCTA!.href!}
              label={primaryCTA!.label}
              class={ctaClass}
              ctaId="hero-primary-cta"
              target="_blank"
              rel="noopener noreferrer"
            >
              {showCtaIcon &&
                (isCinematic ? (
                  <span class="f1-cta__icon" aria-hidden="true">
                    <MessageCircleIcon />
                  </span>
                ) : (
                  <span class="hero__cta-icon" aria-hidden="true">
                    <WhatsAppIcon class="hero__cta-svg" />
                  </span>
                ))}
              <span>{primaryCTA!.label}</span>
            </TrackedCTA>
          ) : showPrimaryCTA ? (
            <a href={primaryCTA!.href} class={ctaClass}>
              {primaryCTA!.label}
            </a>
          ) : null}
        </div>

        {!isCinematic && visibleMetrics.length > 0 && (
          <aside class="hero__metrics" aria-label="Metricas">
            {visibleMetrics.map((metric) => (
              <article class="hero__metric">
                {metric.value && <p class="hero__metric-value">{metric.value}</p>}
                {metric.label && <p class="hero__metric-label">{metric.label}</p>}
                {metric.description && (
                  <p class="hero__metric-description">{metric.description}</p>
                )}
              </article>
            ))}
          </aside>
        )}
      </div>
    </div>
  </section>
)}

<style>
  /* —— classic / engine defaults (golden master) —— */
  .hero {
    position: relative;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 12%, transparent) 0%,
      var(--site-color-background, hsl(30 10% 97%)) 100%
    );
  }

  .hero__container {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 80px;
    padding-bottom: 80px;
    box-sizing: border-box;
  }

  .hero__layout {
    display: grid;
    gap: 2rem;
  }

  .hero__layout--split {
    align-items: end;
  }

  .hero__content {
    max-width: 768px;
  }

  .hero__eyebrow {
    display: block;
    margin-bottom: 12px;
    color: var(--site-color-primary, hsl(145 63% 42%));
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 12px;
    font-weight: 400;
  }

  .hero h1 {
    margin: 0;
    color: hsl(220 15% 15%);
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: 48px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: balance;
    white-space: pre-line;
  }

  .hero__subtitle,
  .hero p {
    margin: 24px 0 0;
    max-width: 672px;
    color: hsl(220 15% 15% / 0.72);
    font-size: 18px;
    line-height: 1.625;
  }

  .hero__highlight {
    margin-top: 16px !important;
    color: var(--site-color-primary, hsl(145 63% 42%)) !important;
    font-weight: 600;
    font-size: 1.125rem !important;
  }

  .hero :global(a.hero__cta) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 32px;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    border: none;
    background: var(--site-color-primary, hsl(145 63% 42%));
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
    min-height: 2.5rem;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .hero :global(a.hero__cta:hover) {
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 88%, black);
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);
  }

  .hero :global(a.hero__cta:active) {
    transform: translateY(1px);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.1);
  }

  .hero :global(a.hero__cta:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 45%, white);
    outline-offset: 3px;
  }

  .hero :global(.hero__cta-icon) {
    display: inline-flex;
    width: 1.05rem;
    height: 1.05rem;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex: 0 0 auto;
  }

  .hero :global(.hero__cta-svg) {
    width: 1.05rem;
    height: 1.05rem;
    color: #ffffff;
  }

  .hero__metrics {
    display: grid;
    gap: 0.85rem;
  }

  .hero__metric {
    padding: 1rem 1.1rem;
    border-radius: 1.25rem;
    border: 1px solid hsl(35 15% 86%);
    background: hsl(0 0% 100% / 0.85);
  }

  .hero__metric-value {
    margin: 0 !important;
    font-size: 1.5rem !important;
    font-weight: 700;
    color: hsl(220 15% 15%) !important;
  }

  .hero__metric-label {
    margin: 0.35rem 0 0 !important;
    font-size: 0.95rem !important;
    font-weight: 600;
    color: hsl(220 15% 25%) !important;
  }

  .hero__metric-description {
    margin: 0.25rem 0 0 !important;
    font-size: 0.9rem !important;
    color: hsl(220 10% 40%) !important;
  }

  @media (min-width: 640px) {
    .hero h1 {
      font-size: 60px;
    }

    .hero__subtitle,
    .hero p {
      font-size: 20px;
    }

    .hero__eyebrow {
      font-size: 14px;
    }
  }

  @media (min-width: 1024px) {
    .hero__container {
      padding-top: 128px;
      padding-bottom: 144px;
    }

    .hero__layout--split {
      grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    }

    .hero h1 {
      font-size: 72px;
    }

    .hero__subtitle,
    .hero p {
      color: hsl(220 15% 15% / 0.75);
    }

    .hero__eyebrow {
      letter-spacing: 0.025em;
      font-weight: 500;
    }
  }

  @media (max-width: 720px) {
    .hero__container {
      padding-left: 20px;
      padding-right: 20px;
      padding-top: 72px;
      padding-bottom: 56px;
    }

    .hero__content {
      max-width: 100%;
    }

    .hero h1 {
      font-size: 42px;
      line-height: 1.04;
      text-wrap: pretty;
    }

    .hero__subtitle,
    .hero p {
      margin-top: 20px;
      font-size: 17px;
      line-height: 1.65;
      max-width: 100%;
    }

    .hero :global(a.hero__cta) {
      margin-top: 28px;
      padding: 0.5rem 1.05rem;
      font-size: 0.92rem;
      min-height: 2.4rem;
    }
  }

  /* —— cinematic_v1 overrides (Celina / PT) —— */
  .hero--cinematic {
    margin: 0;
    width: 100%;
    max-width: 100%;
    background: #1a1512;
    color: #f5efe6;
    min-height: min(100svh, 920px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-radius: 0;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
    background: #0b1020;
  }

  .hero__media-wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(20, 14, 10, 0.88) 0%,
      rgba(20, 14, 10, 0.55) 32%,
      rgba(20, 14, 10, 0.18) 58%,
      transparent 78%,
      rgba(20, 14, 10, 0.35) 100%
    );
  }

  .hero__media-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(20, 14, 10, 0.72) 0%, transparent 42%),
      linear-gradient(to top, rgba(20, 14, 10, 0.55) 0%, transparent 38%),
      radial-gradient(circle at 72% 32%, rgba(255, 248, 235, 0.16) 0%, transparent 38%);
  }

  .hero--cinematic .hero__container {
    padding-top: 6.5rem;
    padding-bottom: 5rem;
  }

  .hero--cinematic .hero__content {
    max-width: 660px;
  }

  .hero--cinematic .hero__eyebrow {
    color: rgba(243, 237, 227, 0.72);
    letter-spacing: 0.22em;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .hero--cinematic h1 {
    margin-top: 1.25rem;
    max-width: 11.5ch;
    color: #ffffff;
    font-family: var(--site-font-editorial, Georgia, serif);
    font-size: clamp(3.05rem, 6.2vw, 4.75rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.008em;
    text-wrap: balance;
    white-space: normal;
    text-shadow: 0 6px 24px rgba(0, 0, 0, 0.24);
  }

  .hero--cinematic .hero__subtitle {
    margin-top: 1.5rem;
    max-width: 34ch;
    color: rgba(245, 239, 230, 0.82);
    font-size: clamp(1rem, 1.4vw, 1.05rem);
    line-height: 1.75;
    font-weight: 400;
  }

  .hero--cinematic :global(a.hero__cta.f1-cta) {
    box-sizing: border-box;
    margin-top: 2.25rem;
    min-width: 15.5rem;
    height: var(--f1-btn-height-lg, 3.5rem);
    min-height: var(--f1-btn-height-lg, 3.5rem);
    padding: 0 2rem;
    gap: 0.5rem;
    font-weight: 500;
    font-size: 0.96rem;
    box-shadow: none;
  }

  @media (min-width: 1024px) {
    .hero--cinematic .hero__container {
      padding-top: 8rem;
      padding-bottom: 6.5rem;
    }
  }
</style>
