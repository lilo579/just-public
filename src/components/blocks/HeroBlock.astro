---
import type { HeroBlock as HeroBlockType } from "../../contracts/homepage";
import TrackedCTA from "../TrackedCTA.astro";
import WhatsAppIcon from "../icons/WhatsAppIcon.astro";

const { block } = Astro.props as { block: HeroBlockType };
const { title, subtitle, eyebrow, highlight, metrics = [] } = block.content;
const primaryCTA = block.primaryCTA;
const showPrimaryCTA =
  primaryCTA?.visible !== false && Boolean(primaryCTA?.href) && Boolean(primaryCTA?.label);
const visibleMetrics = (metrics ?? []).filter(
  (metric) => metric?.label || metric?.value || metric?.description
);
const hasCopy = Boolean(eyebrow || title || highlight || subtitle || showPrimaryCTA);
const isWhatsappCta =
  primaryCTA?.type === "whatsapp" || Boolean(primaryCTA?.href?.includes("wa.me"));
---

{(hasCopy || visibleMetrics.length > 0) && (
  <section class="hero">
    <div class="hero__container">
      <div class:list={["hero__layout", visibleMetrics.length > 0 && "hero__layout--split"]}>
        <div class="hero__content">
          {eyebrow && <span class="hero__eyebrow">{eyebrow}</span>}

          {title && <h1>{title}</h1>}

          {highlight && <p class="hero__highlight">{highlight}</p>}

          {subtitle && <p>{subtitle}</p>}

          {showPrimaryCTA && isWhatsappCta ? (
            <TrackedCTA
              href={primaryCTA!.href!}
              label={primaryCTA!.label}
              class="hero__cta"
              ctaId="hero-primary-cta"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="hero__cta-icon" aria-hidden="true">
                <WhatsAppIcon class="hero__cta-svg" />
              </span>
              <span>{primaryCTA!.label}</span>
            </TrackedCTA>
          ) : showPrimaryCTA ? (
            <a href={primaryCTA!.href} class="hero__cta">
              {primaryCTA!.label}
            </a>
          ) : null}
        </div>

        {visibleMetrics.length > 0 && (
          <aside class="hero__metrics" aria-label="Metricas">
            {visibleMetrics.map((metric) => (
              <article class="hero__metric">
                {metric.value && <p class="hero__metric-value">{metric.value}</p>}
                {metric.label && <p class="hero__metric-label">{metric.label}</p>}
                {metric.description && (
                  <p class="hero__metric-description">{metric.description}</p>
                )}
              </article>
            ))}
          </aside>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .hero {
    position: relative;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 12%, transparent) 0%,
      var(--site-color-background, hsl(30 10% 97%)) 100%
    );
  }

  .hero__container {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 80px;
    padding-bottom: 80px;
  }

  .hero__layout {
    display: grid;
    gap: 2rem;
  }

  .hero__layout--split {
    align-items: end;
  }

  .hero__content {
    max-width: 768px;
  }

  .hero__eyebrow {
    display: block;
    margin-bottom: 12px;
    color: var(--site-color-primary, hsl(145 63% 42%));
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 12px;
    font-weight: 400;
  }

  .hero h1 {
    margin: 0;
    color: hsl(220 15% 15%);
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: 48px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: balance;
    white-space: pre-line;
  }

  .hero p {
    margin: 24px 0 0;
    max-width: 672px;
    color: hsl(220 15% 15% / 0.72);
    font-size: 18px;
    line-height: 1.625;
  }

  .hero__highlight {
    margin-top: 16px !important;
    color: var(--site-color-primary, hsl(145 63% 42%)) !important;
    font-weight: 600;
    font-size: 1.125rem !important;
  }

  .hero__cta {
    /* TrackedCTA is a child component — styles must be :global to apply */
  }

  .hero :global(a.hero__cta) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 32px;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    border: none;
    background: var(--site-color-primary, hsl(145 63% 42%));
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
    min-height: 2.5rem;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .hero :global(a.hero__cta:hover) {
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 88%, black);
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);
  }

  .hero :global(a.hero__cta:active) {
    transform: translateY(1px);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.1);
  }

  .hero :global(a.hero__cta:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 45%, white);
    outline-offset: 3px;
  }

  .hero :global(.hero__cta-icon) {
    display: inline-flex;
    width: 1.05rem;
    height: 1.05rem;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex: 0 0 auto;
  }

  .hero :global(.hero__cta-svg) {
    width: 1.05rem;
    height: 1.05rem;
    color: #ffffff;
  }

  .hero__metrics {
    display: grid;
    gap: 0.85rem;
  }

  .hero__metric {
    padding: 1rem 1.1rem;
    border-radius: 1.25rem;
    border: 1px solid hsl(35 15% 86%);
    background: hsl(0 0% 100% / 0.85);
  }

  .hero__metric-value {
    margin: 0 !important;
    font-size: 1.5rem !important;
    font-weight: 700;
    color: hsl(220 15% 15%) !important;
  }

  .hero__metric-label {
    margin: 0.35rem 0 0 !important;
    font-size: 0.95rem !important;
    font-weight: 600;
    color: hsl(220 15% 25%) !important;
  }

  .hero__metric-description {
    margin: 0.25rem 0 0 !important;
    font-size: 0.9rem !important;
    color: hsl(220 10% 40%) !important;
  }

  @media (min-width: 640px) {
    .hero h1 {
      font-size: 60px;
    }

    .hero p {
      font-size: 20px;
    }

    .hero__eyebrow {
      font-size: 14px;
    }
  }

  @media (min-width: 1024px) {
    .hero__container {
      padding-top: 128px;
      padding-bottom: 144px;
    }

    .hero__layout--split {
      grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    }

    .hero h1 {
      font-size: 72px;
    }

    .hero p {
      color: hsl(220 15% 15% / 0.75);
    }

    .hero__eyebrow {
      letter-spacing: 0.025em;
      font-weight: 500;
    }
  }

  @media (max-width: 720px) {
    .hero__container {
      padding-left: 20px;
      padding-right: 20px;
      padding-top: 72px;
      padding-bottom: 56px;
    }

    .hero__content {
      max-width: 100%;
    }

    .hero h1 {
      font-size: 42px;
      line-height: 1.04;
      text-wrap: pretty;
    }

    .hero p {
      margin-top: 20px;
      font-size: 17px;
      line-height: 1.65;
      max-width: 100%;
    }

    .hero :global(a.hero__cta) {
      margin-top: 28px;
      padding: 0.5rem 1.05rem;
      font-size: 0.92rem;
      min-height: 2.4rem;
    }
  }
</style>
