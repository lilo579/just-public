---
import type { HeroBlock as HeroBlockType } from "../../contracts/homepage";
import TrackedCTA from "../TrackedCTA.astro";
import MessageCircleIcon from "../icons/MessageCircleIcon.astro";
import WhatsAppIcon from "../icons/WhatsAppIcon.astro";

type HeroSlide = { imageUrl?: string; src?: string; alt?: string };

const { block, layout = "standard", videoUrl = null, ctaIcon = "auto", omitPoster = false } = Astro.props as {
  block: HeroBlockType & {
    content: HeroBlockType["content"] & {
      imageUrl?: string | null;
      videoUrl?: string | null;
      slides?: HeroSlide[] | null;
    };
  };
  layout?: "standard" | "cinematic" | "catalog" | "editorial-split";
  videoUrl?: string | null;
  /** auto = MessageCircle on cinematic; none = label only (PT Golden Master). */
  ctaIcon?: "auto" | "none";
  /** When true, never paint a poster frame before the video (PT Golden Master). */
  omitPoster?: boolean;
};
const { title, subtitle, eyebrow, highlight, metrics = [] } = block.content;
const imageUrl =
  typeof (block.content as { imageUrl?: string }).imageUrl === "string"
    ? (block.content as { imageUrl?: string }).imageUrl
    : null;
const resolvedVideoUrl =
  (typeof videoUrl === "string" && videoUrl.trim()) ||
  (typeof (block.content as { videoUrl?: string }).videoUrl === "string"
    ? (block.content as { videoUrl?: string }).videoUrl
    : null);
const rawSlides = Array.isArray((block.content as { slides?: HeroSlide[] }).slides)
  ? ((block.content as { slides?: HeroSlide[] }).slides as HeroSlide[])
  : [];
const slides = rawSlides
  .map((slide) => {
    const src =
      (typeof slide?.imageUrl === "string" && slide.imageUrl.trim()) ||
      (typeof slide?.src === "string" && slide.src.trim()) ||
      "";
    if (!src) return null;
    return {
      src,
      alt: typeof slide?.alt === "string" && slide.alt.trim() ? slide.alt.trim() : "",
    };
  })
  .filter(Boolean) as { src: string; alt: string }[];
const primaryCTA = block.primaryCTA;
const secondaryCTA = (block as { secondaryCTA?: typeof primaryCTA }).secondaryCTA;
const showPrimaryCTA =
  primaryCTA?.visible !== false && Boolean(primaryCTA?.href) && Boolean(primaryCTA?.label);
const showSecondaryCTA =
  secondaryCTA?.visible !== false &&
  Boolean(secondaryCTA?.href) &&
  Boolean(secondaryCTA?.label);
const visibleMetrics = (metrics ?? []).filter(
  (metric) => metric?.label || metric?.value || metric?.description
);
const hasCopy = Boolean(
  eyebrow || title || highlight || subtitle || showPrimaryCTA || showSecondaryCTA,
);
const isWhatsappCta =
  primaryCTA?.type === "whatsapp" || Boolean(primaryCTA?.href?.includes("wa.me"));
const isSecondaryWhatsapp =
  secondaryCTA?.type === "whatsapp" || Boolean(secondaryCTA?.href?.includes("wa.me"));
const isCinematic = layout === "cinematic";
const isCatalog = layout === "catalog";
const isEditorialSplit = layout === "editorial-split";
const secondaryCtaClass = isCinematic
  ? "hero__cta hero__cta--secondary f1-cta f1-cta--outline-on-dark"
  : isEditorialSplit
    ? "hero__cta hero__cta--secondary hero__cta--editorial-secondary"
    : "hero__cta hero__cta--secondary";
const ctaClass = isCinematic
  ? "hero__cta f1-cta f1-cta--solid"
  : isEditorialSplit
    ? "hero__cta hero__cta--editorial-primary"
    : "hero__cta";
const showCtaIcon = ctaIcon !== "none" && !isCatalog && !isEditorialSplit;
const showMedia =
  ((isCinematic || isCatalog) && Boolean(resolvedVideoUrl || imageUrl)) ||
  (isEditorialSplit && (slides.length > 0 || Boolean(imageUrl)));
const showCarousel = isEditorialSplit && slides.length > 0;
const showFramedImage = isEditorialSplit && !showCarousel && Boolean(imageUrl);
---

{(hasCopy || visibleMetrics.length > 0 || (isEditorialSplit && showMedia)) && (
  <section
    class:list={[
      "hero",
      isCinematic && "hero--cinematic",
      isCatalog && "hero--catalog",
      isEditorialSplit && "hero--editorial-split",
    ]}
  >
    {showMedia && !isEditorialSplit && (
      <div class="hero__media" aria-hidden="true">
        {resolvedVideoUrl ? (
          <video
            src={resolvedVideoUrl}
            class="hero__media-img"
            autoplay
            muted
            loop
            playsinline
            preload="auto"
            poster={omitPoster ? undefined : imageUrl || undefined}
          />
        ) : (
          <img src={imageUrl!} alt="" class="hero__media-img" loading="eager" />
        )}
        <div class="hero__media-wash"></div>
        {isCinematic && <div class="hero__media-vignette"></div>}
      </div>
    )}

    <div class="hero__container">
      <div
        class:list={[
          "hero__layout",
          visibleMetrics.length > 0 && !isCinematic && !isCatalog && !isEditorialSplit && "hero__layout--split",
          isEditorialSplit && "hero__layout--editorial",
        ]}
      >
        <div class="hero__content">
          {isEditorialSplit && eyebrow ? (
            <div class="hero__eyebrow-row">
              <span class="hero__gold-rule" aria-hidden="true" />
              <span class="hero__eyebrow">{eyebrow}</span>
            </div>
          ) : (
            eyebrow && <span class="hero__eyebrow">{eyebrow}</span>
          )}

          {isCatalog && highlight && !eyebrow ? (
            <span class="hero__highlight">{highlight}</span>
          ) : null}

          {title && <h1>{title}</h1>}

          {!isCatalog && highlight && <p class="hero__highlight">{highlight}</p>}

          {subtitle && <p class="hero__subtitle">{subtitle}</p>}

          {(showPrimaryCTA || showSecondaryCTA) && (
            <div class="hero__cta-row">
              {showPrimaryCTA && isWhatsappCta ? (
                <TrackedCTA
                  href={primaryCTA!.href!}
                  label={primaryCTA!.label}
                  class={ctaClass}
                  ctaId="hero-primary-cta"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {showCtaIcon &&
                    (isCinematic ? (
                      <span class="f1-cta__icon" aria-hidden="true">
                        <MessageCircleIcon />
                      </span>
                    ) : (
                      <span class="hero__cta-icon" aria-hidden="true">
                        <WhatsAppIcon class="hero__cta-svg" />
                      </span>
                    ))}
                  <span>{primaryCTA!.label}</span>
                </TrackedCTA>
              ) : showPrimaryCTA ? (
                <a href={primaryCTA!.href} class={ctaClass}>
                  {primaryCTA!.label}
                </a>
              ) : null}

              {showSecondaryCTA && isSecondaryWhatsapp ? (
                <TrackedCTA
                  href={secondaryCTA!.href!}
                  label={secondaryCTA!.label}
                  class={secondaryCtaClass}
                  ctaId="hero-secondary-cta"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span>{secondaryCTA!.label}</span>
                </TrackedCTA>
              ) : showSecondaryCTA ? (
                <a href={secondaryCTA!.href} class={secondaryCtaClass}>
                  {secondaryCTA!.label}
                </a>
              ) : null}
            </div>
          )}
        </div>

        {isEditorialSplit && showMedia && (
          <div class="hero__editorial-media">
            <div class="hero__editorial-frame" aria-hidden="true" />
            <div class="hero__editorial-accent" aria-hidden="true" />
            {showCarousel ? (
              <div
                class="hero__carousel"
                role="region"
                aria-roledescription="carousel"
                aria-label="Imagens do Hero"
                tabindex="0"
                data-hero-carousel
                data-autoplay-ms="3000"
              >
                <div class="hero__carousel-viewport">
                  <div class="hero__carousel-track" data-hero-carousel-track>
                    {slides.map((slide, index) => (
                      <div
                        class="hero__carousel-slide"
                        role="group"
                        aria-roledescription="slide"
                        aria-label={`${index + 1} of ${slides.length}`}
                        data-hero-slide
                        hidden={index !== 0}
                      >
                        <div class="hero__book-cover">
                          <img
                            src={slide.src}
                            alt={slide.alt}
                            loading={index === 0 ? "eager" : "lazy"}
                            decoding="async"
                            draggable="false"
                          />
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
                <button
                  type="button"
                  class="hero__carousel-btn hero__carousel-btn--prev"
                  aria-label="Previous slide"
                  data-hero-carousel-prev
                >
                  <span aria-hidden="true">‹</span>
                </button>
                <button
                  type="button"
                  class="hero__carousel-btn hero__carousel-btn--next"
                  aria-label="Next slide"
                  data-hero-carousel-next
                >
                  <span aria-hidden="true">›</span>
                </button>
              </div>
            ) : showFramedImage ? (
              <div class="hero__book-cover">
                <img src={imageUrl!} alt="" loading="eager" decoding="async" />
              </div>
            ) : null}
          </div>
        )}

        {!isCinematic && !isEditorialSplit && visibleMetrics.length > 0 && (
          <aside class="hero__metrics" aria-label="Metricas">
            {visibleMetrics.map((metric) => (
              <article class="hero__metric">
                {metric.value && <p class="hero__metric-value">{metric.value}</p>}
                {metric.label && <p class="hero__metric-label">{metric.label}</p>}
                {metric.description && (
                  <p class="hero__metric-description">{metric.description}</p>
                )}
              </article>
            ))}
          </aside>
        )}
      </div>
    </div>
  </section>
)}

{showCarousel && (
  <script>
    function initHeroCarousels() {
      const roots = document.querySelectorAll("[data-hero-carousel]");
      roots.forEach((root) => {
        if (!(root instanceof HTMLElement)) return;
        if (root.dataset.carouselReady === "1") return;
        root.dataset.carouselReady = "1";

        const slides = Array.from(root.querySelectorAll("[data-hero-slide]"));
        if (slides.length < 2) return;

        let index = 0;
        let timer = null;
        const autoplayMs = Number(root.dataset.autoplayMs || "3000");
        const reduced =
          typeof window.matchMedia === "function" &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        function show(next) {
          index = (next + slides.length) % slides.length;
          slides.forEach((slide, i) => {
            if (slide instanceof HTMLElement) slide.hidden = i !== index;
          });
        }

        function stop() {
          if (timer != null) {
            window.clearInterval(timer);
            timer = null;
          }
        }

        function start() {
          stop();
          if (reduced || autoplayMs <= 0) return;
          timer = window.setInterval(() => show(index + 1), autoplayMs);
        }

        const prev = root.querySelector("[data-hero-carousel-prev]");
        const next = root.querySelector("[data-hero-carousel-next]");
        prev?.addEventListener("click", () => {
          show(index - 1);
          start();
        });
        next?.addEventListener("click", () => {
          show(index + 1);
          start();
        });

        root.addEventListener("keydown", (event) => {
          if (!(event instanceof KeyboardEvent)) return;
          if (event.key === "ArrowLeft") {
            event.preventDefault();
            show(index - 1);
            start();
          } else if (event.key === "ArrowRight") {
            event.preventDefault();
            show(index + 1);
            start();
          }
        });

        show(0);
        start();
      });
    }

    initHeroCarousels();
    document.addEventListener("astro:page-load", initHeroCarousels);
  </script>
)}

<style>
  /* —— classic / engine defaults (golden master) —— */
  .hero {
    position: relative;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 12%, transparent) 0%,
      var(--site-color-background, hsl(30 10% 97%)) 100%
    );
  }

  .hero__container {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 80px;
    padding-bottom: 80px;
    box-sizing: border-box;
  }

  .hero__layout {
    display: grid;
    gap: 2rem;
  }

  .hero__layout--split {
    align-items: end;
  }

  .hero__content {
    max-width: 768px;
  }

  .hero__eyebrow {
    display: block;
    margin-bottom: 12px;
    color: var(--site-color-primary, hsl(145 63% 42%));
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 12px;
    font-weight: 400;
  }

  .hero h1 {
    margin: 0;
    color: hsl(220 15% 15%);
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: 48px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    text-wrap: balance;
    white-space: pre-line;
  }

  .hero__subtitle,
  .hero p {
    margin: 24px 0 0;
    max-width: 672px;
    color: hsl(220 15% 15% / 0.72);
    font-size: 18px;
    line-height: 1.625;
  }

  .hero__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 1.5rem;
    align-items: center;
  }

  .hero__cta-row .hero__cta {
    margin-top: 0;
  }

  .hero__cta--secondary {
    background: transparent;
    color: var(--site-color-primary, hsl(220 40% 22%));
    border: 1px solid color-mix(in srgb, var(--site-color-primary, hsl(220 40% 22%)) 45%, transparent);
    text-decoration: none;
    padding: 0.7rem 1.15rem;
    font-weight: 600;
  }

  /* Cinematic secondary: outline-on-dark without requiring F1 data-attr CSS. */
  .hero--cinematic .hero__cta--secondary.f1-cta--outline-on-dark {
    border: 1px solid rgba(255, 255, 255, 0.38);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: none;
  }

  .hero--cinematic .hero__cta--secondary.f1-cta--outline-on-dark:hover,
  .hero--cinematic .hero__cta--secondary.f1-cta--outline-on-dark:focus-visible {
    background: #fff;
    color: hsl(220 15% 15%);
    border-color: #fff;
    outline: none;
  }

  .hero__highlight {
    margin-top: 16px !important;
    color: var(--site-color-primary, hsl(145 63% 42%)) !important;
    font-weight: 600;
    font-size: 1.125rem !important;
  }

  .hero :global(a.hero__cta) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 32px;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    border: none;
    background: var(--site-color-primary, hsl(145 63% 42%));
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
    min-height: 2.5rem;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .hero :global(a.hero__cta:hover) {
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 88%, black);
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.12);
  }

  .hero :global(a.hero__cta:active) {
    transform: translateY(1px);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.1);
  }

  .hero :global(a.hero__cta:focus-visible) {
    outline: 3px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 45%, white);
    outline-offset: 3px;
  }

  .hero :global(.hero__cta-icon) {
    display: inline-flex;
    width: 1.05rem;
    height: 1.05rem;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex: 0 0 auto;
  }

  .hero :global(.hero__cta-svg) {
    width: 1.05rem;
    height: 1.05rem;
    color: #ffffff;
  }

  .hero__metrics {
    display: grid;
    gap: 0.85rem;
  }

  .hero__metric {
    padding: 1rem 1.1rem;
    border-radius: 1.25rem;
    border: 1px solid hsl(35 15% 86%);
    background: hsl(0 0% 100% / 0.85);
  }

  .hero__metric-value {
    margin: 0 !important;
    font-size: 1.5rem !important;
    font-weight: 700;
    color: hsl(220 15% 15%) !important;
  }

  .hero__metric-label {
    margin: 0.35rem 0 0 !important;
    font-size: 0.95rem !important;
    font-weight: 600;
    color: hsl(220 15% 25%) !important;
  }

  .hero__metric-description {
    margin: 0.25rem 0 0 !important;
    font-size: 0.9rem !important;
    color: hsl(220 10% 40%) !important;
  }

  @media (min-width: 640px) {
    .hero h1 {
      font-size: 60px;
    }

    .hero__subtitle,
    .hero p {
      font-size: 20px;
    }

    .hero__eyebrow {
      font-size: 14px;
    }
  }

  @media (min-width: 1024px) {
    .hero__container {
      padding-top: 128px;
      padding-bottom: 144px;
    }

    .hero__layout--split {
      grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    }

    .hero h1 {
      font-size: 72px;
    }

    .hero__subtitle,
    .hero p {
      color: hsl(220 15% 15% / 0.75);
    }

    .hero__eyebrow {
      letter-spacing: 0.025em;
      font-weight: 500;
    }
  }

  @media (max-width: 720px) {
    .hero__container {
      padding-left: 20px;
      padding-right: 20px;
      padding-top: 72px;
      padding-bottom: 56px;
    }

    .hero__content {
      max-width: 100%;
    }

    .hero h1 {
      font-size: 42px;
      line-height: 1.04;
      text-wrap: pretty;
    }

    .hero__subtitle,
    .hero p {
      margin-top: 20px;
      font-size: 17px;
      line-height: 1.65;
      max-width: 100%;
    }

    .hero :global(a.hero__cta) {
      margin-top: 28px;
      padding: 0.5rem 1.05rem;
      font-size: 0.92rem;
      min-height: 2.4rem;
    }
  }

  /* —— cinematic_v1 overrides (Celina / PT) —— */
  .hero--cinematic {
    margin: 0;
    width: 100%;
    max-width: 100%;
    background: #1a1512;
    color: #f5efe6;
    min-height: min(100svh, 920px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-radius: 0;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
    background: #0b1020;
  }

  .hero__media-wash {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(20, 14, 10, 0.88) 0%,
      rgba(20, 14, 10, 0.55) 32%,
      rgba(20, 14, 10, 0.18) 58%,
      transparent 78%,
      rgba(20, 14, 10, 0.35) 100%
    );
  }

  .hero__media-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(20, 14, 10, 0.72) 0%, transparent 42%),
      linear-gradient(to top, rgba(20, 14, 10, 0.55) 0%, transparent 38%),
      radial-gradient(circle at 72% 32%, rgba(255, 248, 235, 0.16) 0%, transparent 38%);
  }

  .hero--cinematic .hero__container {
    padding-top: 6.5rem;
    padding-bottom: 5rem;
  }

  .hero--cinematic .hero__content {
    max-width: 660px;
  }

  .hero--cinematic .hero__eyebrow {
    color: rgba(243, 237, 227, 0.72);
    letter-spacing: 0.22em;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .hero--cinematic h1 {
    margin-top: 1.25rem;
    max-width: 11.5ch;
    color: #ffffff;
    font-family: var(--site-font-editorial, Georgia, serif);
    font-size: clamp(3.05rem, 6.2vw, 4.75rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.008em;
    text-wrap: balance;
    white-space: normal;
    text-shadow: 0 6px 24px rgba(0, 0, 0, 0.24);
  }

  .hero--cinematic .hero__subtitle {
    margin-top: 1.5rem;
    max-width: 34ch;
    color: rgba(245, 239, 230, 0.82);
    font-size: clamp(1rem, 1.4vw, 1.05rem);
    line-height: 1.75;
    font-weight: 400;
  }

  .hero--cinematic :global(a.hero__cta.f1-cta) {
    box-sizing: border-box;
    margin-top: 2.25rem;
    min-width: 15.5rem;
    height: var(--f1-btn-height-lg, 3.5rem);
    min-height: var(--f1-btn-height-lg, 3.5rem);
    padding: 0 2rem;
    gap: 0.5rem;
    font-weight: 500;
    font-size: 0.96rem;
    box-shadow: none;
  }

  @media (min-width: 1024px) {
    .hero--cinematic .hero__container {
      padding-top: 8rem;
      padding-bottom: 6.5rem;
    }
  }

  /* —— F4 mission editorial-split —— */
  .hero--editorial-split {
    background: var(--site-color-background, hsl(40 20% 97%));
    overflow: hidden;
  }

  .hero--editorial-split .hero__container {
    max-width: 76rem;
    padding-top: 7rem;
    padding-bottom: 5rem;
  }

  .hero__layout--editorial {
    align-items: center;
    gap: 3.5rem;
  }

  .hero--editorial-split .hero__content {
    max-width: none;
  }

  .hero__eyebrow-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0;
  }

  .hero__gold-rule {
    display: inline-block;
    width: 2.75rem;
    height: 1px;
    background: var(--site-color-accent, hsl(40 45% 55%));
    flex-shrink: 0;
  }

  .hero--editorial-split .hero__eyebrow {
    margin: 0;
    color: color-mix(in srgb, var(--site-color-accent, hsl(40 45% 45%)) 70%, var(--site-color-primary, hsl(220 30% 20%)));
    letter-spacing: 0.24em;
    font-size: 0.6875rem;
    font-weight: 500;
  }

  .hero--editorial-split h1 {
    margin-top: 2.5rem;
    color: var(--site-color-primary, hsl(220 40% 16%));
    font-family: var(--site-font-heading, Georgia, serif);
    font-size: clamp(2.75rem, 5.5vw, 4.5rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    white-space: normal;
  }

  .hero--editorial-split .hero__subtitle {
    margin-top: 2.25rem;
    max-width: 36rem;
    color: var(--site-color-text-muted, hsl(220 10% 40%));
    font-size: clamp(1.0625rem, 1.4vw, 1.125rem);
    line-height: 1.85;
  }

  .hero--editorial-split .hero__cta-row {
    margin-top: 3rem;
    gap: 1rem;
