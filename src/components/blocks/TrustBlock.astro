---
import type { TrustBlock as TrustBlockType } from "../../contracts/homepage"

const { block } = Astro.props as { block: TrustBlockType }
const { title, items, logos, hasContent } = block.content
const visibleItems = (items ?? []).filter(Boolean)
const visibleLogos = (logos ?? []).filter((logo) => logo?.imageUrl || logo?.name)
const showSection = hasContent && (visibleItems.length > 0 || visibleLogos.length > 0 || Boolean(title))
---

{showSection && (
  <section class="trust">
    <div class="trust__container">
      {title && <h2 class="trust__title">{title}</h2>}

      {visibleItems.length > 0 && (
        <ul class="trust__list">
          {visibleItems.map((item, index) => (
            <li class:list={["trust__item", visibleItems.length === 3 && index === 2 ? "trust__item--full" : ""]}>
              <span class="trust__icon" aria-hidden="true">✓</span>
              <span class="trust__text">{item}</span>
            </li>
          ))}
        </ul>
      )}

      {visibleLogos.length > 0 && (
        <ul class="trust__logos" aria-label="Logos de confianca">
          {visibleLogos.map((logo) => (
            <li class="trust__logo">
              {logo.imageUrl ? (
                <img src={logo.imageUrl} alt={logo.alt || logo.name || "Logo"} loading="lazy" />
              ) : (
                <span class="trust__logo-name">{logo.name}</span>
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}

<style>
  .trust {
    position: relative;
    z-index: 10;
    margin-top: -1.5rem;
    padding: 0 0 1.5rem;
  }

  .trust__container {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    display: grid;
    gap: 1rem;
  }

  .trust__title {
    margin: 0;
    text-align: center;
    color: hsl(220 15% 20%);
    font-size: 1rem;
    font-weight: 600;
  }

  .trust__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust__item {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.85rem 0.95rem;
    border: 1px solid hsl(30 8% 88%);
    border-radius: 1rem;
    background: hsl(0 0% 100% / 0.88);
    box-shadow:
      0 1px 3px 0 hsl(220 15% 15% / 0.04),
      0 4px 16px -4px hsl(220 15% 15% / 0.06);
    box-sizing: border-box;
  }

  .trust__item--full {
    grid-column: 1 / -1;
  }

  .trust__icon {
    flex: 0 0 auto;
    width: 1.1rem;
    height: 1.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid hsl(145 12% 55% / 0.45);
    color: hsl(145 12% 55%);
    font-size: 0.78rem;
    line-height: 1;
    font-weight: 700;
    box-sizing: border-box;
  }

  .trust__text {
    min-width: 0;
    color: hsl(220 15% 15% / 0.82);
    font-size: 0.9rem;
    line-height: 1.25;
    font-weight: 500;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  .trust__logos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust__logo {
    min-height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1rem;
    border: 1px dashed hsl(30 8% 82%);
    border-radius: 1rem;
    background: hsl(0 0% 100% / 0.7);
  }

  .trust__logo img {
    max-height: 2.5rem;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .trust__logo-name {
    color: hsl(220 10% 35%);
    font-size: 0.9rem;
    text-align: center;
  }

  @media (min-width: 1024px) {
    .trust {
      margin-top: -2rem;
      padding: 0 0 1rem;
    }

    .trust__list {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }

    .trust__item,
    .trust__item--full {
      grid-column: auto;
      width: auto;
      max-width: none;
      border-radius: 999px;
      padding: 0.65rem 1rem;
    }

    .trust__icon {
      width: 1rem;
      height: 1rem;
      font-size: 0.72rem;
    }

    .trust__text {
      font-size: 0.875rem;
      line-height: 1.2;
      white-space: nowrap;
      overflow-wrap: normal;
    }

    .trust__logos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
