---
import type { HomepageBlock } from "../../contracts/homepage";

const { block } = Astro.props as {
  block: HomepageBlock & {
    type: "rich_text";
    content: {
      title?: string;
      paragraphs?: string[];
    };
  };
};

const { title, paragraphs = [] } = block.content;
const visibleParagraphs = paragraphs.filter(Boolean);
---

{(title || visibleParagraphs.length > 0) && (
  <section class="rich-text">
    <div class="rich-text__inner">
      {title && <h2>{title}</h2>}

      {visibleParagraphs.length > 0 && (
        <div class="rich-text__body">
          {visibleParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
    </div>
  </section>
)}

<style>
  .rich-text {
    padding: 32px 0 40px;
  }

  .rich-text__inner {
    max-width: 760px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .rich-text h2 {
    margin: 0 0 20px;
    color: hsl(220 15% 15%);
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 700;
    text-align: left;
    text-wrap: balance;
  }

  .rich-text__body {
    display: grid;
    gap: 18px;
  }

  .rich-text p {
    margin: 0;
    color: #4b5563;
    font-size: 1.05rem;
    line-height: 1.78;
    text-align: left;
  }

  @media (min-width: 1024px) {
    .rich-text {
      padding: 40px 0 56px;
    }

    .rich-text h2 {
      text-align: center;
    }

    .rich-text__body {
      gap: 22px;
    }

    .rich-text p {
      text-align: center;
      font-size: 1.08rem;
    }
  }

  @media (max-width: 720px) {
    .rich-text {
      padding: 24px 0 28px;
    }

    .rich-text__inner {
      max-width: 100%;
      padding-left: 21px;
      padding-right: 21px;
    }

    .rich-text h2 {
      margin: 0 0 18px;
      font-size: 1.72rem;
      line-height: 1.12;
      text-align: left;
      text-wrap: pretty;
    }

    .rich-text__body {
      gap: 18px;
    }

    .rich-text p {
      font-size: 0.98rem;
      line-height: 1.72;
      text-align: left;
      text-wrap: pretty;
    }
  }
</style>