---
/** Bind-only F3 category navigation (paint.category_nav). */
const { block } = Astro.props as {
  block: { type: string; content: Record<string, unknown> };
};
const categories = Array.isArray(block.content.categories)
  ? (block.content.categories as Array<{ label?: string | null }>)
  : [];
---
<section class="catalog-category-nav" aria-label="Categories">
  <ul>
    {categories.map((category) => (
      <li>{category.label ?? ""}</li>
    ))}
  </ul>
</section>
