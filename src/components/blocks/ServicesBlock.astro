---
import type { ServicesBlock as ServicesBlockType } from "../../contracts/homepage";

const { block, layout = "list" } = Astro.props as {
  block: ServicesBlockType
  /** engine-list | classic-split (F1 classic editorial) | cards (legacy classic mistake — avoid) */
  layout?: "list" | "classic-split" | "cards"
};
const { kicker, title, items } = block.content;

const visibleItems = (items ?? []).filter(
  (item) => item?.title && item?.description
);

const leftItems = visibleItems.slice(0, 2);
const rightItems = visibleItems.slice(2);
const isClassicSplit = layout === "classic-split";
const isCards = layout === "cards";
---

{visibleItems.length > 0 && (
  <section
    class:list={["services", isCards && "services--cards", isClassicSplit && "services--classic-split"]}
    data-layout={layout}
  >
    <div class="services__container">
      {(kicker || title) && (
        <div class:list={["services__heading", isClassicSplit && "services__heading--center"]}>
          {kicker && <p class="services__kicker">{kicker}</p>}
          {title && <h2>{title}</h2>}
        </div>
      )}

      {isClassicSplit ? (
        <div class="services__classic">
          <div class="services__classic-col services__classic-col--primary">
            {leftItems.map((item) => (
              <article class="services__classic-item">
                <div class="services__classic-row">
                  <div class="services__classic-marker" aria-hidden="true">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M5 12.5 10 17.5 19 7.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>
                  <div class="services__classic-copy">
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </div>
                </div>
              </article>
            ))}
            {rightItems.map((item) => (
              <article class="services__classic-item services__classic-item--mobile">
                <div class="services__classic-row">
                  <div class="services__classic-marker" aria-hidden="true">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M5 12.5 10 17.5 19 7.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>
                  <div class="services__classic-copy">
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>

          {rightItems.length > 0 && (
            <div class="services__classic-col services__classic-col--secondary">
              {rightItems.map((item) => (
                <article class="services__classic-item">
                  <div class="services__classic-row">
                    <div class="services__classic-marker" aria-hidden="true">
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path
                          d="M5 12.5 10 17.5 19 7.5"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </div>
                    <div class="services__classic-copy">
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          )}
        </div>
      ) : isCards ? (
        <div class="services__cards">
          {visibleItems.map((item) => (
            <article class="services__card">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      ) : (
      <div class="services__grid">
        <div class="services__column services__column--left">
          {leftItems.map((item) => (
            <article class="services__item">
              <div class="services__icon">
                <span class="services__dot"></span>
              </div>

              <div class="services__content">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </article>
          ))}

          {rightItems.map((item) => (
            <article class="services__item services__item--mobile">
              <div class="services__icon">
                <span class="services__dot"></span>
              </div>

              <div class="services__content">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>

        {rightItems.length > 0 && (
          <div class="services__column services__column--right">
            {rightItems.map((item) => (
              <article class="services__item">
                <div class="services__icon">
                  <span class="services__dot"></span>
                </div>

                <div class="services__content">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
      )}
    </div>
  </section>
)}

<style>
  .services {
    padding: 4rem 0;
  }

  .services__container {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .services__heading {
    max-width: 48rem;
    margin: 0 auto 3rem;
    text-align: left;
  }

  .services__kicker {
    margin: 0 0 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--site-color-primary, hsl(145 40% 35%));
  }

  .services h2 {
    margin: 0;
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: 1.875rem;
    line-height: 1.15;
    font-weight: 700;
    color: hsl(220 15% 15%);
  }

  .services__grid {
    display: block;
    max-width: 80rem;
    margin: 0 auto;
  }

  .services__column {
    display: grid;
    gap: 2rem;
  }

  .services__column--right {
    display: none;
  }

  .services__item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .services__icon {
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.125rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 12%, white);
    border: 1px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 20%, transparent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .services__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--site-color-accent, hsl(145 12% 55%));
    display: block;
  }

  .services__content h3 {
    margin: 0 0 0.5rem;
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: 1.125rem;
    line-height: 1.35;
    font-weight: 600;
    color: hsl(220 15% 15%);
  }

  .services__content p {
    margin: 0;
    color: hsl(220 15% 15% / 0.7);
    font-size: 1rem;
    line-height: 1.7;
  }

  .services__item--mobile {
    display: flex;
  }

  @media (min-width: 1024px) {
  .services {
    padding: 6rem 0;
  }

  .services__heading {
    text-align: center;
    margin-bottom: 4rem;
  }

  .services h2 {
    font-size: 2.25rem;
  }

  .services__grid {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: start;
    max-width: 68rem; /* ← diminui largura total */
    margin: 0 auto;
  }

  .services__column {
    display: grid;
    gap: 2.5rem;
  }

  .services__column--left {
    padding-right: 1rem;
  }

  .services__column--right {
    display: grid !important;
    gap: 2.5rem;
    padding-top: 4rem;
    padding-left: 1rem;
  }

  .services__item--mobile {
    display: none !important;
  }
}

  .services--cards .services__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 68rem;
    margin: 0 auto;
  }

  .services--cards .services__card {
    margin: 0;
    padding: 1.5rem 1.35rem;
    border-radius: var(--site-radius-card, 0.75rem);
    border: 1px solid var(--site-color-card-border, hsl(30 8% 88%));
    background: var(--site-color-card, #fff);
    box-shadow: var(--site-shadow, none);
  }

  .services--cards .services__card h3 {
    margin: 0 0 0.65rem;
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: 1.125rem;
    line-height: 1.35;
    font-weight: 600;
    color: hsl(220 15% 15%);
  }

  .services--cards .services__card p {
    margin: 0;
    color: hsl(220 15% 15% / 0.7);
    font-size: 1rem;
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    .services--cards .services__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .services--cards .services__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .services--classic-split {
    padding: 4rem 0;
  }

  .services--classic-split .services__heading--center {
    text-align: center;
    max-width: 48rem;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 3rem;
  }

  .services__classic {
    max-width: 64rem;
    margin: 0 auto;
  }

  .services__classic-col {
    display: grid;
    gap: 2rem;
  }

  .services__classic-col--secondary {
    display: none;
  }

  .services__classic-item--mobile {
    display: block;
  }

  .services__classic-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .services__classic-marker {
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.125rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 22%, transparent);
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 8%, white);
    color: var(--site-color-primary, hsl(145 63% 42%));
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .services__classic-marker svg {
    width: 0.95rem;
    height: 0.95rem;
    display: block;
  }

  .services__classic-copy h3 {
    margin: 0 0 0.5rem;
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: 1.125rem;
    line-height: 1.35;
    font-weight: 600;
    color: hsl(220 15% 15%);
  }

  .services__classic-copy p {
    margin: 0;
    color: hsl(220 15% 15% / 0.7);
    font-size: 1rem;
    line-height: 1.7;
  }

  @media (min-width: 1024px) {
    .services--classic-split {
      padding: 6rem 0;
    }

    .services__classic {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }

    .services__classic-col {
      gap: 2.5rem;
    }

    .services__classic-col--secondary {
      display: grid;
      padding-top: 4rem;
    }

    .services__classic-item--mobile {
      display: none;
    }
  }
</style>
