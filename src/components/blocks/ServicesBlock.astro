---
import type { ServicesBlock as ServicesBlockType } from "../../contracts/homepage";
import CinematicSectionIcon from "../icons/CinematicSectionIcon.astro";

type ServiceIcon =
  | "brain"
  | "book"
  | "clock"
  | "shield"
  | "heart"
  | "users";

const { block, layout = "list", sectionId } = Astro.props as {
  block: ServicesBlockType & {
    content: ServicesBlockType["content"] & {
      body?: string | null;
    };
  };
  /** engine-list | classic-split | cards | cinematic-signs */
  layout?: "list" | "classic-split" | "cards" | "cinematic-signs";
  sectionId?: string;
};

const { kicker, title, items } = block.content;
const body =
  typeof (block.content as { body?: string }).body === "string"
    ? (block.content as { body?: string }).body
    : null;

const visibleItems = (items ?? []).filter(
  (item) => item?.title && item?.description
);

const leftItems = visibleItems.slice(0, 2);
const rightItems = visibleItems.slice(2);
const isClassicSplit = layout === "classic-split";
const isCards = layout === "cards";
const isCinematic = layout === "cinematic-signs";

const serviceIcons: ServiceIcon[] = [
  "brain",
  "book",
  "clock",
  "shield",
  "heart",
  "users",
];
---

{visibleItems.length > 0 && (
  <section
    class:list={[
      "services",
      isCards && "services--cards",
      isClassicSplit && "services--classic-split",
      isCinematic && "services--cinematic",
    ]}
    data-layout={layout}
    id={isCinematic ? sectionId : undefined}
  >
    {isCinematic && (
      <>
        <div class="services__glow" aria-hidden="true"></div>
        <div class="services__ring" aria-hidden="true"></div>
      </>
    )}

    <div class="services__container">
      {isCinematic ? (
        <>
          {(kicker || title || body) && (
            <div class="services__split-heading">
              <div class="services__split-lead">
                {kicker && <p class="services__kicker">{kicker}</p>}
                {title && <h2>{title}</h2>}
              </div>
              {body && <p class="services__support">{body}</p>}
            </div>
          )}

          <div class="services__signs">
            {visibleItems.map((item, index) => (
              <article
                class:list={[
                  "services__sign",
                  index % 2 === 1 && "services__sign--stagger",
                ]}
              >
                <div class="services__sign-row">
                  <div class="services__sign-icon" aria-hidden="true">
                    <CinematicSectionIcon name={serviceIcons[index % serviceIcons.length]} />
                  </div>
                  <div class="services__sign-copy">
                    <h3>{item.title}</h3>
                    <p>{item.description}</p>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </>
      ) : (
        <>
          {(kicker || title) && (
            <div class:list={["services__heading", isClassicSplit && "services__heading--center"]}>
              {kicker && <p class="services__kicker">{kicker}</p>}
              {title && <h2>{title}</h2>}
            </div>
          )}

          {isClassicSplit ? (
            <div class="services__classic">
              <div class="services__classic-col services__classic-col--primary">
                {leftItems.map((item) => (
                  <article class="services__classic-item">
                    <div class="services__classic-row">
                      <div class="services__classic-marker" aria-hidden="true">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            d="M5 12.5 10 17.5 19 7.5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </div>
                      <div class="services__classic-copy">
                        <h3>{item.title}</h3>
                        <p>{item.description}</p>
                      </div>
                    </div>
                  </article>
                ))}
                {rightItems.map((item) => (
                  <article class="services__classic-item services__classic-item--mobile">
                    <div class="services__classic-row">
                      <div class="services__classic-marker" aria-hidden="true">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            d="M5 12.5 10 17.5 19 7.5"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </div>
                      <div class="services__classic-copy">
                        <h3>{item.title}</h3>
                        <p>{item.description}</p>
                      </div>
                    </div>
                  </article>
                ))}
              </div>

              {rightItems.length > 0 && (
                <div class="services__classic-col services__classic-col--secondary">
                  {rightItems.map((item) => (
                    <article class="services__classic-item">
                      <div class="services__classic-row">
                        <div class="services__classic-marker" aria-hidden="true">
                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path
                              d="M5 12.5 10 17.5 19 7.5"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </div>
                        <div class="services__classic-copy">
                          <h3>{item.title}</h3>
                          <p>{item.description}</p>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              )}
            </div>
          ) : isCards ? (
            <div class="services__cards">
              {visibleItems.map((item) => (
                <article class="services__card">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </article>
              ))}
            </div>
          ) : (
            <div class="services__grid">
              <div class="services__column services__column--left">
                {leftItems.map((item) => (
                  <article class="services__item">
                    <div class="services__icon">
                      <span class="services__dot"></span>
                    </div>

                    <div class="services__content">
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                    </div>
                  </article>
                ))}

                {rightItems.map((item) => (
                  <article class="services__item services__item--mobile">
                    <div class="services__icon">
                      <span class="services__dot"></span>
                    </div>

                    <div class="services__content">
                      <h3>{item.title}</h3>
                      <p>{item.description}</p>
                    </div>
                  </article>
                ))}
              </div>

              {rightItems.length > 0 && (
                <div class="services__column services__column--right">
                  {rightItems.map((item) => (
                    <article class="services__item">
                      <div class="services__icon">
                        <span class="services__dot"></span>
                      </div>

                      <div class="services__content">
                        <h3>{item.title}</h3>
                        <p>{item.description}</p>
                      </div>
                    </article>
                  ))}
                </div>
              )}
            </div>
          )}
        </>
      )}
    </div>
  </section>
)}

<style>
  .services {
    padding: 4rem 0;
  }

  .services__container {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .services__heading {
    max-width: 48rem;
    margin: 0 auto 3rem;
    text-align: left;
  }

  .services__kicker {
    margin: 0 0 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--site-color-primary, hsl(145 40% 35%));
  }

  .services h2 {
    margin: 0;
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: 1.875rem;
    line-height: 1.15;
    font-weight: 700;
    color: hsl(220 15% 15%);
  }

  .services__grid {
    display: block;
    max-width: 80rem;
    margin: 0 auto;
  }

  .services__column {
    display: grid;
    gap: 2rem;
  }

  .services__column--right {
    display: none;
  }

  .services__item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .services__icon {
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.125rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 12%, white);
    border: 1px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 20%, transparent);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .services__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--site-color-accent, hsl(145 12% 55%));
    display: block;
  }

  .services__content h3 {
    margin: 0 0 0.5rem;
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: 1.125rem;
    line-height: 1.35;
    font-weight: 600;
    color: hsl(220 15% 15%);
  }

  .services__content p {
    margin: 0;
    color: hsl(220 15% 15% / 0.7);
    font-size: 1rem;
    line-height: 1.7;
  }

  .services__item--mobile {
    display: flex;
  }

  @media (min-width: 1024px) {
    .services {
      padding: 6rem 0;
    }

    .services__heading {
      text-align: center;
      margin-bottom: 4rem;
    }

    .services h2 {
      font-size: 2.25rem;
    }

    .services__grid {
      display: grid !important;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
      align-items: start;
      max-width: 68rem;
      margin: 0 auto;
    }

    .services__column {
      display: grid;
      gap: 2.5rem;
    }

    .services__column--left {
      padding-right: 1rem;
    }

    .services__column--right {
      display: grid !important;
      gap: 2.5rem;
      padding-top: 4rem;
      padding-left: 1rem;
    }

    .services__item--mobile {
      display: none !important;
    }
  }

  .services--cards .services__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 68rem;
    margin: 0 auto;
  }

  .services--cards .services__card {
    margin: 0;
    padding: 1.5rem 1.35rem;
    border-radius: var(--site-radius-card, 0.75rem);
    border: 1px solid var(--site-color-card-border, hsl(30 8% 88%));
    background: var(--site-color-card, #fff);
    box-shadow: var(--site-shadow, none);
  }

  .services--cards .services__card h3 {
    margin: 0 0 0.65rem;
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: 1.125rem;
    line-height: 1.35;
    font-weight: 600;
    color: hsl(220 15% 15%);
  }

  .services--cards .services__card p {
    margin: 0;
    color: hsl(220 15% 15% / 0.7);
    font-size: 1rem;
    line-height: 1.7;
  }

  @media (min-width: 768px) {
    .services--cards .services__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .services--cards .services__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .services--classic-split {
    padding: 4rem 0;
  }

  .services--classic-split .services__heading--center {
    text-align: center;
    max-width: 48rem;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 3rem;
  }

  .services__classic {
    max-width: 64rem;
    margin: 0 auto;
  }

  .services__classic-col {
    display: grid;
    gap: 2rem;
  }

  .services__classic-col--secondary {
    display: none;
  }

  .services__classic-item--mobile {
    display: block;
  }

  .services__classic-row {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .services__classic-marker {
    flex: 0 0 auto;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.125rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 22%, transparent);
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 8%, white);
    color: var(--site-color-primary, hsl(145 63% 42%));
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .services__classic-marker svg {
    width: 0.95rem;
    height: 0.95rem;
    display: block;
  }

  .services__classic-copy h3 {
    margin: 0 0 0.5rem;
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: 1.125rem;
    line-height: 1.35;
    font-weight: 600;
    color: hsl(220 15% 15%);
  }

  .services__classic-copy p {
    margin: 0;
    color: hsl(220 15% 15% / 0.7);
    font-size: 1rem;
    line-height: 1.7;
  }

  @media (min-width: 1024px) {
    .services--classic-split {
      padding: 6rem 0;
    }

    .services__classic {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }

    .services__classic-col {
      gap: 2.5rem;
    }

    .services__classic-col--secondary {
      display: grid;
      padding-top: 4rem;
    }

    .services__classic-item--mobile {
      display: none;
    }
  }

  /* —— cinematic-signs —— */
  .services--cinematic {
    position: relative;
    overflow: visible;
    padding: 3.5rem 0;
    background: #fbf8f4;
  }

  .services--cinematic .services__glow {
    pointer-events: none;
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 18% 18%,
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 3.5%, transparent) 0%,
      transparent 30%
    );
  }

  .services--cinematic .services__ring {
    pointer-events: none;
    position: absolute;
    right: -170px;
    top: -90px;
    display: none;
    height: 360px;
    width: 360px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 10%, transparent);
  }

  .services--cinematic .services__container {
    position: relative;
    z-index: 1;
  }

  .services--cinematic .services__split-heading {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  .services--cinematic .services__kicker {
    margin: 0 0 1.25rem;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 70%, transparent);
  }

  .services--cinematic h2 {
    max-width: 13ch;
    font-family: var(--site-font-heading, Georgia, serif);
    font-size: 2.2rem;
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  .services--cinematic .services__support {
    margin: 0;
    max-width: 42rem;
    color: hsl(220 15% 15% / 0.68);
    font-size: 1rem;
    line-height: 1.85;
  }

  .services--cinematic .services__signs {
    margin-top: 3rem;
    display: grid;
    gap: 2rem;
  }

  .services--cinematic .services__sign {
    margin: 0 0.75rem;
    padding: 1.75rem;
    border-radius: 2rem;
    border: 1px solid hsl(30 8% 88% / 0.24);
    background: hsl(0 0% 100% / 0.62);
    box-shadow: 0 18px 50px -42px hsl(220 15% 15% / 0.12);
    backdrop-filter: blur(4px);
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
  }

  .services--cinematic .services__sign:hover {
    transform: translateY(-2px);
    box-shadow: 0 24px 60px -40px hsl(220 15% 15% / 0.16);
  }

  .services--cinematic .services__sign-row {
    position: relative;
    padding-left: 1.3rem;
  }

  .services--cinematic .services__sign-icon {
    position: absolute;
    left: -3.5rem;
    top: 50%;
    display: flex;
    height: 56px;
    width: 56px;
    transform: translateY(-50%);
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 10%, transparent);
    background: #fbf8f4;
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 62%, transparent);
    box-shadow: 0 8px 24px -18px hsl(220 15% 15% / 0.18);
  }

  .services--cinematic .services__sign-icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .services--cinematic .services__sign-copy h3 {
    margin: 0;
    font-family: var(--site-font-heading, Georgia, serif);
    font-size: 1.22rem;
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.018em;
    color: hsl(220 15% 15%);
  }

  .services--cinematic .services__sign-copy p {
    margin: 0.75rem 0 0;
    color: hsl(220 15% 15% / 0.62);
    font-size: 0.95rem;
    line-height: 1.72;
  }

  @media (min-width: 640px) {
    .services--cinematic h2 {
      font-size: 2.65rem;
    }
  }

  @media (min-width: 1024px) {
    .services--cinematic {
      padding: 5rem 0;
    }

    .services--cinematic .services__ring {
      display: block;
    }

    .services--cinematic .services__split-heading {
      grid-template-columns: 0.7fr 1fr;
      gap: 4rem;
    }

    .services--cinematic h2 {
      font-size: 3.15rem;
    }

    .services--cinematic .services__support {
      font-size: 1.04rem;
    }

    .services--cinematic .services__signs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 2.5rem;
    }

    .services--cinematic .services__sign {
      margin: 0;
    }

    .services--cinematic .services__sign--stagger {
      transform: translateY(2rem);
    }

    .services--cinematic .services__sign--stagger:hover {
      transform: translateY(calc(2rem - 2px));
    }

    .services--cinematic .services__sign-row {
      display: flex;
      align-items: flex-start;
      gap: 1.25rem;
      padding-left: 0;
    }

    .services--cinematic .services__sign-icon {
      position: static;
      transform: none;
      flex-shrink: 0;
      margin-top: 0.25rem;
      height: 3rem;
      width: 3rem;
      border-radius: 1.2rem;
      background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 3.5%, white);
      box-shadow: none;
    }

    .services--cinematic .services__sign-icon :global(svg) {
      width: 1.25rem;
      height: 1.25rem;
    }
  }
</style>
