---
/**
 * F4 mission — ordered progress track + optional quantitative progress.
 * Navy-band companion to MissionInitiativeBlock (FeaturedBook progress feel).
 */
const { block } = Astro.props as {
  block: {
    type?: string
    content?: {
      title?: string | null
      eyebrow?: string | null
      milestones?: { id?: string; label?: string; position?: number }[]
      currentId?: string | null
      quantitative?: {
        current?: number
        goal?: number
        unitLabel?: string | null
      } | null
    }
  }
}

const content = block?.content ?? {}
const title =
  typeof content.title === "string" && content.title.trim()
    ? content.title.trim()
    : "Progresso"
const eyebrow =
  typeof content.eyebrow === "string" ? content.eyebrow.trim() : "Jornada"
const milestones = Array.isArray(content.milestones)
  ? [...content.milestones]
      .filter((m) => m && typeof m.label === "string" && m.label.trim())
      .sort((a, b) => (Number(a.position) || 0) - (Number(b.position) || 0))
  : []
const currentId =
  typeof content.currentId === "string" && content.currentId.trim()
    ? content.currentId.trim()
    : null
const quantitative = content.quantitative
const hasQuantitative =
  quantitative &&
  typeof quantitative.current === "number" &&
  typeof quantitative.goal === "number" &&
  quantitative.goal > 0
const pct = hasQuantitative
  ? Math.min(100, Math.round((quantitative.current / quantitative.goal) * 100))
  : null
const show = milestones.length > 0 || hasQuantitative

function milestoneState(id: string) {
  if (!currentId || !milestones.length) return "pending"
  const currentIndex = milestones.findIndex((m) => m.id === currentId)
  const index = milestones.findIndex((m) => m.id === id)
  if (currentIndex < 0 || index < 0) return id === currentId ? "active" : "pending"
  if (index < currentIndex) return "complete"
  if (index === currentIndex) return "active"
  return "pending"
}
---

{show && (
  <section class="mission-progress" aria-labelledby="mission-progress-title">
    <div class="mission-progress__container">
      <div class="mission-progress__eyebrow-row">
        <span class="mission-progress__gold-rule" aria-hidden="true" />
        <span class="mission-progress__eyebrow">{eyebrow}</span>
      </div>
      <h2 id="mission-progress-title" class="mission-progress__title">
        {title}
      </h2>

      {milestones.length > 0 && (
        <ol class="mission-progress__list">
          {milestones.map((milestone) => {
            const id = typeof milestone.id === "string" ? milestone.id : ""
            const state = milestoneState(id)
            return (
              <li
                class:list={[
                  "mission-progress__item",
                  `mission-progress__item--${state}`,
                ]}
                aria-current={state === "active" ? "step" : undefined}
              >
                <span class="mission-progress__marker" aria-hidden="true" />
                <span class="mission-progress__label">{milestone.label}</span>
                {state === "active" && (
                  <span class="mission-progress__chip">Atual</span>
                )}
                {state === "complete" && (
                  <span class="mission-progress__chip mission-progress__chip--muted">
                    Concluído
                  </span>
                )}
              </li>
            )
          })}
        </ol>
      )}

      {hasQuantitative && (
        <div
          class="mission-progress__meter"
          role="group"
          aria-label="Progresso quantitativo"
        >
          <div
            class="mission-progress__bar"
            role="progressbar"
            aria-valuemin={0}
            aria-valuemax={quantitative.goal}
            aria-valuenow={quantitative.current}
            aria-valuetext={`${quantitative.current} de ${quantitative.goal}${quantitative.unitLabel ? ` ${quantitative.unitLabel}` : ""}`}
          >
            <div class="mission-progress__fill" style={`width: ${pct}%`} />
          </div>
          <p class="mission-progress__numbers">
            <span>{new Intl.NumberFormat("pt-BR").format(quantitative.current)}</span>
            <span aria-hidden="true"> / </span>
            <span>{new Intl.NumberFormat("pt-BR").format(quantitative.goal)}</span>
            {quantitative.unitLabel ? <span> {quantitative.unitLabel}</span> : null}
          </p>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .mission-progress {
    padding: 0 0 clamp(4rem, 8vw, 6rem);
    background: var(--site-color-primary, hsl(220 40% 16%));
    color: var(--site-color-text-inverse, #f7f3ea);
  }
  .mission-progress__container {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) {
    .mission-progress__container {
      padding-left: max(1.5rem, calc((100% - 76rem) / 2 + 1.5rem + 41.666%));
      padding-right: 1.5rem;
      max-width: none;
    }
  }
  .mission-progress__eyebrow-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .mission-progress__gold-rule {
    width: 2.75rem;
    height: 1px;
    background: var(--site-color-accent, hsl(40 45% 55%));
  }
  .mission-progress__eyebrow {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--site-color-accent, hsl(40 45% 55%));
  }
  .mission-progress__title {
    margin: 0;
    font-family: var(--site-font-heading, Georgia, serif);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--site-color-text-inverse, #fff);
  }
  .mission-progress__list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 1.75rem 0 0;
    border-top: 1px solid color-mix(in srgb, var(--site-color-text-inverse, #fff) 12%, transparent);
    display: grid;
    gap: 1rem;
  }
  .mission-progress__item {
    display: grid;
    grid-template-columns: 0.75rem 1fr auto;
    gap: 1rem;
    align-items: center;
  }
  .mission-progress__marker {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--site-color-text-inverse, #fff) 25%, transparent);
  }
  .mission-progress__item--complete .mission-progress__marker {
    background: var(--site-color-accent, hsl(40 45% 55%));
  }
  .mission-progress__item--active .mission-progress__marker {
    background: var(--site-color-accent, hsl(40 45% 55%));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--site-color-accent, hsl(40 45% 55%)) 25%, transparent);
  }
  .mission-progress__label {
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--site-color-text-inverse, #fff) 90%, transparent);
  }
  .mission-progress__item--pending .mission-progress__label {
    color: color-mix(in srgb, var(--site-color-text-inverse, #fff) 40%, transparent);
  }
  .mission-progress__chip {
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--site-color-accent, hsl(40 45% 55%));
  }
  .mission-progress__chip--muted {
    color: color-mix(in srgb, var(--site-color-text-inverse, #fff) 40%, transparent);
  }
  .mission-progress__meter {
    margin-top: 1rem;
    padding: 1.5rem 1.5rem 1.35rem;
    border: 1px solid color-mix(in srgb, var(--site-color-text-inverse, #fff) 12%, transparent);
  }
  .mission-progress__bar {
    height: 0.35rem;
    background: color-mix(in srgb, var(--site-color-text-inverse, #fff) 12%, transparent);
    overflow: hidden;
  }
  .mission-progress__fill {
    height: 100%;
    background: var(--site-color-accent, hsl(40 45% 55%));
  }
  .mission-progress__numbers {
    margin: 0.85rem 0 0;
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--site-color-text-inverse, #fff) 82%, transparent);
  }
</style>
