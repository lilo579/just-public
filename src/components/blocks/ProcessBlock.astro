---
import CinematicSectionIcon from "../icons/CinematicSectionIcon.astro";

type Step = {
  number: number;
  title: string;
  description?: string | null;
};

type JourneyIcon = "handshake" | "search" | "target" | "users" | "sprout";

const {
  block,
  indexIcons = true,
  badgeEmphasis = "accent",
  layout = "standard",
  sectionId,
  videoUrl = null,
} = Astro.props as {
  block: {
    type: "process";
    content: {
      kicker?: string | null;
      title?: string | null;
      body?: string | null;
      steps?: Step[];
      imageUrl?: string | null;
      videoUrl?: string | null;
      closingPullQuote?: string | null;
    };
  };
  indexIcons?: boolean;
  badgeEmphasis?: "primary" | "accent";
  layout?: "standard" | "cinematic-journey" | "cinematic-method";
  sectionId?: string;
  videoUrl?: string | null;
};

const kicker = block.content?.kicker;
const title = block.content?.title;
const body = block.content?.body;
const imageUrl = block.content?.imageUrl;
const resolvedVideoUrl =
  (typeof videoUrl === "string" && videoUrl.trim()) ||
  (typeof block.content?.videoUrl === "string" ? block.content.videoUrl : null);
const closingPullQuote = block.content?.closingPullQuote;
const steps = (block.content?.steps ?? []).filter((step) => step?.title);
const isMethod = layout === "cinematic-method";
const isCinematic = layout === "cinematic-journey" || isMethod;

const journeyIcons: JourneyIcon[] = [
  "handshake",
  "search",
  "target",
  "users",
  "sprout",
];

function iconFor(stepNumber: number) {
  if (!indexIcons) return null;
  if (stepNumber === 1) return "message";
  if (stepNumber === 2) return "calendar";
  return "heart";
}

function padStep(n: number, index: number) {
  const value = Number.isFinite(n) && n > 0 ? n : index + 1;
  return String(value).padStart(2, "0");
}
---

{(steps.length > 0 || kicker || title || body || (isCinematic && (imageUrl || resolvedVideoUrl || closingPullQuote))) && (
  <section
    class:list={[
      "process",
      isCinematic && "process--cinematic",
      isMethod && "process--method",
    ]}
    data-index-icons={indexIcons ? "true" : "false"}
    data-badge={badgeEmphasis}
    data-f1-method={isMethod ? "true" : undefined}
    id={sectionId || (isCinematic ? "process" : undefined)}
  >
    {isCinematic && !isMethod && <div class="process__glow" aria-hidden="true"></div>}

    <div class="process__container">
      {isMethod ? (
        <div class="process__method" data-f1-method-root>
          <div class="process__method-copy">
            <div class="process__method-rule" aria-hidden="true"></div>
            {kicker && <p class="process__method-kicker">{kicker}</p>}
            {title && <h2 class="process__method-title">{title}</h2>}
            {body && <p class="process__method-body">{body}</p>}
            {steps.length > 0 && (
              <div class="process__method-steps">
                {steps.map((step, index) => (
                  <button
                    type="button"
                    class="process__method-step"
                    data-f1-method-step
                    data-index={index}
                    data-active={index === 0 ? "true" : "false"}
                  >
                    <h3>{step.title}</h3>
                    <div class="process__method-progress" aria-hidden="true">
                      <div class="process__method-progress-fill" data-f1-method-fill></div>
                    </div>
                    {step.description && (
                      <div class="process__method-desc">
                        <p>{step.description}</p>
                      </div>
                    )}
                  </button>
                ))}
              </div>
            )}
          </div>
          {(resolvedVideoUrl || imageUrl) && (
            <div class="process__method-media">
              {resolvedVideoUrl ? (
                <video
                  src={resolvedVideoUrl}
                  class="process__method-video"
                  autoplay
                  muted
                  loop
                  playsinline
                  poster={imageUrl || undefined}
                />
              ) : (
                <img src={imageUrl!} alt="" class="process__method-video" loading="lazy" />
              )}
              <div class="process__method-media-fade" aria-hidden="true"></div>
            </div>
          )}
        </div>
      ) : isCinematic ? (
        <>
          <div class="process__intro">
            <div class="process__intro-copy">
              {kicker && <p class="process__kicker">{kicker}</p>}
              {title && <h2>{title}</h2>}
              <div class="process__hairline" aria-hidden="true"></div>
              {body && <p class="process__body">{body}</p>}
            </div>

            {(resolvedVideoUrl || imageUrl) && (
              <div class="process__intro-media">
                <div class="process__blob-ring" aria-hidden="true"></div>
                <div class="process__frame">
                  {resolvedVideoUrl ? (
                    <video
                      src={resolvedVideoUrl}
                      class="process__image"
                      autoplay
                      muted
                      loop
                      playsinline
                      poster={imageUrl || undefined}
                    />
                  ) : (
                    <img src={imageUrl!} alt="" class="process__image" loading="lazy" />
                  )}
                  <div class="process__image-wash" aria-hidden="true"></div>
                </div>
                {!resolvedVideoUrl && (
                  <div class="process__sprout" aria-hidden="true">
                    <CinematicSectionIcon name="sprout" class="process__sprout-icon" />
                  </div>
                )}
              </div>
            )}
          </div>

          {steps.length > 0 && (
            <div class="process__journey">
              <div class="process__journey-rail" aria-hidden="true">
                <div class="process__journey-line"></div>
                {steps.map((_, index) => {
                  const positions = [8.5, 28, 47.5, 67, 86.5];
                  const left =
                    steps.length === 5
                      ? `${positions[index]}%`
                      : `${((index + 0.5) / steps.length) * 100}%`;
                  return (
                    <span class="process__journey-dot" style={`left: ${left}`}></span>
                  );
                })}
              </div>

              <div
                class="process__journey-grid"
                style={`--journey-cols: ${Math.max(steps.length, 1)}`}
              >
                {steps.map((step, index) => (
                  <article class="process__journey-step">
                    <div class="process__journey-num" aria-hidden="true">
                      <span>{padStep(step.number, index)}</span>
                    </div>
                    <div class="process__journey-copy">
                      <div class="process__journey-icon" aria-hidden="true">
                        <CinematicSectionIcon
                          name={journeyIcons[index % journeyIcons.length]}
                        />
                      </div>
                      <h3>{step.title}</h3>
                      {step.description && <p>{step.description}</p>}
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )}

          {closingPullQuote && (
            <div class="process__closing">
              <p>
                <span class="process__q" aria-hidden="true">“</span>
                {closingPullQuote}
                <span class="process__q" aria-hidden="true">”</span>
              </p>
              <div class="process__heart-divider" aria-hidden="true">
                <span></span>
                <CinematicSectionIcon name="heart" />
                <span></span>
              </div>
            </div>
          )}
        </>
      ) : (
        <>
          {(kicker || title || body) && (
            <div class="process__heading">
              {kicker && <p class="process__kicker">{kicker}</p>}
              {title && <h2>{title}</h2>}
              {body && <p class="process__body">{body}</p>}
            </div>
          )}

          {steps.length > 0 && (
            <div class="process__grid">
              {steps.map((step) => (
                <article class="process__card">
                  <div class="process__badge">{step.number}</div>

                  {iconFor(step.number) && (
                    <div class="process__icon-shell" aria-hidden="true">
                      {iconFor(step.number) === "message" && (
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            d="M20 11.5a8 8 0 0 1-8 8 8.7 8.7 0 0 1-3.2-.6L4 20l1.1-4.1A8 8 0 1 1 20 11.5Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      )}

                      {iconFor(step.number) === "calendar" && (
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <rect
                            x="4"
                            y="5"
                            width="16"
                            height="15"
                            rx="2"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                          />
                          <path
                            d="M8 3v4M16 3v4M4 10h16"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                          />
                        </svg>
                      )}

                      {iconFor(step.number) === "heart" && (
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                          <path
                            d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linejoin="round"
                          />
                        </svg>
                      )}
                    </div>
                  )}

                  <h3>{step.title}</h3>
                  {step.description && <p>{step.description}</p>}
                </article>
              ))}
            </div>
          )}
        </>
      )}
    </div>
  </section>
)}

<style>
  .process {
    padding: 4rem 0;
  }

  .process__container {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .process__heading {
    text-align: center;
    margin-bottom: 3rem;
  }

  .process__kicker {
    margin: 0 0 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--site-color-primary, hsl(145 40% 35%));
  }

  .process__body {
    margin: 0.85rem auto 0;
    max-width: 40rem;
    color: hsl(220 10% 35%);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .process h2 {
    margin: 0;
    font-family: var(--site-font-heading, system-ui, sans-serif);
    font-size: 1.875rem;
    line-height: 1.15;
    font-weight: 700;
    color: hsl(220 15% 15%);
  }

  .process__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 64rem;
    margin: 0 auto;
  }

  .process__card {
    position: relative;
    text-align: center;
    padding: 1.75rem 1.25rem 1.4rem;
    border-radius: 0.875rem;
    background: #ffffff;
    border: 1px solid hsl(30 8% 88% / 0.45);
    box-shadow:
      0 1px 3px 0 hsl(220 15% 15% / 0.04),
      0 4px 16px -4px hsl(220 15% 15% / 0.06);
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
  }

  .process__card:hover {
    transform: translateY(-2px);
    box-shadow:
      0 1px 3px 0 hsl(220 15% 15% / 0.04),
      0 8px 24px -6px hsl(220 15% 15% / 0.10);
  }

  .process__badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    background: var(--site-color-accent, hsl(145 12% 52%));
    color: #ffffff;
    display: grid;
    place-items: center;
    font-size: 0.78rem;
    font-weight: 700;
    box-shadow: 0 4px 10px color-mix(in srgb, var(--site-color-accent, hsl(145 12% 52%)) 22%, transparent);
  }

  .process[data-badge="primary"] .process__badge {
    background: var(--site-color-primary, hsl(145 63% 42%));
    box-shadow: 0 4px 10px color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 22%, transparent);
  }

  .process__icon-shell {
    width: 3.3rem;
    height: 3.3rem;
    margin: 0.7rem auto 1rem;
    border-radius: 999px;
    background: hsl(30 10% 94%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--site-color-accent, hsl(145 12% 52%));
  }

  .process[data-badge="primary"] .process__icon-shell {
    color: var(--site-color-primary, hsl(145 63% 42%));
  }

  .process__icon-shell svg {
    width: 2.35rem;
    height: 2.35rem;
    display: block;
    color: inherit;
  }

  .process__card h3 {
    margin: 0 0 0.65rem;
    color: hsl(220 15% 15%);
    font-size: 1.1rem;
    line-height: 1.35;
    font-weight: 600;
  }

  .process__card p {
    margin: 0;
    color: hsl(220 15% 15% / 0.7);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  @media (min-width: 768px) {
    .process__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .process {
      padding: 6rem 0;
    }

    .process__heading {
      margin-bottom: 4rem;
    }

    .process h2 {
      font-size: 2.25rem;
    }

    .process__grid {
      gap: 2rem;
    }

    .process__card {
      padding: 2rem 1.4rem 1.6rem;
    }

    .process__icon-shell {
      width: 3.15rem;
      height: 3.15rem;
    }
  }

  @media (max-width: 720px) {
    .process__heading {
      text-align: center;
      margin-bottom: 2rem;
    }

    .process h2 {
      font-size: 1.6rem;
    }
  }

  /* —— cinematic-journey —— */
  .process--cinematic {
    position: relative;
    overflow: hidden;
    padding: 4rem 0;
    background: #fbf8f4;
  }

  .process--cinematic .process__glow {
    pointer-events: none;
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 80% 6%,
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 6%, transparent) 0%,
      transparent 34%
    );
  }

  .process--cinematic .process__container {
    position: relative;
    z-index: 1;
  }

  .process--cinematic .process__intro {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }

  .process--cinematic .process__kicker {
    margin: 0 0 1.5rem;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 72%, transparent);
  }

  .process--cinematic h2 {
    max-width: 13ch;
    font-family: var(--site-font-heading, Georgia, serif);
    font-size: 2.45rem;
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .process--cinematic .process__hairline {
    margin-top: 2rem;
    height: 1px;
    width: 6rem;
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 48%, transparent);
  }

  .process--cinematic .process__body {
    margin: 2.25rem 0 0;
    max-width: 34rem;
    color: hsl(220 15% 15% / 0.7);
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .process--cinematic .process__intro-media {
    position: relative;
  }

  .process--cinematic .process__blob-ring {
    position: absolute;
    left: -2.5rem;
    top: -2.5rem;
    height: 104%;
    width: 88%;
    border-radius: 58% 42% 64% 36% / 44% 58% 42% 56%;
    border: 1px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 16%, transparent);
  }

  .process--cinematic .process__frame {
    position: relative;
    overflow: hidden;
    border-radius: 58% 42% 64% 36% / 44% 58% 42% 56%;
    border: 1px solid hsl(30 8% 88% / 0.35);
    background: #fff;
    box-shadow: 0 42px 110px -64px hsl(220 15% 15% / 0.34);
  }

  .process--cinematic .process__image {
    display: block;
    width: 100%;
    height: 430px;
    object-fit: cover;
    object-position: 58% center;
  }

  .process--cinematic .process__image-wash {
    pointer-events: none;
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, hsl(0 0% 100% / 0.12) 0%, transparent 34%);
  }

  .process--cinematic .process__sprout {
    pointer-events: none;
    position: absolute;
    right: 2.5rem;
    bottom: -2rem;
    display: none;
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 36%, transparent);
  }

  .process--cinematic :global(.process__sprout-icon) {
    width: 5rem;
    height: 5rem;
  }

  .process--cinematic .process__journey {
    position: relative;
    margin-top: 4rem;
  }

  .process--cinematic .process__journey-rail {
    pointer-events: none;
    position: absolute;
    left: 1.15rem;
    right: -5.5rem;
    top: 1.55rem;
    display: none;
  }

  .process--cinematic .process__journey-line {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 1px;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 16%, transparent),
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 34%, transparent) 12%,
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 34%, transparent) 88%,
      color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 12%, transparent)
    );
  }

  .process--cinematic .process__journey-dot {
    position: absolute;
    top: 0;
    height: 0.625rem;
    width: 0.625rem;
    transform: translate(-50%, -50%);
    border-radius: 999px;
    border: 1px solid #fbf8f4;
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 58%, transparent);
    box-shadow: 0 0 0 7px #fbf8f4;
  }

  .process--cinematic .process__journey-grid {
    display: grid;
    gap: 0;
  }

  .process--cinematic .process__journey-step {
    position: relative;
    margin-left: 1.25rem;
    padding: 0 0 2rem 3.5rem;
    border-left: 1px solid color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 20%, transparent);
  }

  .process--cinematic .process__journey-step:last-child {
    padding-bottom: 0;
  }

  .process--cinematic .process__journey-num {
    position: absolute;
    left: -1.05rem;
    top: 0;
    display: flex;
    height: 2rem;
    width: 2rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid #fbf8f4;
    background: #fbf8f4;
  }

  .process--cinematic .process__journey-num span {
    font-family: var(--site-font-heading, Georgia, serif);
    font-size: 2.1rem;
    line-height: 1;
    letter-spacing: -0.055em;
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 68%, transparent);
  }

  .process--cinematic .process__journey-icon {
    display: none;
    margin-bottom: 1.25rem;
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 46%, transparent);
  }

  .process--cinematic .process__journey-icon :global(svg) {
    width: 2.15rem;
    height: 2.15rem;
  }

  .process--cinematic .process__journey-copy h3 {
    margin: 0;
    max-width: 18rem;
    font-family: var(--site-font-heading, Georgia, serif);
    font-size: 1.28rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.018em;
    color: hsl(220 15% 15%);
  }

  .process--cinematic .process__journey-copy p {
    margin: 0.75rem 0 0;
    max-width: 24rem;
    color: hsl(220 15% 15% / 0.64);
    font-size: 0.9rem;
    line-height: 1.68;
  }

  .process--cinematic .process__closing {
    margin: 5rem auto 0;
    max-width: 760px;
    text-align: center;
  }

  .process--cinematic .process__closing p {
    margin: 0;
    font-family: var(--site-font-heading, Georgia, serif);
    font-style: italic;
    font-size: 1.55rem;
    line-height: 1.45;
    letter-spacing: -0.018em;
    color: hsl(220 15% 15% / 0.82);
  }

  .process--cinematic .process__q {
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 34%, transparent);
  }

  .process--cinematic .process__heart-divider {
    margin-top: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 42%, transparent);
  }

  .process--cinematic .process__heart-divider span {
    height: 1px;
    width: 9rem;
    background: color-mix(in srgb, var(--site-color-primary, hsl(145 63% 42%)) 20%, transparent);
  }

  .process--cinematic .process__heart-divider :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (min-width: 640px) {
    .process--cinematic h2 {
      font-size: 2.85rem;
    }
  }

  @media (min-width: 1024px) {
    .process--cinematic {
      padding: 6rem 0;
    }

    .process--cinematic .process__intro {
      grid-template-columns: 0.95fr 1.05fr;
      gap: 5rem;
    }

    .process--cinematic h2 {
      font-size: 3.75rem;
    }

    .process--cinematic .process__body {
      font-size: 1.12rem;
    }

    .process--cinematic .process__image {
      height: 520px;
    }

    .process--cinematic .process__sprout {
      display: block;
    }

    .process--cinematic .process__journey {
      margin-top: 5rem;
    }

    .process--cinematic .process__journey-rail {
      display: block;
    }

    .process--cinematic .process__journey-grid {
      grid-template-columns: repeat(var(--journey-cols, 5), minmax(0, 1fr));
      gap: 1.75rem;
    }

    .process--cinematic .process__journey-step {
      margin-left: 0;
      padding: 0;
      border-left: 0;
    }

    .process--cinematic .process__journey-num {
      position: static;
      display: block;
      height: 5.3rem;
      width: auto;
      margin-bottom: 2rem;
      border: 0;
      background: transparent;
    }

    .process--cinematic .process__journey-num span {
      font-size: 2.35rem;
    }

    .process--cinematic .process__journey-icon {
      display: block;
    }

    .process--cinematic .process__journey-copy {
      min-height: 13.4rem;
    }

    .process--cinematic .process__journey-copy h3 {
      max-width: 11rem;
      font-size: 1.32rem;
    }

    .process--cinematic .process__journey-copy p {
      margin-top: 1rem;
      max-width: 13.4rem;
      line-height: 1.72;
    }

    .process--cinematic .process__closing p {
      font-size: 1.8rem;
    }
  }

  /* Reusable cinematic-method layout (trainer / PT storytelling) */
  .process--method {
    background: var(--f1-surface-deep, #0b1020);
    color: rgba(255, 255, 255, 0.92);
    padding: 4rem 0 5rem;
  }

  .process--method .process__container {
    max-width: none;
    width: 100%;
    padding: 0;
  }

  .process__method {
    width: min(1400px, calc(100% - 2rem));
    margin: 0 auto;
    display: grid;
    gap: 3rem;
  }

  .process__method-rule {
    width: 3rem;
    height: 2px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--site-color-primary, #dc2626) 80%, transparent);
    margin-bottom: 1.25rem;
  }

  .process__method-kicker {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }

  .process__method-title {
    margin: 1rem 0 0;
    max-width: 15ch;
    font-size: clamp(1.85rem, 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  .process__method-body {
    margin: 1.5rem 0 0;
    max-width: 46ch;
    font-size: clamp(1rem, 1.4vw, 1.18rem);
    line-height: 1.72;
    color: rgba(255, 255, 255, 0.7);
  }

  .process__method-steps {
    margin-top: 3.5rem;
    display: grid;
    gap: 2.5rem;
  }

  .process__method-step {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
    color: inherit;
    cursor: pointer;
  }

  .process__method-step h3 {
    margin: 0;
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.18);
    transition: color 0.3s ease, letter-spacing 0.3s ease;
  }

  .process__method-step[data-active="true"] h3 {
    color: #fff;
    letter-spacing: -0.025em;
  }

  .process__method-step:hover h3 {
    color: rgba(255, 255, 255, 0.44);
  }

  .process__method-step[data-active="true"]:hover h3 {
    color: #fff;
  }

  .process__method-progress {
    position: relative;
    margin: 1rem 0;
    width: min(220px, 100%);
    height: 1.5px;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
  }

  .process__method-progress-fill {
    position: absolute;
    left: 0;
    top: 50%;
    height: 4px;
    width: 0%;
    transform: translateY(-50%);
    border-radius: 999px;
    background: var(--site-color-primary, #dc2626);
  }

  .process__method-desc {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease;
  }

  .process__method-step[data-active="true"] .process__method-desc {
    grid-template-rows: 1fr;
    opacity: 0.8;
  }

  .process__method-desc > p {
    margin: 0;
    overflow: hidden;
    max-width: 44ch;
    font-size: 0.98rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.64);
  }

  .process__method-media {
    position: relative;
    overflow: hidden;
    min-height: 420px;
  }

  .process__method-video {
    width: 100%;
    height: 100%;
    min-height: 420px;
    object-fit: cover;
    display: block;
    opacity: 0.94;
  }

  .process__method-media-fade {
    pointer-events: none;
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--f1-surface-deep, #0b1020) 0%, rgba(11, 16, 32, 0.22) 18%, transparent 40%),
      linear-gradient(to left, var(--f1-surface-deep, #0b1020) 0%, rgba(11, 16, 32, 0.18) 12%, transparent 32%);
  }

  @media (min-width: 1024px) {
    .process--method {
      padding: 6rem 0 7rem;
    }

    .process__method {
      grid-template-columns: 1.1fr 0.9fr;
      align-items: center;
      gap: 3.5rem;
      width: min(1400px, calc(100% - 6rem));
    }

    .process__method-media {
      min-height: 620px;
    }

    .process__method-video {
      min-height: 620px;
    }

    .process__method-media-fade {
      background:
        linear-gradient(to right, var(--f1-surface-deep, #0b1020) 0%, rgba(11, 16, 32, 0.62) 10%, rgba(11, 16, 32, 0.14) 28%, transparent 42%),
        linear-gradient(to left, var(--f1-surface-deep, #0b1020) 0%, rgba(11, 16, 32, 0.62) 10%, rgba(11, 16, 32, 0.14) 28%, transparent 42%),
        linear-gradient(to bottom, var(--f1-surface-deep, #0b1020) 0%, rgba(11, 16, 32, 0.38) 8%, transparent 18%),
        linear-gradient(to top, var(--f1-surface-deep, #0b1020) 0%, rgba(11, 16, 32, 0.38) 8%, transparent 18%);
    }
  }
</style>

<script>
  function initMethod(root) {
    if (!(root instanceof HTMLElement) || root.dataset.bound === "1") return
    root.dataset.bound = "1"
    const steps = [...root.querySelectorAll("[data-f1-method-step]")]
    if (!steps.length) return
    let active = 0
    let progress = 0
    let raf = 0
    let last = 0
    const duration = 5500
    let visible = false

    const paint = () => {
      steps.forEach((step, index) => {
        step.dataset.active = index === active ? "true" : "false"
        const fill = step.querySelector("[data-f1-method-fill]")
        if (fill instanceof HTMLElement) {
          fill.style.width = index === active ? `${Math.max(0, Math.min(progress, 1)) * 100}%` : "0%"
        }
      })
    }

    const tick = (ts) => {
      if (!visible) {
        raf = requestAnimationFrame(tick)
        return
      }
      if (!last) last = ts
      progress += (ts - last) / duration
      last = ts
      if (progress >= 1) {
        progress = 0
        active = (active + 1) % steps.length
      }
      paint()
      raf = requestAnimationFrame(tick)
    }

    steps.forEach((step, index) => {
      step.addEventListener("click", () => {
        active = index
        progress = 0
        last = 0
        paint()
      })
    })

    const io = new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting)
        if (visible) last = 0
      },
      { threshold: 0.15 },
    )
    io.observe(root)
    paint()
    raf = requestAnimationFrame(tick)
  }

  function bootMethod() {
    document.querySelectorAll("[data-f1-method-root]").forEach(initMethod)
  }
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", bootMethod, { once: true })
  else bootMethod()
  document.addEventListener("astro:page-load", bootMethod)
</script>
