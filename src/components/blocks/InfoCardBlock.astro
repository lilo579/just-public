---
const { block } = Astro.props as {
  block: {
    type: "info_card";
    content: {
      title?: string | null;
      body?: string | null;
      pills?: string[];
    };
  };
};

const title = block.content?.title;
const body = block.content?.body;
const pills = (block.content?.pills ?? []).filter(Boolean);
const paragraphs = body ? body.split("\n\n").map((p) => p.trim()).filter(Boolean) : [];

const iconNames = ["map-pin", "message-circle", "shield"] as const;

function iconFor(index: number) {
  return iconNames[index % iconNames.length];
}
---

{(title || paragraphs.length > 0 || pills.length > 0) && (
  <section class="info-card">
    <div class="info-card__overlay" aria-hidden="true"></div>

    <div class="info-card__container">
      {title && (
        <div class="info-card__heading">
          <h2>{title}</h2>
        </div>
      )}

      <div class="info-card__panel">
        {paragraphs.length > 0 && (
          <div class="info-card__body">
            {paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        )}

        {pills.length > 0 && (
          <div class="info-card__pills">
            {pills.map((pill, index) => (
              <span class="info-card__pill">
                <span class="info-card__pill-icon">
                  {iconFor(index) === "map-pin" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M12 21s6-5.7 6-11a6 6 0 1 0-12 0c0 5.3 6 11 6 11Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linejoin="round"
                      />
                      <circle cx="12" cy="10" r="2.2" fill="none" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                  )}

                  {iconFor(index) === "message-circle" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M20 11.5a8 8 0 0 1-8 8 8.7 8.7 0 0 1-3.2-.6L4 20l1.1-4.1A8 8 0 1 1 20 11.5Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}

                  {iconFor(index) === "shield" && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path
                        d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3Z"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linejoin="round"
                      />
                    </svg>
                  )}
                </span>

                <span class="info-card__pill-label">{pill}</span>
              </span>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
)}

<style>
  .info-card {
    position: relative;
    padding: 4rem 0;
  }

  .info-card__overlay {
    position: absolute;
    inset: 0;
    background: #ffffff;
  }

  .info-card__container {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .info-card__heading {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .info-card h2 {
    margin: 0 auto;
    max-width: 20ch;
    font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    font-size: 1.875rem;
    line-height: 1.15;
    font-weight: 700;
    color: hsl(220 15% 15%);
    text-wrap: balance;
  }

  .info-card__panel {
    max-width: 52rem;
    margin: 0 auto;
    padding: 1.75rem 1.5rem;
    border-radius: 0.875rem;
    background: #ffffff;
    border: 1px solid hsl(30 8% 88% / 0.45);
    box-shadow:
      0 1px 3px 0 hsl(220 15% 15% / 0.04),
      0 4px 16px -4px hsl(220 15% 15% / 0.06);
  }

  .info-card__body {
    display: grid;
    gap: 0.9rem;
  }

  .info-card__body p {
    margin: 0;
    color: hsl(220 15% 15% / 0.7);
    font-size: 1rem;
    line-height: 1.72;
    text-align: center;
    max-width: 40rem;
    margin-left: auto;
    margin-right: auto;
  }

  .info-card__pills {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1rem;
  }

  .info-card__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.95rem;
    border-radius: 999px;
    background: hsl(30 10% 96%);
    border: 1px solid hsl(30 8% 88% / 0.55);
  }

  .info-card__pill-icon {
    width: 1rem;
    height: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--site-color-accent, hsl(145 20% 45%));
    flex: 0 0 auto;
  }

  .info-card__pill-icon svg {
    width: 1rem;
    height: 1rem;
    display: block;
  }

  .info-card__pill-label {
    color: hsl(220 15% 15%);
    font-size: 0.9rem;
    line-height: 1.2;
    font-weight: 500;
  }

  @media (min-width: 640px) {
    .info-card__overlay {
      background: hsl(220 15% 15% / 0.015);
    }
  }

  @media (min-width: 1024px) {
    .info-card {
      padding: 5rem 0;
    }

    .info-card__heading {
      margin-bottom: 3rem;
    }

    .info-card h2 {
      max-width: none;
      font-size: 2.25rem;
    }

    .info-card__panel {
      padding: 2rem 2rem;
    }

    .info-card__pills {
      margin-top: 1.75rem;
      gap: 1rem;
    }

    .info-card__pill {
      padding: 0.65rem 1rem;
    }

    .info-card__pill-label {
      font-size: 0.92rem;
    }
  }

  @media (max-width: 720px) {
    .info-card {
      padding: 3rem 0 2.75rem;
    }

    .info-card__heading {
      text-align: center;
      margin-bottom: 1.5rem;
    }

    .info-card h2 {
      max-width: 12ch;
      font-size: 1.55rem;
      line-height: 1.16;
      text-wrap: balance;
    }

    .info-card__panel {
      padding: 1.4rem 1rem;
      border-radius: 0.8rem;
    }

    .info-card__body {
      gap: 0.8rem;
    }

    .info-card__body p {
      font-size: 0.98rem;
      line-height: 1.68;
    }

    .info-card__pills {
      margin-top: 1.25rem;
      gap: 0.65rem 0.75rem;
    }

    .info-card__pill {
      padding: 0.55rem 0.85rem;
    }

    .info-card__pill-label {
      font-size: 0.88rem;
    }
  }
</style>