---
// Presentation markup/class names restored from the pre-cutover reference.
// All tenant values are supplied by the canonical painted plan / structured chrome.
import FormField from "./FormField.astro";
const { content, chrome } = Astro.props;
const contactNumber =
  chrome?.contact?.whatsappNumber ||
  content?.whatsapp ||
  content?.contact?.whatsappNumber ||
  "";
const contactEmail =
  chrome?.contact?.email || content?.email || content?.contact?.email || "";
const contact = {
  whatsapp: contactNumber,
  whatsappDisplay: contactNumber,
  email: contactEmail,
};
const whatsappHref =
  chrome?.whatsappHref ||
  (String(contactNumber).replace(/\D/g, "")
    ? `https://wa.me/${String(contactNumber).replace(/\D/g, "")}`
    : "");
const emailHref = contact.email ? `mailto:${contact.email}` : "";
const contactSection = {
  eyebrow: content?.eyebrow || "Contato",
  headline: content?.title,
  lead: content?.body,
  whatsappLabel: "WhatsApp",
  emailLabel: "E-mail",
};
const form = {
  nameLabel: "Nome",
  emailLabel: "E-mail",
  phoneLabel: "Telefone",
  messageLabel: "Mensagem",
  note:
    content?.formNote ||
    "Ao enviar, você será direcionado ao WhatsApp com a mensagem preenchida.",
  submitLabel: content?.submitLabel || "Enviar mensagem",
};
const showForm =
  content?.formMode === "whatsapp_compose" && Boolean(String(contactNumber).replace(/\D/g, ""));
---
    <section id="contact" class="section-band bg-navy-deep text-ivory">
      <div class="container-editorial grid lg:grid-cols-12 gap-14 lg:gap-24">
        <div class="lg:col-span-5 lg:pt-2">
          <div class="flex items-center gap-3">
            <span class="gold-rule" />
            <span class="eyebrow" style={{ color: "var(--gold)" }}>
              {contactSection.eyebrow}
            </span>
          </div>
          <h2 class="mt-6 font-serif text-[2.25rem] sm:text-5xl text-ivory leading-[1.08] tracking-[-0.02em] text-balance">
            {contactSection.headline}
          </h2>
          <p class="mt-7 text-ivory/70 text-[1.0625rem] leading-[1.85] max-w-md">
            {contactSection.lead}
          </p>

          <dl class="mt-12 space-y-8">
            <div>
              <dt class="eyebrow" style={{ color: "var(--gold)" }}>
                {contactSection.whatsappLabel}
              </dt>
              <dd class="mt-3">
                <a
                  href={whatsappHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-conversion="general-whatsapp"
                  class="font-serif text-2xl sm:text-[1.75rem] text-ivory hover:text-gold transition-colors duration-500"
                >
                  {contact.whatsappDisplay}
                </a>
              </dd>
            </div>
            <div>
              <dt class="eyebrow" style={{ color: "var(--gold)" }}>
                {contactSection.emailLabel}
              </dt>
              <dd class="mt-3">
                <a
                  href={emailHref}
                  data-conversion="general-email"
                  class="font-serif text-xl sm:text-[1.35rem] text-ivory hover:text-gold transition-colors duration-500 break-all"
                >
                  {contact.email}
                </a>
              </dd>
            </div>
          </dl>
        </div>

        {showForm && <div class="lg:col-span-7">
          <form
            data-editorial-contact data-phone={contact.whatsapp} data-greeting={content.formGreeting || "Olá! Gostaria de falar com a equipe."}
            novalidate
            class="bg-ivory text-foreground px-8 py-9 sm:px-10 sm:py-11 lg:px-12 lg:py-12 space-y-7"
          >
            <FormField label={form.nameLabel} name="name" required />
            <div class="grid sm:grid-cols-2 gap-7">
              <FormField label={form.emailLabel} name="email" type="email" required />
              <FormField label={form.phoneLabel} name="phone" type="tel" />
            </div>
            <FormField label={form.messageLabel} name="message" textarea required />

<p data-editorial-contact-error hidden role="alert" tabindex="-1" class="text-sm text-destructive outline-none">Preencha nome, e-mail e mensagem para continuar.</p>

            <div class="pt-3 flex items-center justify-between flex-wrap gap-5">
              <p class="text-xs leading-relaxed text-muted-foreground max-w-xs">{form.note}</p>
              <button
                type="submit"
                data-conversion="contact-form-whatsapp"
                class="inline-flex items-center justify-center min-h-11 px-8 py-3.5 text-[0.6875rem] uppercase tracking-[0.22em] font-medium bg-navy-deep text-ivory border border-navy-deep hover:bg-navy transition-colors duration-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
              >
                {form.submitLabel}
              </button>
            </div>
          </form>
        </div>}
      </div>
    </section>
<script>
for(const form of document.querySelectorAll<HTMLFormElement>("[data-editorial-contact]")){
 form.addEventListener("submit",e=>{
  e.preventDefault();const d=new FormData(form);const name=String(d.get("name")||"").trim(),email=String(d.get("email")||"").trim(),phone=String(d.get("phone")||"").trim(),message=String(d.get("message")||"").trim();
  const error=form.querySelector<HTMLElement>("[data-editorial-contact-error]");
  if(!name||!email||!message){if(error){error.hidden=false;error.focus();}return;}
  if(error)error.hidden=true;
  const number=(form.dataset.phone||"").replace(/\D/g,"");if(!number)return;
  const text=[form.dataset.greeting||"","",`Nome: ${name}`,`E-mail: ${email}${phone?`\nTelefone: ${phone}`:""}`,`Mensagem: ${message}`].join("\n");
  window.open(`https://wa.me/${number}?text=${encodeURIComponent(text)}`,"_blank","noopener,noreferrer");
 });
}
</script>