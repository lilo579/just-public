---
// Presentation markup/class names restored from the pre-cutover reference.
// All tenant values are supplied by the canonical painted plan / structured chrome.
import FeaturedCover from "./FeaturedCover.astro";
import CTAButton from "./CTAButton.astro";
const {content, progress = {}} = Astro.props;
const milestones = [...(progress.milestones || [])].sort((a,b)=>a.position-b.position);
const active = milestones.findIndex(s=>s.id===progress.currentId);
const publication = {title:content.title,subtitle:content.subtitle,coverImage:content.imageUrl,coverAlt:content.imageAlt || content.title,description:(content.description || "").split(/\n\n+/),fundingCurrent:progress.quantitative?.current ?? null,fundingGoal:progress.quantitative?.goal ?? null,stages:milestones.map((s,i)=>({label:s.label,state:i===active ? "active" : active>=0 && i<active ? "complete" : "pending"}))};
const featuredBook = {
  eyebrow: content.eyebrow || content.titleEyebrow || "Publicação em andamento",
  currency: progress.currency || "BRL",
  journeyLabel: progress.journeyLabel || "Caminho da publicação",
  fundingLabel: progress.fundingLabel || "arrecadados de",
  stageLabels: {
    active: progress.activeLabel || "Em andamento",
    complete: progress.completeLabel || "Concluído",
  },
};
const formatCurrency=(n,currency)=>new Intl.NumberFormat("pt-BR",{style:"currency",currency,maximumFractionDigits:0}).format(n);
const hasFunding=publication.fundingCurrent!==null && publication.fundingGoal>0;
const progressPercent=hasFunding ? Math.round(publication.fundingCurrent/publication.fundingGoal*100):0;
const barWidthPercent=Math.min(100,Math.max(0,progressPercent));
const [leadParagraph,...restParagraphs]=publication.description;
const cta=content.cta;

---
<section id="featured" class="section-band-airy bg-navy-deep text-ivory">
      <div class="container-editorial">
        <div class="grid lg:grid-cols-12 gap-14 lg:gap-24 items-start">
          {publication.coverImage ? (
            <div class="hidden lg:col-span-5 lg:sticky lg:top-28 lg:block">
              <FeaturedCover
                class="relative max-w-[18rem] sm:max-w-sm mx-auto lg:mx-0 lg:max-w-md"
                coverImage={publication.coverImage}
                coverAlt={publication.coverAlt}
              />
            </div>
          ) : (
            <div class="hidden lg:col-span-5 lg:block" aria-hidden="true" />
          )}

          <div class="lg:col-span-7 lg:pt-2">
            <div class="flex items-center gap-3">
              <span class="gold-rule" />
              <span class="eyebrow" style={{ color: "var(--gold)" }}>
                {featuredBook.eyebrow}
              </span>
            </div>
            <h2 class="mt-6 font-serif text-[2.75rem] sm:text-5xl lg:text-[4rem] text-ivory leading-[1.02] tracking-[-0.02em]">
              {publication.title}
            </h2>
            {publication.subtitle ? (
              <p class="mt-4 font-serif italic text-xl sm:text-2xl text-gold/95 leading-snug">
                {publication.subtitle}
              </p>
            ) : null}

            {leadParagraph && (
              <p class="mt-9 max-w-2xl text-[1.0625rem] leading-[1.85] text-ivory/78">
                {leadParagraph}
              </p>
            )}

            {publication.coverImage ? (
              <FeaturedCover
                class="relative mx-auto mt-10 max-w-[18rem] sm:max-w-sm lg:hidden"
                coverImage={publication.coverImage}
                coverAlt={publication.coverAlt}
              />
            ) : null}

            {restParagraphs.length > 0 && (
              <div class="mt-9 space-y-5 text-ivory/78 text-[1.0625rem] leading-[1.85] max-w-2xl">
                {restParagraphs.map((p, i) => (
                  <p>{p}</p>
                ))}
              </div>
            )}

            {publication.stages.length > 0 ? (
              <div class="mt-12 pt-10 border-t border-ivory/12">
                <div class="eyebrow" style={{ color: "var(--gold)" }}>
                  {featuredBook.journeyLabel}
                </div>
                <ol class="mt-6 space-y-4">
                  {publication.stages.map((stage) => (
                    <li class="flex items-center gap-4">
                      <span
                        class={`h-1.5 w-1.5 rounded-full shrink-0 ${
                          stage.state === "complete"
                            ? "bg-gold"
                            : stage.state === "active"
                              ? "bg-gold ring-[3px] ring-gold/25"
                              : "bg-ivory/25"
                        }`}
                        aria-hidden="true"
                      />
                      <span
                        class={`text-sm tracking-wide ${
                          stage.state === "pending" ? "text-ivory/40" : "text-ivory/90"
                        }`}
                      >
                        {stage.label}
                      </span>
                      {stage.state === "active" && (
                        <span class="text-[10px] uppercase tracking-[0.2em] text-gold ml-auto">
                          {featuredBook.stageLabels.active}
                        </span>
                      )}
                      {stage.state === "complete" && (
                        <span class="text-[10px] uppercase tracking-[0.2em] text-ivory/40 ml-auto">
                          {featuredBook.stageLabels.complete}
                        </span>
                      )}
                    </li>
                  ))}
                </ol>
              </div>
            ) : null}

            {hasFunding ? (
              <div class="mt-10 px-6 py-7 border border-ivory/12">
                <div class="flex items-baseline justify-between gap-6">
                  <div>
                    <div class="font-serif text-3xl sm:text-4xl text-gold tracking-tight">
                      {formatCurrency(publication.fundingCurrent!, featuredBook.currency)}
                    </div>
                    <div class="text-[0.6875rem] uppercase tracking-[0.2em] text-ivory/55 mt-2">
                      {featuredBook.fundingLabel}{" "}
                      {formatCurrency(publication.fundingGoal!, featuredBook.currency)}
                    </div>
                  </div>
                  <div class="font-serif text-2xl sm:text-3xl text-ivory/90">
                    {progressPercent}%
                  </div>
                </div>
                <div class="mt-5 h-px bg-ivory/12 overflow-hidden">
                  <div
                    class="h-full bg-gold transition-[width] duration-1000 ease-[cubic-bezier(0.22,1,0.36,1)]"
                    style={{ width: `${barWidthPercent}%` }}
                  />
                </div>
              </div>
            ) : null}

            <div class="mt-10">
              <CTAButton
                cta={cta}
                class="!bg-gold !text-navy-deep !border-gold hover:!bg-ivory hover:!border-ivory"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
