---
// Presentation markup/class names restored from the pre-cutover reference.
// All tenant values are supplied by the canonical painted plan / structured chrome.

---
<div
      class="relative overflow-hidden bg-navy-deep py-4"
      aria-label="Desenvolvido pela JUST"
    >
      
      <div class="pointer-events-none absolute inset-0 z-0">
        <div class="absolute left-1/2 top-[-80px] h-[420px] w-[1100px] -translate-x-1/2 rounded-full bg-[hsl(246_72%_64%/0.12)] blur-[120px]" />
      </div>

      
      <div class="pointer-events-none absolute inset-x-0 top-0 z-10 h-px bg-white/[0.06]" />
      <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 h-px bg-white/[0.04]" />

      <p class="relative z-10 mx-auto max-w-[42ch] px-4 text-center font-clash text-[0.78rem] font-medium leading-snug tracking-[0.06em] text-white/30 sm:max-w-none lg:text-[0.95rem]">
        Desenvolvido pela{" "}
        <a
          href="https://www.justwebsites.com.br"
          target="_blank"
          rel="noopener noreferrer"
          class="font-clash font-semibold text-white/60 transition-all duration-300 hover:text-white"
        >
          JUST
        </a>{" "}
        <span class="text-white/28">
          — a estrutura para seu negócio funcionar online
        </span>
      </p>
    </div>
