---
/**
 * Allowlisted form_signup_shell bound to book-club-signup Edge Function.
 * Host comes from the request — never from a client-supplied tenantId.
 */
const {
  title,
  heading,
  body,
  host,
  path,
  noindex = true,
  seo = {},
  signupUrl,
} = Astro.props

const pageTitle = seo.title ? `${title} | ${seo.title}` : title
const description = seo.description || ""
const robots = seo.robots || (noindex ? "noindex,nofollow" : "index,follow")
const canonicalHref = seo.canonicalUrl || `https://${host}${path}`
const endpoint =
  signupUrl ||
  (typeof import.meta.env.PUBLIC_BOOK_CLUB_SIGNUP_URL === "string" &&
  import.meta.env.PUBLIC_BOOK_CLUB_SIGNUP_URL
    ? import.meta.env.PUBLIC_BOOK_CLUB_SIGNUP_URL
    : "https://ehondnpqztvybvgsjnxe.supabase.co/functions/v1/book-club-signup")
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalHref} />
  </head>
  <body data-route-kind="form_signup_shell" data-mission-host={host}>
    <main class="mission-form-shell">
      <header>
        <h1>{heading || title}</h1>
        {body && <p>{body}</p>}
      </header>

      <div id="mission-form-success" class="mission-form-shell__status" hidden role="status">
        Solicitação recebida. Em breve entraremos em contato.
      </div>
      <div id="mission-form-error" class="mission-form-shell__status mission-form-shell__status--error" hidden role="alert">
        Não foi possível enviar. Tente novamente em instantes.
      </div>

      <form
        id="mission-signup-form"
        class="mission-form-shell__form"
        aria-label={heading || title}
        data-endpoint={endpoint}
        data-host={host}
        data-path={path}
      >
        <label>
          Nome completo
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label>
          E-mail
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          Telefone / WhatsApp
          <input type="tel" name="phone" autocomplete="tel" required />
        </label>
        <label>
          Endereço de entrega
          <textarea name="address" rows="3" required></textarea>
        </label>
        <label>
          Nome para dedicatória (opcional)
          <input type="text" name="dedication" autocomplete="off" />
        </label>
        {/* Honeypot */}
        <label class="mission-form-shell__hp" aria-hidden="true">
          Empresa
          <input type="text" name="company" tabindex="-1" autocomplete="off" />
        </label>
        <button type="submit">Enviar solicitação</button>
      </form>
    </main>
  </body>
</html>

<script>
  const form = document.getElementById("mission-signup-form")
  const success = document.getElementById("mission-form-success")
  const error = document.getElementById("mission-form-error")
  if (form instanceof HTMLFormElement) {
    let submissionKey = ""
    form.addEventListener("submit", async (event) => {
      event.preventDefault()
      if (success) success.hidden = true
      if (error) error.hidden = true
      const endpoint = form.dataset.endpoint || ""
      const host = form.dataset.host || window.location.hostname
      const path = form.dataset.path || window.location.pathname
      submissionKey ||= crypto.randomUUID()
      const data = new FormData(form)
      const button = form.querySelector('button[type="submit"]')
      if (button instanceof HTMLButtonElement) button.disabled = true
      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            host,
            path,
            submission_key: submissionKey,
            full_name: data.get("name"),
            email: data.get("email"),
            phone: data.get("phone"),
            address: data.get("address"),
            dedication: data.get("dedication"),
            company: data.get("company"),
          }),
        })
        if (!response.ok) throw new Error("submission_failed")
        if (success) success.hidden = false
        form.hidden = true
      } catch {
        if (error) error.hidden = false
        if (button instanceof HTMLButtonElement) button.disabled = false
      }
    })
  }
</script>

<style>
  .mission-form-shell {
    max-width: 560px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    font-family: Georgia, "Times New Roman", serif;
    color: hsl(220 15% 16%);
  }
  h1 {
    font-size: 1.75rem;
    margin: 0 0 0.75rem;
  }
  header p {
    margin: 0 0 1.5rem;
    line-height: 1.55;
  }
  .mission-form-shell__form {
    display: grid;
    gap: 1rem;
  }
  label {
    display: grid;
    gap: 0.35rem;
    font-size: 0.95rem;
  }
  input,
  textarea {
    padding: 0.55rem 0.65rem;
    border: 1px solid hsl(220 12% 75%);
    background: hsl(40 20% 98%);
    font: inherit;
  }
  button {
    margin-top: 0.5rem;
    padding: 0.65rem 1rem;
    border: 0;
    background: hsl(220 40% 22%);
    color: hsl(40 30% 96%);
    font-weight: 600;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .mission-form-shell__hp {
    position: absolute;
    left: -9999px;
    height: 0;
    overflow: hidden;
  }
  .mission-form-shell__status {
    margin-bottom: 1rem;
    padding: 0.75rem 1rem;
    background: hsl(140 30% 92%);
    border: 1px solid hsl(140 25% 70%);
  }
  .mission-form-shell__status--error {
    background: hsl(0 40% 94%);
    border-color: hsl(0 35% 70%);
  }
</style>
