---
export const prerender = false;

import { createPublicSupabaseClient } from '../lib/publicSupabase.js'
import CatalogProductCard from '../components/catalog/CatalogProductCard.astro'
import catalogF3CssUrl from '../styles/catalog-f3.css?url'
import {
  buildCatalogHref,
  resolveCatalogHostOverride,
} from '../lib/catalogBrowse.js'
import {
  isLeadIntakeSafeMode,
  resolveDeployEnv,
} from '../lib/runtimeEnv.js'
import {
  HostResolutionError,
  resolveRequestHost,
} from '../lib/publicHomepage'
import { getPublicRequestContext } from '../lib/publicRequestContext.js'
import {
  isPublicationIndexingEnforced,
  publicationFromPayload,
  shouldNoindexFromPublication,
} from '../lib/publicationContract.js'
import {
  buildCanonicalUrl,
  CanonicalAuthorityError,
  canonicalAuthorityErrorResponse,
  fetchPublicCanonicalFromRpc,
  requirePublicCanonical,
} from '../lib/canonicalAuthority.js'

const url = new URL(Astro.request.url)
const deployEnv = resolveDeployEnv(Astro.locals)
const safeMode = isLeadIntakeSafeMode(deployEnv)
const ctx = getPublicRequestContext(Astro.locals)

const hostHeader = Astro.request.headers.get('host') ?? ''
const hostFromHeader = hostHeader.split(':')[0].toLowerCase()
const isLocalHost = hostFromHeader === 'localhost' || hostFromHeader === '127.0.0.1'

if (isLocalHost && !url.searchParams.has('host') && !ctx?.requestHost) {
  return new Response(
    'Local catalog requires ?host=<tenant-domain>. No default tenant host is applied.',
    { status: 400, headers: { 'Content-Type': 'text/plain; charset=utf-8' } },
  )
}

let host
try {
  // Production authority is middleware/physical host. Preview/staging keep ?host= simulation.
  host =
    !safeMode && ctx?.requestHost
      ? ctx.requestHost
      : resolveRequestHost(Astro.request, url.searchParams)
} catch (err) {
  const reason =
    err instanceof HostResolutionError ||
    (err && typeof err === 'object' && 'reason' in err)
      ? String(/** @type {{ reason: string }} */ (err).reason)
      : 'invalid_host'
  return new Response(`Invalid host (${reason})`, {
    status: 400,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  })
}

const hostOverride = resolveCatalogHostOverride(url.searchParams, host)

const supabase = createPublicSupabaseClient(Astro.locals)
if (!supabase) {
  return new Response('Catalog unavailable (supabase runtime config missing)', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  })
}

/** Prefer request-scoped canonical from middleware; RPC only if missing. */
let pageCanonical = null
try {
  const fromLocals =
    Astro.locals.publicCanonical &&
    typeof Astro.locals.publicCanonical === 'object'
      ? Astro.locals.publicCanonical
      : null
  if (fromLocals) {
    pageCanonical = requirePublicCanonical(fromLocals, { deployEnv, noindex: safeMode })
  } else {
    const fromRpc = await fetchPublicCanonicalFromRpc(supabase, host)
    pageCanonical = requirePublicCanonical(fromRpc, { deployEnv, noindex: safeMode })
  }
} catch (err) {
  if (err instanceof CanonicalAuthorityError) {
    return canonicalAuthorityErrorResponse(err)
  }
  throw err
}

const noindex =
  safeMode ||
  shouldNoindexFromPublication({
    enforce: isPublicationIndexingEnforced(Astro.locals),
    publication: publicationFromPayload(ctx?.payload || Astro.locals.publicSitePayload),
    canonicalHost: pageCanonical?.host,
  })

const { data: rows, error } = await supabase.rpc('public_get_products_by_host', {
  p_host: host,
})

if (error) console.error('RPC error:', error)

const products = (rows ?? []).map((p) => ({
  ...p,
  price_display: p.price == null ? '' : Number(p.price).toFixed(0),
}))

const featured = products.filter((p) => p.featured)
const companyName = products[0]?.company_name ?? 'Loja'
const whatsappNumberRaw = products[0]?.whatsapp_number ?? ''
const whatsappNumber = String(whatsappNumberRaw).replace(/\D/g, '')

const pageUrl = pageCanonical ? buildCanonicalUrl(pageCanonical, '/c') : undefined
const seller = url.searchParams.get('s')?.trim() ?? ''
const camp = url.searchParams.get('camp')?.trim() ?? ''
const msgVariant = url.searchParams.get('msg')?.trim() ?? '1'

const shareUrl = pageUrl ? new URL(pageUrl) : new URL(`https://example.invalid/c`)
if (hostOverride) shareUrl.searchParams.set('host', hostOverride)
if (seller) shareUrl.searchParams.set('s', seller)
if (camp) shareUrl.searchParams.set('camp', camp)
if (msgVariant) shareUrl.searchParams.set('msg', msgVariant)
const shareLink = shareUrl.toString()

const msg1 = `Catálogo ${companyName} (${products.length} itens): ${shareLink}\n\nMe chama aqui pra comprar.`
const msg2 = `Oi! Segue o catálogo ${companyName}: ${shareLink}\n\nQual item você quer?`
const msg3 = `✅ Catálogo ${companyName}\n${shareLink}\n\nMe chama no WhatsApp pra fechar.`
const shareMessage =
  msgVariant === '2' ? msg2 :
  msgVariant === '3' ? msg3 :
  msg1

const title = `${companyName} — Catálogo`
const description = `Veja o catálogo completo de ${companyName} e compre pelo WhatsApp.`
const ogImage = featured[0]?.image_url || products[0]?.image_url || ''
const waText = `Olá! Quero ver/comprar pelo catálogo: ${pageUrl || shareLink}`
const waLink = whatsappNumber
  ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(waText)}`
  : null
const localHostParam = isLocalHost ? host : ''
---

<html lang="pt-BR" data-f3-presentation="f3.presentation.grid_v1">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={companyName} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="stylesheet" href={catalogF3CssUrl} />
  </head>
  <body class="catalog-browse">
    <div class="catalog-browse__wrap">
      <header class="catalog-browse__head">
        <h1>{companyName}</h1>
        <p class="catalog-browse__sub">Catálogo compartilhável · {products.length} itens</p>
        <p class="catalog-browse__sub">Link: <a href={shareLink}>{shareLink}</a></p>
        <div class="catalog-pdp__actions" style="margin-top:1rem">
          <button id="copyLink" class="catalog-btn" type="button">Copiar link</button>
          <button id="copyMsg" class="catalog-btn" type="button">Copiar mensagem</button>
          {waLink ? <a class="catalog-btn catalog-btn--solid" href={waLink}>WhatsApp</a> : null}
          <a class="catalog-btn" href={buildCatalogHref(localHostParam, '/catalogo')}>Abrir /catalogo</a>
        </div>
      </header>

      {featured.length > 0 && (
        <section class="catalog-product-grid" aria-label="Destaques">
          <header class="catalog-section-head"><h2>Destaques</h2></header>
          <div class="catalog-product-grid__list">
            {featured.slice(0, 12).map((p) => (
              <CatalogProductCard
                href={buildCatalogHref(localHostParam, `/p/${p.slug}`)}
                title={p.name}
                imageUrl={p.image_url}
                badge="Destaque"
                price={p.price}
              />
            ))}
          </div>
        </section>
      )}

      <section class="catalog-product-grid" aria-label="Todos os produtos">
        <header class="catalog-section-head"><h2>Todos os produtos</h2></header>
        <div class="catalog-product-grid__list">
          {products.map((p) => (
            <CatalogProductCard
              href={buildCatalogHref(localHostParam, `/p/${p.slug}`)}
              title={p.name}
              imageUrl={p.image_url}
              badge={p.featured ? 'Destaque' : null}
              price={p.price}
            />
          ))}
        </div>
      </section>
    </div>
    <script define:vars={{ shareLink, shareMessage }}>
      const copy = async (txt) => {
        await navigator.clipboard.writeText(txt)
        alert('Copiado')
      }
      document.getElementById('copyLink')?.addEventListener('click', () => copy(shareLink))
      document.getElementById('copyMsg')?.addEventListener('click', () => copy(shareMessage))
    </script>
  </body>
</html>
