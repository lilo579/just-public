---
/**
 * Allowlisted F4 content_page — `/termos-do-clube`.
 */
export const prerender = false

import MissionContentPage from "../components/mission/MissionContentPage.astro"
import { loadAllowlistedMissionPage } from "../lib/loadAllowlistedMissionPage.js"

const mission = await loadAllowlistedMissionPage(
  Astro.request,
  Astro.locals,
  "/termos-do-clube",
  "content_page",
)

if (!mission.ok) {
  return new Response("Not found", {
    status: mission.status || 404,
    headers: { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" },
  })
}
---

<MissionContentPage
  title={mission.route.title || "Informações do Clube"}
  heading={mission.route.heading || mission.route.title || "Informações do Clube"}
  body={mission.route.body || ""}
  host={mission.host}
  path="/termos-do-clube"
  noindex={mission.noindex}
  seo={mission.seo}
/>
