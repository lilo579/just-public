---
/**
 * ADR-SEO-001 Phase 4 — `/homepage` is not a public indexable surface.
 * Production GET/HEAD is 301 → `/` in middleware (one hop with host normalization).
 * Technical renderer preview remains at `/preview` (non-indexable in preview/staging).
 *
 * Retained as a belt-and-suspenders redirect when middleware skips (e.g. safe-mode).
 */
export const prerender = false

return Astro.redirect("/", 301)
---
