---
export const prerender = false

import type { ResolvedHomepage } from "../contracts/homepage"
import HomepageRenderer from "../components/HomepageRenderer.astro"
import CanonicalHomepageRenderer from "../components/CanonicalHomepageRenderer.astro"
import SiteTheme from "../components/SiteTheme.astro"
import {
  chooseHomepageRenderer,
  fetchPublicSitePayload,
  HostResolutionError,
  resolveRequestHost,
} from "../lib/publicHomepage"
import {
  resolveSitePayloadUrl,
  resolveSupabaseAnonKey,
} from "../lib/runtimeEnv.js"
import { themeTokensFromBranding } from "../lib/themeFromBranding"

const requestUrl = new URL(Astro.request.url)
const allowLegacy =
  requestUrl.searchParams.get("renderer") === "legacy" ||
  import.meta.env.PUBLIC_ALLOW_LEGACY_RENDERER === "1"
const forceLegacy = requestUrl.searchParams.get("renderer") === "legacy"

let host: string
try {
  host = resolveRequestHost(Astro.request, requestUrl.searchParams)
} catch (err) {
  const reason =
    err instanceof HostResolutionError ||
    (err && typeof err === "object" && "reason" in err)
      ? String((err as { reason: string }).reason)
      : "invalid_host"
  return new Response(`Invalid host (${reason})`, {
    status: 400,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  })
}

const payloadUrl = resolveSitePayloadUrl(Astro.locals)
const anonKey = resolveSupabaseAnonKey(Astro.locals) ?? ""
if (!payloadUrl) {
  return new Response("PUBLIC_SITE_PAYLOAD_URL missing", {
    status: 503,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  })
}

const fetched = await fetchPublicSitePayload({ kind: "host", host }, "public", {
  payloadUrl,
  anonKey,
})
if (!fetched.ok) {
  return new Response(`Site unavailable (${fetched.status})`, {
    status: fetched.status === 404 ? 404 : 502,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  })
}

const homepage = fetched.homepage as ResolvedHomepage
const choice = chooseHomepageRenderer(homepage, { allowLegacy, forceLegacy })
if (choice.mode === "error") {
  return new Response(`Homepage unavailable (${choice.reason})`, {
    status: 502,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  })
}

const tokens = themeTokensFromBranding(homepage.source?.meta?.branding ?? null)
const title = homepage.source?.contact?.companyName ?? "Site"
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <SiteTheme tokens={tokens}>
      <main class="page-shell" data-renderer={choice.mode}>
        {choice.mode === "canonical" ? (
          <CanonicalHomepageRenderer plan={choice.plan} />
        ) : (
          <>
            <section data-legacy-fallback={choice.reason} aria-label="Legacy renderer fallback">
              Explicit legacy fallback: {choice.reason}
            </section>
            <HomepageRenderer homepage={homepage} />
          </>
        )}
      </main>
    </SiteTheme>
  </body>
</html>

<style>
  .page-shell {
    margin: 0 auto;
    max-width: 1100px;
    padding: 0 20px;
  }
</style>
