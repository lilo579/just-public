---
export const prerender = false;

import { PUBLIC_SITE_PAYLOAD_URL, SUPABASE_ANON_KEY } from "../config/publicSite";
import type { ResolvedHomepage } from "../contracts/homepage";
import HomepageRenderer from "../components/HomepageRenderer.astro";

const rawHost = Astro.request.headers.get("host")?.trim();

if (!rawHost) {
  throw new Error("Missing Host header");
}

const url = `${PUBLIC_SITE_PAYLOAD_URL}?host=${encodeURIComponent(rawHost)}&mode=public`;

const res = await fetch(url, {
  headers: {
    apikey: SUPABASE_ANON_KEY,
    Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
  },
});

if (!res.ok) {
  const text = await res.text();
  throw new Error(
    `Failed to fetch homepage payload
Status: ${res.status}
Body: ${text}`
  );
}

const homepage = (await res.json()) as ResolvedHomepage;
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Host Preview</title>
  </head>
  <body>
    <main class="page-shell">
      <HomepageRenderer homepage={homepage} />
    </main>
  </body>
</html>

<style>
  .page-shell {
    margin: 0 auto;
    max-width: 1100px;
    padding: 0 20px;
  }

  @media (max-width: 720px) {
    .page-shell {
      padding: 0 18px;
    }
  }
</style>
