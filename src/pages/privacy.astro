---
/**
 * Allowlisted F4 content page — `/privacy` for synthetic mission tenant.
 */
export const prerender = false

import MissionContentPage from "../components/mission/MissionContentPage.astro"
import { loadAllowlistedMissionPage } from "../lib/loadAllowlistedMissionPage.js"

const mission = await loadAllowlistedMissionPage(
  Astro.request,
  Astro.locals,
  "/privacy",
  "content_page",
)

if (!mission.ok) {
  return new Response("Not found", {
    status: mission.status || 404,
    headers: { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" },
  })
}
---

<MissionContentPage
  title={mission.route.title || "Privacidade"}
  heading={mission.route.heading || mission.route.title || "Privacidade"}
  body={mission.route.body || ""}
  host={mission.host}
  path="/privacy"
  noindex={mission.noindex}
  seo={mission.seo}
/>
