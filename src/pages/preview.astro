---
export const prerender = false

import type { ResolvedHomepage } from "../contracts/homepage"
import HomepageRenderer from "../components/HomepageRenderer.astro"
import CanonicalHomepageRenderer from "../components/CanonicalHomepageRenderer.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import SiteTheme from "../components/SiteTheme.astro"
import { chooseHomepageRenderer, fetchPublicSitePayload } from "../lib/publicHomepage"
import {
  resolveSitePayloadUrl,
  resolveSupabaseAnonKey,
} from "../lib/runtimeEnv.js"
import { themeTokensFromBranding } from "../lib/themeFromBranding"

const slug = Astro.url.searchParams.get("slug")?.trim()
const renderer = Astro.url.searchParams.get("renderer")?.trim()
const debug = Astro.url.searchParams.get("debug")
const MODE = "preview"

if (!slug) {
  return new Response("Missing slug. Use /preview?slug=YOUR_SLUG", {
    status: 400,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  })
}

const allowLegacy =
  renderer === "legacy" || import.meta.env.PUBLIC_ALLOW_LEGACY_RENDERER === "1"
const forceLegacy = renderer === "legacy"

const payloadUrl = resolveSitePayloadUrl(Astro.locals)
const anonKey = resolveSupabaseAnonKey(Astro.locals) ?? ""
if (!payloadUrl) {
  return new Response("PUBLIC_SITE_PAYLOAD_URL missing", {
    status: 503,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  })
}

const fetched = await fetchPublicSitePayload({ kind: "slug", slug }, MODE, {
  payloadUrl,
  anonKey,
})
if (!fetched.ok) {
  return new Response(`Failed to fetch homepage payload (${fetched.status})`, {
    status: fetched.status === 404 ? 404 : 502,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  })
}

const homepage = fetched.homepage
const choice = chooseHomepageRenderer(homepage, { allowLegacy, forceLegacy })
if (choice.mode === "error") {
  return new Response(`Homepage unavailable (${choice.reason})`, {
    status: 502,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  })
}

const footer = homepage.footer ?? {
  logoUrl: null,
  tagline: null,
  whatsappNumber: null,
  whatsappVisible: false,
  email: null,
  address: null,
  companyName: "Site",
  socialLinks: [],
}
const sourceBranding = homepage.source?.meta?.branding
const brandingName = homepage.source?.contact?.companyName ?? footer.companyName ?? "Site"
const brandingLogo =
  sourceBranding?.logoHorizontalUrl ?? sourceBranding?.logoUrl ?? footer.logoUrl ?? ""
const tokens = themeTokensFromBranding(sourceBranding ?? null)
const showCanonicalDiagnostics = debug === "canonical" && choice.mode === "canonical"
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Preview — {brandingName}</title>
  </head>
  <body>
    <SiteTheme tokens={tokens}>
      <Header siteTitle={brandingName} logoUrl={brandingLogo} logoAlt={brandingName} />

      <main data-renderer={choice.mode}>
        {choice.mode === "canonical" ? (
          <CanonicalHomepageRenderer
            plan={choice.plan}
            showDiagnostics={showCanonicalDiagnostics}
          />
        ) : (
          <>
            <section
              aria-label="Legacy renderer fallback"
              data-legacy-fallback={choice.reason}
              style="margin: 1.5rem auto 0; max-width: 1100px; padding: 1rem 1.25rem; border: 1px solid hsl(12 75% 78%); border-radius: 0.75rem; background: hsl(12 100% 97%); color: hsl(12 45% 22%); font-size: 0.95rem;"
            >
              Explicit legacy fallback ({choice.reason}).
            </section>
            <HomepageRenderer homepage={homepage} />
          </>
        )}
      </main>

      <Footer
        footer={{
          ...footer,
          companyName: brandingName,
          logoUrl: brandingLogo,
        }}
      />
    </SiteTheme>
  </body>
</html>
