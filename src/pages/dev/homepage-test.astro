---
/**
 * Dev-only bridge route. Requires explicit ?tenantId= — no hardcoded tenant.
 * Disabled when import.meta.env.PROD is true.
 */
export const prerender = false

import type { ResolvedHomepage } from "../../contracts/homepage"
import { fetchPublicSitePayload } from "../../lib/publicHomepage"
import { chooseHomepageRenderer } from "../../lib/publicHomepage"
import CanonicalHomepageRenderer from "../../components/CanonicalHomepageRenderer.astro"
import HomepageRenderer from "../../components/HomepageRenderer.astro"
import SiteTheme from "../../components/SiteTheme.astro"
import { themeTokensFromBranding } from "../../lib/themeFromBranding"

if (import.meta.env.PROD) {
  return new Response("Not found", { status: 404 })
}

const tenantId = Astro.url.searchParams.get("tenantId")?.trim()
if (!tenantId) {
  return new Response(
    "Dev route requires ?tenantId=<uuid>. Hardcoded tenant IDs are not allowed.",
    { status: 400, headers: { "Content-Type": "text/plain; charset=utf-8" } },
  )
}

const fetched = await fetchPublicSitePayload({ kind: "tenantId", tenantId }, "preview")
if (!fetched.ok) {
  return new Response(`Payload error ${fetched.status}`, { status: 502 })
}

const homepage = fetched.homepage as ResolvedHomepage
const choice = chooseHomepageRenderer(homepage, {
  allowLegacy: Astro.url.searchParams.get("renderer") === "legacy",
  forceLegacy: Astro.url.searchParams.get("renderer") === "legacy",
})
const tokens = themeTokensFromBranding(homepage.source?.meta?.branding ?? null)
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <title>Dev homepage test</title>
  </head>
  <body>
    <SiteTheme tokens={tokens}>
      <main data-renderer={choice.mode === "error" ? "error" : choice.mode}>
        {choice.mode === "canonical" ? (
          <CanonicalHomepageRenderer plan={choice.plan} />
        ) : choice.mode === "legacy" ? (
          <HomepageRenderer homepage={homepage} />
        ) : (
          <p>Unable to render: {choice.reason}</p>
        )}
      </main>
    </SiteTheme>
  </body>
</html>
