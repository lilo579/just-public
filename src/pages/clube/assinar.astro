---
/**
 * Allowlisted F4 form_signup_shell — `/clube/assinar`.
 */
export const prerender = false

import MissionFormSignupShell from "../../components/mission/MissionFormSignupShell.astro"
import { loadAllowlistedMissionPage } from "../../lib/loadAllowlistedMissionPage.js"

const mission = await loadAllowlistedMissionPage(
  Astro.request,
  Astro.locals,
  "/clube/assinar",
  "form_signup_shell",
)

if (!mission.ok) {
  return new Response("Not found", {
    status: mission.status || 404,
    headers: { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" },
  })
}
---

<MissionFormSignupShell
  title={mission.route.title || "Assinar o Clube"}
  heading={mission.route.heading || mission.route.title || "Assinar o Clube"}
  body={mission.route.body || ""}
  host={mission.host}
  path="/clube/assinar"
  noindex={true}
  seo={mission.seo}
/>
