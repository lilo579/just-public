---
export const prerender = false

import { PUBLIC_SITE_PAYLOAD_URL, SUPABASE_ANON_KEY } from "../config/publicSite"
import type { ResolvedHomepage } from "../contracts/homepage"
import HomepageRenderer from "../components/HomepageRenderer.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"

// --- Host forwarding (public homepage) ---
const requestUrl = new URL(Astro.request.url)
const hostOverride = requestUrl.searchParams.get("host")?.trim()
const headerHost = Astro.request.headers.get("host")?.trim()

const host = hostOverride || headerHost

if (!host) {
  throw new Error("Missing Host header")
}

const MODE = "public"

const url = `${PUBLIC_SITE_PAYLOAD_URL}?host=${encodeURIComponent(host)}&mode=${MODE}`

const res = await fetch(url, {
  headers: {
    apikey: SUPABASE_ANON_KEY,
    Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
  },
})

if (!res.ok) {
  const text = await res.text()
  throw new Error(
    `Failed to fetch homepage payload
Host: ${host}
Status: ${res.status}
Body: ${text}`
  )
}

const homepage = (await res.json()) as ResolvedHomepage & {
  source?: {
    contact?: {
      companyName?: string | null
      whatsappNumber?: string | null
      whatsappVisible?: boolean | null
      email?: string | null
      address?: string | null
    }
    meta?: {
      branding?: {
        logoUrl?: string | null
        logoHorizontalUrl?: string | null
      }
    }
  }
}

const footer = homepage.footer ?? {
  logoUrl:
    homepage.source?.meta?.branding?.logoHorizontalUrl ??
    homepage.source?.meta?.branding?.logoUrl ??
    null,
  tagline: null,
  whatsappNumber: homepage.source?.contact?.whatsappNumber ?? null,
  whatsappVisible: homepage.source?.contact?.whatsappVisible === true,
  email: homepage.source?.contact?.email ?? null,
  address: homepage.source?.contact?.address ?? null,
  companyName: homepage.source?.contact?.companyName ?? "Site",
  socialLinks: [],
}
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{footer.companyName || "Site"}</title>
  </head>
  <body>
    <Header
      siteTitle={footer.companyName || "Site"}
      logoUrl={footer.logoUrl || ""}
      logoAlt={footer.companyName || "Logo"}
    />

    <main class="page-shell">
      <HomepageRenderer homepage={homepage} />
    </main>

    <Footer footer={footer} />
  </body>
</html>

<style>
  .page-shell {
    margin: 0 auto;
    max-width: 1100px;
    padding: 0 20px;
  }

  @media (max-width: 720px) {
    .page-shell {
      padding: 0 18px;
    }
  }
</style>
