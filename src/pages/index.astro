---
export const prerender = false

import type { ResolvedHomepage } from "../contracts/homepage"
import HomepageRenderer from "../components/HomepageRenderer.astro"
import CanonicalHomepageRenderer from "../components/CanonicalHomepageRenderer.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import SiteTheme from "../components/SiteTheme.astro"
import {
  chooseHomepageRenderer,
  fetchPublicSitePayload,
  HostResolutionError,
  resolveRequestHost,
} from "../lib/publicHomepage"
import {
  resolveSitePayloadUrl,
  resolveSupabaseAnonKey,
} from "../lib/runtimeEnv.js"
import { themeTokensFromBranding } from "../lib/themeFromBranding"

const requestUrl = new URL(Astro.request.url)
const allowLegacy =
  requestUrl.searchParams.get("renderer") === "legacy" ||
  import.meta.env.PUBLIC_ALLOW_LEGACY_RENDERER === "1"
const forceLegacy = requestUrl.searchParams.get("renderer") === "legacy"

let host: string
try {
  host = resolveRequestHost(Astro.request, requestUrl.searchParams)
} catch (err) {
  const reason =
    err instanceof HostResolutionError ||
    (err && typeof err === "object" && "reason" in err)
      ? String((err as { reason: string }).reason)
      : "invalid_host"
  return new Response(`Invalid host (${reason})`, {
    status: 400,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  })
}

const payloadUrl = resolveSitePayloadUrl(Astro.locals)
const anonKey = resolveSupabaseAnonKey(Astro.locals) ?? ""
if (!payloadUrl) {
  return new Response("PUBLIC_SITE_PAYLOAD_URL missing", {
    status: 503,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  })
}

console.log(
  JSON.stringify({
    msg: "public_host_resolved",
    host,
    status: "fetching_payload",
  }),
)

const fetched = await fetchPublicSitePayload({ kind: "host", host }, "public", {
  payloadUrl,
  anonKey,
})
if (!fetched.ok) {
  return new Response(
    `Site unavailable\nHost: ${host}\nStatus: ${fetched.status}`,
    { status: fetched.status === 404 ? 404 : 502, headers: { "Content-Type": "text/plain; charset=utf-8" } },
  )
}

const homepage = fetched.homepage as ResolvedHomepage & {
  source?: {
    contact?: {
      companyName?: string | null
      whatsappNumber?: string | null
      whatsappVisible?: boolean | null
      email?: string | null
      address?: string | null
    }
    meta?: {
      branding?: {
        primaryColor?: string | null
        secondaryColor?: string | null
        accentColor?: string | null
        typography?: string | null
        logoUrl?: string | null
        logoHorizontalUrl?: string | null
      }
    }
  }
}

const choice = chooseHomepageRenderer(homepage, { allowLegacy, forceLegacy })
if (choice.mode === "error") {
  return new Response(`Homepage unavailable (${choice.reason})`, {
    status: 502,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  })
}

const footer = homepage.footer ?? {
  logoUrl:
    homepage.source?.meta?.branding?.logoHorizontalUrl ??
    homepage.source?.meta?.branding?.logoUrl ??
    null,
  tagline: null,
  whatsappNumber: homepage.source?.contact?.whatsappNumber ?? null,
  whatsappVisible: homepage.source?.contact?.whatsappVisible === true,
  email: homepage.source?.contact?.email ?? null,
  address: homepage.source?.contact?.address ?? null,
  companyName: homepage.source?.contact?.companyName ?? "Site",
  socialLinks: [],
}

const brandingName = homepage.source?.contact?.companyName ?? footer.companyName ?? "Site"
const brandingLogo =
  homepage.source?.meta?.branding?.logoHorizontalUrl ??
  homepage.source?.meta?.branding?.logoUrl ??
  footer.logoUrl ??
  ""
const tokens = themeTokensFromBranding(homepage.source?.meta?.branding ?? null)
---

<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{brandingName}</title>
  </head>
  <body>
    <SiteTheme tokens={tokens}>
      <Header siteTitle={brandingName} logoUrl={brandingLogo} logoAlt={brandingName} />

      <main class="page-shell" data-renderer={choice.mode}>
        {choice.mode === "canonical" ? (
          <CanonicalHomepageRenderer plan={choice.plan} />
        ) : (
          <>
            <section
              aria-label="Legacy renderer fallback"
              data-legacy-fallback={choice.reason}
              style="margin: 1rem 0; padding: 0.75rem 1rem; border: 1px solid #f59e0b; border-radius: 0.5rem; background: #fffbeb; color: #92400e; font-size: 0.875rem;"
            >
              Using explicit legacy homepage renderer ({choice.reason}).
            </section>
            <HomepageRenderer homepage={homepage} />
          </>
        )}
      </main>

      <Footer
        footer={{
          ...footer,
          companyName: brandingName,
          logoUrl: brandingLogo,
        }}
      />
    </SiteTheme>
  </body>
</html>

<style>
  .page-shell {
    margin: 0 auto;
    max-width: 1100px;
    padding: 0 20px;
  }

  @media (max-width: 720px) {
    .page-shell {
      padding: 0 18px;
    }
  }
</style>
