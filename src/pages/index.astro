---
export const prerender = false

import type { ResolvedHomepage } from "../contracts/homepage"
import HomepageRenderer from "../components/legacy/HomepageRenderer.astro"
import CanonicalHomepageRenderer from "../components/CanonicalHomepageRenderer.astro"
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import SiteTheme from "../components/SiteTheme.astro"
import PublicSiteHead from "../components/PublicSiteHead.astro"
import WhatsAppFloat from "../components/WhatsAppFloat.astro"
import {
  chooseHomepageRenderer,
  fetchPublicSitePayload,
  HostResolutionError,
  resolveRequestHost,
} from "../lib/publicHomepage"
import {
  isLeadIntakeSafeMode,
  isPocFixtureMode,
  resolveDeployEnv,
  resolveSitePayloadUrl,
  resolveSupabaseAnonKey,
} from "../lib/runtimeEnv.js"
import { resolvePocFixturePayload } from "../poc/publicSiteFixtures.js"
import { themeTokensFromBranding } from "../lib/themeFromBranding"
import { buildPublicHomepageSeo } from "../lib/publicPageSeo.js"
import {
  resolveHeaderLogoUrl,
  resolveHeaderOverHeroLogoUrl,
  resolveFooterLogoUrl,
} from "@just/site-engine-authority"
import { resolvePublicPresentationBinding } from "../lib/publicPresentationBinding.js"
import cinematicF1CssUrl from "../styles/cinematic-f1.css?url"
import catalogF3CssUrl from "../styles/catalog-f3.css?url"
import CatalogShopHomepage from "../components/catalog/CatalogShopHomepage.astro"
import { createPublicSupabaseClient } from "../lib/publicSupabase.js"
import {
  applyHostOverrideToNavItems,
  resolveCatalogHostOverride,
} from "../lib/catalogBrowse.js"
import {
  resolveShopNavItems,
  resolveShopSolidLogoUrl,
} from "../lib/resolveShopNavItems.js"

const requestUrl = new URL(Astro.request.url)
/** Kill-switch: ?renderer=legacy is rejected when a canonical plan is present. */
const forceLegacy = requestUrl.searchParams.get("renderer") === "legacy"

let host: string
try {
  host = resolveRequestHost(Astro.request, requestUrl.searchParams)
} catch (err) {
  const reason =
    err instanceof HostResolutionError ||
    (err && typeof err === "object" && "reason" in err)
      ? String((err as { reason: string }).reason)
      : "invalid_host"
  return new Response(`Invalid host (${reason})`, {
    status: 400,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  })
}

const hostOverride = resolveCatalogHostOverride(requestUrl.searchParams, host)

/** @type {ResolvedHomepage} */
let homepage: ResolvedHomepage

if (isPocFixtureMode(Astro.locals)) {
  const fixture = resolvePocFixturePayload(host)
  if (!fixture) {
    return new Response(`Site unavailable\nHost: ${host}\nStatus: 404`, {
      status: 404,
      headers: { "Content-Type": "text/plain; charset=utf-8" },
    })
  }
  homepage = fixture as ResolvedHomepage
} else {
  const payloadUrl = resolveSitePayloadUrl(Astro.locals)
  const anonKey = resolveSupabaseAnonKey(Astro.locals) ?? ""
  if (!payloadUrl) {
    return new Response("PUBLIC_SITE_PAYLOAD_URL missing", {
      status: 503,
      headers: { "Content-Type": "text/plain; charset=utf-8" },
    })
  }

  console.log(
    JSON.stringify({
      msg: "public_host_resolved",
      host,
      status: "fetching_payload",
    }),
  )

  const fetched = await fetchPublicSitePayload({ kind: "host", host }, "public", {
    payloadUrl,
    anonKey,
  })
  if (!fetched.ok) {
    return new Response(
      `Site unavailable\nHost: ${host}\nStatus: ${fetched.status}`,
      {
        status: fetched.status === 404 ? 404 : 502,
        headers: { "Content-Type": "text/plain; charset=utf-8" },
      },
    )
  }
  homepage = fetched.homepage as ResolvedHomepage
}

const homepageWithSource = homepage as ResolvedHomepage & {
  source?: {
    contact?: {
      companyName?: string | null
      whatsappNumber?: string | null
      whatsappVisible?: boolean | null
      email?: string | null
      address?: string | null
    }
    meta?: {
      branding?: {
        primaryColor?: string | null
        secondaryColor?: string | null
        accentColor?: string | null
        typography?: string | null
        logoUrl?: string | null
        logoWhiteUrl?: string | null
        logoHorizontalUrl?: string | null
      }
      presentationProfile?: string | null
      seo?: {
        title?: string | null
        description?: string | null
        ogTitle?: string | null
        ogDescription?: string | null
        ogImage?: string | null
        favicon?: string | null
        jsonLdType?: string | null
      }
      footer?: {
        tagline?: string | null
        socialLinks?: Array<{ type?: string; url?: string }>
      }
    }
  }
  serializablePlan?: unknown
  footer?: {
    logoUrl?: string | null
    tagline?: string | null
    whatsappNumber?: string | null
    whatsappVisible?: boolean
    email?: string | null
    address?: string | null
    companyName?: string | null
    socialLinks?: Array<{ type?: string; url?: string }>
  }
}

const choice = chooseHomepageRenderer(homepageWithSource, { forceLegacy })
if (choice.mode === "error") {
  return new Response(`Homepage unavailable (${choice.reason})`, {
    status: 502,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  })
}

const presentationBinding = resolvePublicPresentationBinding(homepageWithSource, choice)
const presentationProfile = presentationBinding.profile
const presentationFamily = presentationBinding.family || "f1"
const isCinematicPresentation = presentationProfile === "f1.presentation.cinematic_v1"
const isF3Presentation = presentationFamily === "f3"
const presentationChrome = presentationBinding.chrome
const cinematicAtmosphere =
  presentationChrome &&
  typeof presentationChrome === "object" &&
  "cinematicEditorial" in presentationChrome &&
  presentationChrome.cinematicEditorial &&
  typeof presentationChrome.cinematicEditorial === "object" &&
  "atmosphere" in presentationChrome.cinematicEditorial
    ? String(presentationChrome.cinematicEditorial.atmosphere || "editorial")
    : "editorial"
const cinematicTypography =
  presentationChrome &&
  typeof presentationChrome === "object" &&
  "cinematicEditorial" in presentationChrome &&
  presentationChrome.cinematicEditorial &&
  typeof presentationChrome.cinematicEditorial === "object" &&
  "typography" in presentationChrome.cinematicEditorial
    ? String(presentationChrome.cinematicEditorial.typography || "editorial")
    : "editorial"

const metaFooter = homepageWithSource.source?.meta?.footer
const footerSocialLinks = (
  metaFooter?.socialLinks ??
  homepageWithSource.footer?.socialLinks ??
  []
)
  .filter((link) => typeof link?.url === "string" && link.url.trim().length > 0)
  .map((link) => ({
    type: typeof link.type === "string" ? link.type : "link",
    url: String(link.url).trim(),
  }))

const footer = {
  logoUrl:
    homepageWithSource.source?.meta?.branding?.logoHorizontalUrl ??
    homepageWithSource.source?.meta?.branding?.logoUrl ??
    homepageWithSource.footer?.logoUrl ??
    null,
  tagline:
    metaFooter?.tagline ??
    homepageWithSource.footer?.tagline ??
    null,
  whatsappNumber: homepageWithSource.source?.contact?.whatsappNumber ?? null,
  whatsappVisible: homepageWithSource.source?.contact?.whatsappVisible === true,
  email: homepageWithSource.source?.contact?.email ?? null,
  address: homepageWithSource.source?.contact?.address ?? null,
  companyName: homepageWithSource.source?.contact?.companyName ?? "Site",
  socialLinks: footerSocialLinks,
}

const brandingName =
  homepageWithSource.source?.contact?.companyName ?? footer.companyName ?? "Site"
const brandingMeta = homepageWithSource.source?.meta?.branding ?? null
/** F3 shop homepage pulls header over media hero (Golden Master). */
const headerOverHero = isF3Presentation
  ? true
  : presentationChrome.headerOverHero === true
const brandingLogo = isF3Presentation
  ? resolveShopSolidLogoUrl(
      brandingMeta,
      resolveHeaderLogoUrl(brandingMeta, presentationChrome),
    )
  : resolveHeaderLogoUrl(brandingMeta, presentationChrome)
/** Force over-hero chrome when resolving white logo (F3 home always overlays media). */
const brandingLogoOverHeroResolved = resolveHeaderOverHeroLogoUrl(
  brandingMeta,
  {
    ...presentationChrome,
    headerOverHero,
  },
)
/** F3 shop: prefer Hub white logo, else packaged brand-pack white crest. */
const brandingLogoOverHero =
  (typeof brandingMeta?.logoWhiteUrl === "string" && brandingMeta.logoWhiteUrl.trim()) ||
  brandingLogoOverHeroResolved ||
  (isF3Presentation ? "/branding/3d-jewish/logo-white.png" : "")
const footerLogoUrl = resolveFooterLogoUrl(brandingMeta, presentationChrome)
const cinematicEditorial =
  presentationChrome &&
  "cinematicEditorial" in presentationChrome &&
  presentationChrome.cinematicEditorial
    ? presentationChrome.cinematicEditorial
    : null
const f3NavItems =
  isF3Presentation &&
  presentationChrome &&
  "navItems" in presentationChrome &&
  Array.isArray(presentationChrome.navItems)
    ? presentationChrome.navItems
    : []

/** Prefer DB show_in_nav lines for F3 shop chrome (Golden Master). */
let shopNavItems = f3NavItems
if (isF3Presentation) {
  const supabase = createPublicSupabaseClient(Astro.locals)
  if (supabase) {
    const { data: taxonomyRows } = await supabase.rpc(
      "public_get_catalog_taxonomy_by_host",
      { p_host: host },
    )
    const fromTaxonomy = resolveShopNavItems(
      Array.isArray(taxonomyRows) ? taxonomyRows : [],
    )
    if (fromTaxonomy.length > 0) shopNavItems = fromTaxonomy
  }
}

const headerNavItems = applyHostOverrideToNavItems(
  Array.isArray(cinematicEditorial?.navItems)
    ? cinematicEditorial.navItems
    : shopNavItems,
  hostOverride,
)
const headerCtaLabel =
  typeof cinematicEditorial?.headerCtaLabel === "string" &&
  cinematicEditorial.headerCtaLabel.trim()
    ? cinematicEditorial.headerCtaLabel
    : isF3Presentation &&
        typeof presentationChrome?.headerCtaLabel === "string" &&
        presentationChrome.headerCtaLabel.trim()
      ? presentationChrome.headerCtaLabel
      : "WhatsApp"
const isPtDarkAtmosphere = cinematicAtmosphere === "pt_dark"
const headerCtaVariant = isF3Presentation
  ? "outline-on-dark"
  : isPtDarkAtmosphere
    ? "solid"
    : "outline-on-dark"
const headerNavReveal = isF3Presentation
  ? "always"
  : isPtDarkAtmosphere
    ? "always"
    : "on-scroll"

const catalogSource =
  homepageWithSource.source &&
  typeof homepageWithSource.source === "object" &&
  "catalog" in homepageWithSource.source
    ? /** @type {{ catalog?: Record<string, any> }} */ (homepageWithSource.source).catalog
    : null
const catalogHero = catalogSource?.hero ?? null
const catalogFeatured = Array.isArray(catalogSource?.featured_items)
  ? catalogSource.featured_items
  : []
const catalogCategories = Array.isArray(catalogSource?.categories)
  ? catalogSource.categories
  : []
const homeInscription =
  (typeof catalogHero?.highlight === "string" && catalogHero.highlight.trim()) ||
  "tradição impressa em cada detalhe"
/** PT Golden Master uses the brand crest on dark footer — not mono/white swap. */
const brandCrest =
  typeof brandingMeta?.logoUrl === "string" ? brandingMeta.logoUrl.trim() : ""
const footerLogoForRender = isPtDarkAtmosphere
  ? brandCrest || footerLogoUrl
  : footerLogoUrl
const tokens = themeTokensFromBranding(homepageWithSource.source?.meta?.branding ?? null)
const fontLoadUrl =
  typeof tokens.__fontLoadUrl === "string" ? tokens.__fontLoadUrl : null

const deployEnv = resolveDeployEnv(Astro.locals)
const noindex = isLeadIntakeSafeMode(deployEnv)
const planForSeo =
  choice.mode === "canonical" ? choice.plan : homepageWithSource.serializablePlan
const seo = buildPublicHomepageSeo({
  host,
  companyName: brandingName,
  branding: homepageWithSource.source?.meta?.branding ?? null,
  contact: homepageWithSource.source?.contact ?? null,
  plan: planForSeo,
  footerTagline: footer.tagline,
  seo: homepageWithSource.source?.meta?.seo ?? null,
  noindex,
})

const whatsappDigits = String(
  homepageWithSource.source?.contact?.whatsappNumber ?? footer.whatsappNumber ?? "",
).replace(/\D/g, "")
const whatsappHref = whatsappDigits ? `https://wa.me/${whatsappDigits}` : ""
---

<html lang="pt-BR">
  <head>
    <PublicSiteHead
      title={seo.title}
      description={seo.description}
      ogTitle={seo.ogTitle}
      ogDescription={seo.ogDescription}
      canonicalUrl={seo.canonicalUrl}
      ogImage={seo.ogImage}
      faviconUrl={seo.faviconUrl}
      robots={seo.robots}
      jsonLd={seo.jsonLd}
      twitterCard={seo.twitterCard}
      fontLoadUrl={fontLoadUrl}
    />
    {isCinematicPresentation && <link rel="stylesheet" href={cinematicF1CssUrl} />}
    {isF3Presentation && <link rel="stylesheet" href={catalogF3CssUrl} />}
  </head>
  <body>
    <SiteTheme tokens={tokens}>
      <div
        data-f1-presentation={!isF3Presentation ? presentationProfile : undefined}
        data-f3-presentation={isF3Presentation ? presentationProfile : undefined}
        {...(isCinematicPresentation
          ? {
              "data-f1-atmosphere": cinematicAtmosphere,
              "data-f1-typography": cinematicTypography,
            }
          : {})}
      >
        <Header
          siteTitle={brandingName}
          logoUrl={brandingLogo}
          logoOverHeroUrl={brandingLogoOverHero}
          logoAlt={brandingName}
          whatsappHref={whatsappHref}
          pillChrome={presentationChrome.headerPillChrome !== false && !isF3Presentation}
          overHero={headerOverHero}
          ctaLabel={headerCtaLabel}
          navItems={headerNavItems}
          ctaVariant={headerCtaVariant}
          navReveal={headerNavReveal}
          chrome={isF3Presentation ? "shop" : "default"}
          showCta={!isF3Presentation}
        />

        <main
          class:list={["page-shell", isF3Presentation && "page-shell--shop"]}
          data-renderer={choice.mode}
          data-f1-presentation={!isF3Presentation ? presentationProfile : undefined}
          data-f3-presentation={isF3Presentation ? presentationProfile : undefined}
          {...(isCinematicPresentation
            ? {
                "data-f1-atmosphere": cinematicAtmosphere,
                "data-f1-typography": cinematicTypography,
              }
            : {})}
        >
          {isF3Presentation && choice.mode === "canonical" ? (
            <CatalogShopHomepage
              host={host}
              hostOverride={hostOverride}
              inscription={homeInscription}
              heroCtaLabel={
                typeof catalogHero?.primaryCtaLabel === "string"
                  ? catalogHero.primaryCtaLabel
                  : "Ver catálogo"
              }
              heroImageUrl={
                typeof catalogHero?.imageUrl === "string" ? catalogHero.imageUrl : null
              }
              featuredItems={catalogFeatured}
              categories={catalogCategories}
            />
          ) : choice.mode === "canonical" ? (
            <CanonicalHomepageRenderer
              plan={choice.plan}
              presentationChrome={presentationChrome}
            />
          ) : (
            <div data-legacy-runtime={choice.reason}>
              <HomepageRenderer homepage={homepageWithSource} />
            </div>
          )}
        </main>

        <Footer
          footer={{
            ...footer,
            companyName: brandingName,
            logoUrl: footerLogoForRender,
          }}
          justSignatureBand={presentationChrome.justSignatureBand !== false}
          footerSurface={presentationChrome.footerSurface || "light"}
          socialIconEmphasis={
            "footerSocialIconEmphasis" in presentationChrome
              ? presentationChrome.footerSocialIconEmphasis
              : undefined
          }
          layout={
            isF3Presentation
              ? "shop"
              : isPtDarkAtmosphere
                ? "cinematic-pt"
                : isCinematicPresentation
                  ? "cinematic-editorial"
                  : "standard"
          }
          navItems={headerNavItems}
          whatsappHref={whatsappHref}
          headerCtaLabel={headerCtaLabel}
        />
        {whatsappHref && <WhatsAppFloat href={whatsappHref} />}
      </div>
    </SiteTheme>
  </body>
</html>

<style is:global>
  /* Full-bleed sections: each block owns its container. Do not constrain the shell. */
  .page-shell {
    margin: 0;
    max-width: none;
    padding: 0;
    width: 100%;
  }

  /* Overflow clip is cinematic-only — must not leak to engine_v1 / classic_v1. */
  [data-f1-presentation="f1.presentation.cinematic_v1"] .page-shell,
  .page-shell[data-f1-presentation="f1.presentation.cinematic_v1"] {
    overflow-x: clip;
  }
</style>
