// CF-004 — just-public-poc Astro Preview candidate with POC fixtures (no production traffic).
// workers_dev stays false; preview_urls true; fixture mode gated to DEPLOY_ENV=preview only.
{
  "name": "just-public-poc",
  "compatibility_date": "2026-01-14",
  "main": "./dist/_worker.js/index.js",
  "workers_dev": false,
  "preview_urls": true,
  "vars": {
    "DEPLOY_ENV": "preview",
    "POC_FIXTURE_MODE": "true"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
