// CF-008 — dual-target Wrangler config.
// Top-level = just-public-poc (CF-006 preview pipeline / fixtures).
// env.production = just-public-production (internal staging hostname pilot).
// NOTE: name set inside env.production is used as-is (Wrangler does not append -production).
// Custom Domain is managed remotely (API/Dashboard); not declared in this file.
{
  "name": "just-public-poc",
  "compatibility_date": "2026-01-14",
  "main": "./dist/_worker.js/index.js",
  "workers_dev": false,
  "preview_urls": true,
  "vars": {
    "DEPLOY_ENV": "preview",
    "POC_FIXTURE_MODE": "true"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "env": {
    "staging": {
      "name": "just-public-staging",
      "workers_dev": false,
      "preview_urls": true,
      "vars": {
        "DEPLOY_ENV": "staging",
        "POC_FIXTURE_MODE": "false",
        "PUBLIC_SITE_PAYLOAD_URL": "https://ehondnpqztvybvgsjnxe.supabase.co/functions/v1/public-site-payload"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      }
    },
    "production": {
      "name": "just-public-production",
      "workers_dev": false,
      "preview_urls": true,
      "vars": {
        "DEPLOY_ENV": "production",
        "POC_FIXTURE_MODE": "false",
        "PUBLIC_SITE_PAYLOAD_URL": "https://ehondnpqztvybvgsjnxe.supabase.co/functions/v1/public-site-payload"
      },
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
      }
    }
  }
}
